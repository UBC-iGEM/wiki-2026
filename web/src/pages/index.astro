---
import MainLayout from "../layouts/MainLayout.astro";
import HeroChipIntro from "../components/HeroChipIntro.astro";
import SoundToggle from "../components/SoundToggle.astro";
---

<MainLayout>
    <main class="home-hero">
        <div class="home-sound-toggle">
            <div class="home-sound-toggle-pin">
                <SoundToggle />
            </div>
        </div>
        <HeroChipIntro />
    </main>
</MainLayout>

<script>
    import { onPage } from "../utils/page";
    import { createBackgroundSound } from "../utils/sfx";

    onPage(() => {
        // Runs on every page once the home page has been visited, but the music is the home page's alone
        if (!document.querySelector(".home-hero")) return;

        // Fades in with the sound toggle, and resumes where it left off after being turned off and on again.
        // The track is an MP3 data URI in a JSON file on iGEM's uploads server, which doesn't accept audio files
        // but keeps these few megabytes out of the repo
        createBackgroundSound(() =>
            fetch("https://static.igem.wiki/teams/6279/wiki/manual/background.json").then((response) =>
                response.json(),
            ),
        );
    });
</script>

<style>
    /* Top-right, under the nav's rightmost chip (.page-layout's right gutter matches the nav's), then held at the
       top-right of the screen once the nav scrolls away. The wrapper is a full-width, zero-height row that sticks;
       the toggle hangs from its right end, out over .home-hero's padding. */
    .home-sound-toggle {
        align-self: stretch;
        height: 0;
        position: sticky;
        top: calc(1rem + var(--hero-padding));
        z-index: 5;
    }

    .home-sound-toggle-pin {
        position: absolute;
        right: calc(-1 * var(--hero-padding-inline));
        top: calc(-1 * var(--hero-padding));
    }

    /* The page fades into green at the bottom, behind the sponsor footer: the layout and footer let the body's
       gradient show through on this page only */
    :global(body:has(.home-hero)) {
        background:
            linear-gradient(to top, rgb(0 255 146 / 0.5), rgb(115 168 177 / 0.25) 50%, rgb(230 80 219 / 0)) bottom /
                100% 70rem no-repeat,
            var(--color-ebony-clay);
    }

    :global(body:has(.home-hero) .page-layout),
    :global(body:has(.home-hero) .sponsor-footer) {
        background: transparent;
    }

    /* Over the green, the sponsor bar's lines and the site notice are dark rather than light */
    :global(body:has(.home-hero) .sponsor-viewport) {
        border-block-color: var(--color-ebony-clay);
    }

    :global(body:has(.home-hero) .site-notice) {
        color: var(--color-ebony-clay);
        font-family: var(--font-geist), sans-serif;
        font-weight: 700;
    }

    .home-hero {
        /* The home page's layout is sized against this (see .chip-stage) */
        --hero-padding: 2rem;
        --hero-padding-inline: 2rem;
        align-items: center;
        container-type: inline-size;
        display: flex;
        flex-direction: column;
        /* The chip composition is ~2x --chip-w wide, wider than a phone.
           Without this, Chrome mobile zooms out to fit the overflow (and
           resizes vw units with it); in-app browsers don't - so layout
           differed between them. clip (not hidden) avoids creating a
           scroll container, so ScrollTrigger still uses the page scroll. */
        overflow-x: clip;
        padding: var(--hero-padding) var(--hero-padding-inline);
    }

    /* .page-layout already supplies the side gutter on phones */
    @media (max-width: 600px) {
        .home-hero {
            --hero-padding: 1rem;
            --hero-padding-inline: 0px;
        }
    }
</style>
