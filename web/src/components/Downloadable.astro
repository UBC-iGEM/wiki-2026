---
import { BASE_URL } from "../utils/base-url";
import Model3D from "./Model3D.astro";
import { type DownloadableAttrs, DOWNLOADABLE_SLOTS } from "@exporter/markdown/components";
type Props = DownloadableAttrs;

const { name, url, kind } = Astro.props;
DOWNLOADABLE_SLOTS satisfies readonly ["preview"];

// Files without a preview get the header alone, with nothing to expand
const Panel = kind === "none" ? "div" : "details";
const Header = kind === "none" ? "div" : "summary";
---

<div class="downloadable glow-panel">
    <Panel class="panel glow-panel-body">
        <Header class="header">
            {kind !== "none" && <span class="marker" aria-hidden="true" />}
            <span class="title">{name}</span>
            <a class="download" href={url} download aria-label={`Download ${name}`}>
                <img class="icon" src={`${BASE_URL}assets/icons/download.svg`} alt="" />
                <!-- Drawn 10 units larger on each side to fit the glow, so it is positioned to keep the circle in place -->
                <img class="icon icon-hover" src={`${BASE_URL}assets/icons/download-hover.svg`} alt="" />
            </a>
        </Header>
        {
            kind !== "none" && (
                <div class="preview">
                    {kind === "pdf" && <embed src={url} type="application/pdf" />}
                    {kind === "model" && <Model3D url={url} bare />}
                    {kind === "csv" && (
                        <div class="csv">
                            <slot name="preview" />
                        </div>
                    )}
                </div>
            )
        }
    </Panel>
</div>

<style>
    /* The border and glow come from .glow-panel in style.css; the bottom margin clears the outline hanging below */
    .downloadable {
        margin: 2rem 0 3rem;
    }

    .panel {
        padding: 1.25rem 2.5rem;
    }

    .header {
        align-items: center;
        display: flex;
        gap: 1rem;
        list-style: none;
    }

    summary {
        cursor: var(--cursor-interact);
        --cursor-over-text: var(--cursor-interact);
    }

    summary::-webkit-details-marker {
        display: none;
    }

    summary:focus-visible {
        outline: 2px solid var(--color-lime-yellow);
        outline-offset: 6px;
    }

    /* A filled triangle that turns to point down once the preview is open */
    /* Drawn rather than the ▶ character, which phones render as an emoji */
    .marker {
        background: var(--color-cornflower);
        clip-path: polygon(0 0, 100% 50%, 0 100%);
        flex-shrink: 0;
        height: 0.7rem;
        transition: transform 160ms ease;
        width: 0.6rem;
    }

    .panel[open] .marker {
        transform: rotate(90deg);
    }

    .title {
        flex: 1;
        font: var(--text-subtitle);
        min-width: 0;
        overflow-wrap: anywhere;
    }

    .download {
        /* The circle is drawn larger than the arrow, which is scaled to 82% inside it */
        --size: 2.75rem;
        display: block;
        flex-shrink: 0;
        height: var(--size);
        position: relative;
        width: var(--size);
    }

    .download:focus-visible {
        outline: 2px solid var(--color-lime-yellow);
        outline-offset: 4px;
        border-radius: 50%;
    }

    .icon {
        display: block;
        height: var(--size);
        max-width: none;
        width: var(--size);
    }

    /* 10 of its 140 units are padding, so it overhangs the 120-unit circle by 1/12 of the size on each side */
    .icon-hover {
        height: calc(var(--size) * 14 / 12);
        left: calc(var(--size) / -12);
        opacity: 0;
        position: absolute;
        top: calc(var(--size) / -12);
        transition: opacity 120ms ease;
        width: calc(var(--size) * 14 / 12);
    }

    .download:is(:hover, :focus-visible) .icon-hover {
        opacity: 1;
    }

    .preview {
        border-top: 1px solid color-mix(in srgb, var(--color-cornflower) 50%, transparent);
        margin-top: 1.25rem;
        padding-top: 1.25rem;
    }

    .preview embed {
        display: block;
        height: 36rem;
        width: 100%;
    }

    /* A little shorter than a standalone Model3D */
    .preview :global(model-viewer) {
        height: 20rem;
    }

    /* Long tables scroll inside the panel rather than taking over the page */
    .csv {
        max-height: 24rem;
        overflow: auto;
    }

    .preview :global(table) {
        margin: 0;
    }

    @media (max-width: 700px) {
        .panel {
            padding: 1rem 1.25rem;
        }

        .preview embed {
            height: 28rem;
        }

        .preview :global(model-viewer) {
            height: 15rem;
        }
    }
</style>
