---
import { type FigureAttrs, FIGURE_SLOTS } from "@exporter/markdown/components";
import { imageScaleStyle } from "../utils/image-scale";
type Props = FigureAttrs;

const { imgs } = Astro.props;
FIGURE_SLOTS satisfies readonly ["content"];
---

<figure class="figure glow-panel">
    <div class="figure-body glow-panel-body">
        <div class="figure-imgs">
            {
                /* Insert all images */
                imgs.map((img) => <img src={img.url} alt={img.alt} style={imageScaleStyle(img.scale)} data-lightbox />)
            }
        </div>
        <figcaption class="figure-desc">
            <slot name="content" />
        </figcaption>
    </div>
</figure>

<style>
    /* The border and glow come from .glow-panel in style.css; the bottom margin clears the outline hanging below */
    /* As wide as its images, centred, with the caption wrapping to fit */
    .figure {
        margin: 2rem auto 3rem;
        max-width: 100%;
        width: fit-content;
    }

    .figure-body {
        padding: 0.75rem;
    }

    /* Side by side when there are several, shrinking together to fit (wrapping on a phone) */
    .figure-imgs {
        align-items: center;
        display: flex;
        gap: 0.75rem;
        justify-content: center;
    }

    /* At their own size (within the height cap), shrinking only to fit */
    .figure-imgs img {
        border-radius: 22px;
        display: block;
        flex: 0 1 auto;
        height: auto;
        max-height: calc(32.5rem * var(--img-scale, 1));
        max-width: min(100%, 100% * var(--img-scale, 1));
        min-width: 0;
        object-fit: contain;
    }

    /* Caption text comes from `.page-content figcaption` */
    /* Sized out of the panel's width, so a long caption wraps rather than widening it */
    .figure .figure-desc {
        contain: inline-size;
        margin-top: 0;
        padding: 1rem 1rem 0.5rem;
        text-align: center;
    }

    .figure-desc:empty {
        display: none;
    }

    /* The panel supplies its own padding, so the outermost children drop theirs */
    .figure-desc :global(> *:first-child) {
        margin-top: 0;
    }

    .figure-desc :global(> *:last-child) {
        margin-bottom: 0;
    }

    @media (max-width: 700px) {
        .figure-body {
            padding: 0.5rem;
        }

        .figure-imgs {
            flex-wrap: wrap;
        }

        .figure-imgs img {
            border-radius: 14px;
        }
    }
</style>
