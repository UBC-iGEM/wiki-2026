---
import { ContentMap, PagePath, type JsonMap } from "@exporter/map";
import config from "../../docs/content_map.json";
import { BASE_URL } from "../utils/base-url";

const content_map = ContentMap.fromJSON(config as JsonMap);

interface Props {
    parent_db_path: string;
    current_page_path: string;
}

const { current_page_path, parent_db_path } = Astro.props;

const parent_db = PagePath.fromString(parent_db_path);
const database_title = parent_db.name().toString();
const parent_db_entries = Array.from(content_map.queryDbEntries(parent_db));

// A Notion title may itself contain "/", which `fromString` would split into two components,
// so find the current page by its full path rather than by re-parsing it
const current_page = parent_db_entries.find((entry) => entry.toString() === current_page_path);

const current_page_title = (current_page ?? PagePath.fromString(current_page_path)).name().toString();
---

<!-- A way around the database, so it holds still between its pages (as the navbar does): the name is only shared
     within one database (see the "Page transitions" rules in style.css) -->
<details
    class="db-dropdown"
    data-db={parent_db_path}
    transition:name={`db-dropdown-${parent_db_path}`}
    transition:animate="initial"
>
    <summary>
        <span class="page-name">{current_page_title}</span>
        <span class="marker" aria-hidden="true">▾</span>
    </summary>

    <nav aria-label={`${database_title} pages`}>
        <ul>
            {
                parent_db_entries.map((entry) => {
                    const is_active = entry.toString() === current_page_path;

                    return (
                        <li>
                            <a
                                class={is_active ? "active" : undefined}
                                href={`${BASE_URL}${entry.toSlug()}`}
                                aria-current={is_active ? "page" : undefined}
                            >
                                {entry.name().toString()}
                            </a>
                        </li>
                    );
                })
            }
        </ul>
    </nav>
</details>

<script>
    import { onPage } from "../utils/page";
    import { closeWhenMouseLeaves } from "../utils/hover-menu";

    // With a mouse, it closes once the pointer leaves it, as the navbar's menus do
    const hover_menus = matchMedia("(hover: hover) and (pointer: fine)");

    // Each page renders its own dropdown, marking its own page, but one left open stays open, scrolled where it was
    let carried: { key?: string; open: boolean; scroll: number } | null = null;
    document.addEventListener("astro:before-swap", () => {
        const dropdown = document.querySelector<HTMLDetailsElement>("details.db-dropdown");
        carried = dropdown && {
            key: dropdown.dataset.db,
            open: dropdown.open,
            scroll: dropdown.querySelector("nav")?.scrollTop ?? 0,
        };
    });
    import { makeDismissable } from "../utils/dismissable";

    onPage((signal) => {
        for (const dropdown of document.querySelectorAll<HTMLDetailsElement>("details.db-dropdown")) {
            makeDismissable(dropdown, signal);

            // Reveal the current page, which a long database can push out of view
            dropdown.addEventListener("toggle", () => {
                if (dropdown.open) {
                    dropdown.querySelector("a.active")?.scrollIntoView({
                        block: "nearest",
                    });
                }
            });

            closeWhenMouseLeaves(dropdown, dropdown.querySelector("nav"), () => hover_menus.matches, signal);

            // After a page change, the browser can go on aiming the wheel at the page until the mouse moves, though the
            // open list is under it, and scroll the page instead. A wheel it sends elsewhere over the list is turned to
            // the list here, judged by where the pointer is; one it already sends to the list is left to scroll natively
            const list = dropdown.querySelector("nav")!;
            document.addEventListener(
                "wheel",
                (event) => {
                    // Not one the browser is already scrolling with (mid-gesture), or the list would move twice as far
                    if (!dropdown.open || event.ctrlKey || !event.cancelable) return;
                    if (event.target instanceof Node && list.contains(event.target)) return;
                    const rect = list.getBoundingClientRect();
                    const { clientX: x, clientY: y } = event;
                    if (x < rect.left || x > rect.right || y < rect.top || y > rect.bottom) return;
                    event.preventDefault();
                    // In pixels, lines or pages
                    const unit = [1, 20, list.clientHeight][event.deltaMode] ?? 1;
                    list.scrollBy({ top: event.deltaY * unit, behavior: "smooth" });
                },
                { passive: false, signal },
            );

            // Only within one database, as another one's is a different list
            if (carried?.open && carried.key === dropdown.dataset.db) {
                // Already open, so it shouldn't roll down again (see the styles)
                dropdown.dataset.arrived = "";
                dropdown.open = true;
                dropdown.querySelector("nav")!.scrollTop = carried.scroll;
                requestAnimationFrame(() => delete dropdown.dataset.arrived);
            }
        }
        carried = null;
    });
</script>

<style>
    .db-dropdown {
        display: block;
        font-family: var(--font-geist);
        position: relative;
    }

    summary {
        align-items: center;
        background: var(--color-cornflower);
        border-radius: 8px;
        color: var(--color-periwinkle);
        cursor: pointer;
        display: flex;
        flex-wrap: wrap;
        list-style: none;
        padding: 0.7rem;
        transition:
            background 120ms ease,
            border-color 120ms ease;
        user-select: none;
    }

    summary:hover {
        background: var(--color-periwinkle);
    }

    summary:hover :is(.page-name, .marker) {
        color: var(--color-ebony-clay);
    }

    summary:focus-visible {
        outline: 2px solid var(--color-periwinkle);
        outline-offset: 2px;
    }

    .page-name {
        color: white;
        flex: 1;
        font-size: 0.9rem;
        font-weight: 700;
        line-height: 1.3;
    }

    .marker {
        color: white;
        display: inline-block;
        font-size: 1.1rem;
        line-height: 1;
        /* A margin rather than padding, so it turns about the triangle itself */
        margin-left: 0.5rem;
        transition: transform 150ms ease;
    }

    .db-dropdown[open] .marker {
        transform: rotate(180deg);
    }

    nav {
        background: var(--color-ebony-clay);
        border: 1px solid var(--color-periwinkle);
        border-radius: 8px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
        max-height: min(60vh, 24rem);
        overflow-y: auto;
        /* Reaching either end doesn't carry on into scrolling the page */
        overscroll-behavior: contain;
        padding: 0.3rem;
        position: absolute;
        right: 0;
        top: calc(100% + 0.35rem);
        width: max-content;
        z-index: 10;
    }

    ul {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    a {
        border-radius: 6px;
        color: var(--color-periwinkle);
        display: block;
        font-size: 0.85rem;
        padding: 0.4rem 0.55rem;
        text-decoration: none;
        transition:
            background 120ms ease,
            color 120ms ease;
    }

    /* Items match the button: hovered like a hovered button, the current page like the button at rest */
    a:hover {
        background: var(--color-periwinkle);
        color: var(--color-ebony-clay);
    }

    a:focus-visible {
        outline: 2px solid var(--color-cornflower);
        outline-offset: 1px;
    }

    a.active {
        background: var(--color-cornflower);
        color: white;
        font-weight: 700;
    }

    /* The list rolls down from its top edge on opening and back up on closing. The clip leaves room at the sides and
       bottom for the shadow; ::details-content stays shown until the roll-up ends (browsers without it just snap) */
    @media (prefers-reduced-motion: no-preference) {
        .db-dropdown::details-content {
            transition: content-visibility 150ms allow-discrete;
        }

        nav {
            clip-path: inset(0 -2rem -2rem -2rem);
            transition: clip-path 150ms ease-out;
        }

        .db-dropdown:not([open]) nav {
            clip-path: inset(0 -2rem 100% -2rem);
            transition-timing-function: ease-in;
        }

        /* Not when it arrives open from the last page (see the script) */
        @starting-style {
            .db-dropdown[open]:not([data-arrived]) nav {
                clip-path: inset(0 -2rem 100% -2rem);
            }
        }
    }

    @media (max-width: 1000px) {
        nav {
            max-width: 100%;
        }
    }
</style>
