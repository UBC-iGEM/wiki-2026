---
import { ContentMap, PagePath, type JsonMap } from "@exporter/map";
import config from "../../docs/content_map.json";

const content_map = ContentMap.fromJSON(config as JsonMap);

interface Props {
    parent_db_path: string;
    current_page_path: string;
}
const { current_page_path, parent_db_path } = Astro.props;

const parent_db = PagePath.fromString(parent_db_path);
const current_page = PagePath.fromString(current_page_path);
const database_title = parent_db.name().toString();
const current_page_title = current_page.name().toString();
const parent_db_entries = Array.from(content_map.queryDbEntries(parent_db));
---

<details class="db-dropdown">
    <summary>
        <span class="db-name">{database_title}</span>
        <span class="page-name">{current_page_title}</span>
        <span class="marker" aria-hidden="true">▾</span>
    </summary>

    <nav aria-label={`${database_title} pages`}>
        <ul>
            {
                parent_db_entries.map((entry) => {
                    const label = entry.name().toString();
                    const is_active = current_page.equals(entry);

                    return (
                        <li>
                            <a
                                class={is_active ? "active" : undefined}
                                href={`/${entry.toSlug()}`}
                                aria-current={is_active ? "page" : undefined}
                            >
                                {label}
                            </a>
                        </li>
                    );
                })
            }
        </ul>
    </nav>
</details>

<script>
    // A `details` closes only on a click of its own summary; add the dismissals a dropdown needs
    for (const dropdown of document.querySelectorAll<HTMLDetailsElement>("details.db-dropdown")) {
        const summary = dropdown.querySelector("summary");

        document.addEventListener("click", (event) => {
            if (dropdown.open && !dropdown.contains(event.target as Node)) dropdown.open = false;
        });

        dropdown.addEventListener("keydown", (event) => {
            if (event.key !== "Escape") return;
            dropdown.open = false;
            summary?.focus();
        });

        // Reveal the current page, which a long database can push out of view
        dropdown.addEventListener("toggle", () => {
            if (dropdown.open) dropdown.querySelector("a.active")?.scrollIntoView({ block: "nearest" });
        });
    }
</script>

<style>
    .db-dropdown {
        display: block;
        position: relative;
    }

    summary {
        align-items: baseline;
        border: 1px solid #dddddd;
        cursor: pointer;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        /* Also drops the native disclosure triangle, in favour of .marker */
        list-style: none;
        padding: 0.5rem 0.75rem;
        user-select: none;
    }

    summary:hover {
        background: #eeeeee;
    }

    .db-name {
        color: #666666;
    }

    .db-name::after {
        content: "/";
        padding-left: 0.5rem;
    }

    .page-name {
        font-weight: 600;
    }

    .marker {
        display: inline-block;
        margin-left: auto;
        padding-left: 0.5rem;
    }

    .db-dropdown[open] .marker {
        transform: rotate(180deg);
    }

    /* Anchored right: the sidebar sits at the viewport edge, so the menu grows leftwards */
    nav {
        background: #ffffff;
        border: 1px solid #dddddd;
        max-height: min(60vh, 24rem);
        overflow-y: auto;
        position: absolute;
        right: 0;
        top: calc(100% + 0.25rem);
        width: max-content;
        z-index: 10;
    }

    ul {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    a {
        color: inherit;
        display: block;
        padding: 0.35rem 0.5rem;
        text-decoration: none;
    }

    a:hover,
    a.active {
        background: #eeeeee;
    }

    a.active {
        font-weight: 600;
    }

    /* Stacked full-width, the menu must not spill past the viewport edge */
    @media (max-width: 1000px) {
        nav {
            max-width: 100%;
        }
    }
</style>
