---
import { ContentMap, type JsonMap } from "@exporter/map";
import config from "../../docs/content_map.json";
import { BASE_URL } from "../utils/base-url";
import logoSvg from "../../public/assets/hero/icon.svg?raw";
import menuSvg from "../../public/assets/icons/menu.svg?raw";

const content_map = ContentMap.fromJSON(config as JsonMap);

const nav_items = content_map.aggregates.map((agg) => {
    const label = agg.name.toString();
    const children = Array.from(agg.topLevelPages()).map(([entry_path, dest_path]) => {
        const child_label = entry_path.components().at(-1)?.toString() ?? entry_path.toString();
        return {
            label: child_label,
            href: `${BASE_URL}${dest_path.toSlug()}`,
        };
    });
    return { label, children };
});

const static_links = content_map.static_links;
---

<!-- Kept between pages rather than re-rendered, and held still while the page under it fades (see the styles) -->
<nav class="primary" aria-label="Primary navigation" transition:persist="site-nav">
    <a class="home-logo" href={BASE_URL} aria-label="Home" set:html={logoSvg} />

    <button class="chip menu-toggle" type="button" aria-expanded="false" aria-controls="nav-sections">
        <span>
            <span class="menu-icon" aria-hidden="true" set:html={menuSvg} />
            Menu
        </span>
    </button>

    <ul class="top-level" id="nav-sections">
        {
            nav_items.map(({ label, children }) => (
                <li>
                    <details class="nav-group">
                        <summary class="chip">
                            <span>{label}</span>
                        </summary>

                        <ul class="submenu">
                            {children.map(({ label, href }) => (
                                <li>
                                    <a href={href}>{label}</a>
                                </li>
                            ))}
                        </ul>
                    </details>
                </li>
            ))
        }
        {
            static_links.map(({ label, href }) => (
                <li>
                    <a class="chip" href={href.startsWith("/") ? `${BASE_URL}${href.slice(1)}` : href}>
                        <span>{label}</span>
                    </a>
                </li>
            ))
        }
    </ul>
</nav>

<script>
    import { makeDismissable } from "../utils/dismissable";
    import { closeWhenMouseLeaves } from "../utils/hover-menu";

    const nav = document.querySelector<HTMLElement>("nav.primary");
    const toggle = nav?.querySelector<HTMLButtonElement>(".menu-toggle");

    // The whole bar collapses on a narrow screen, where CSS hides the toggle otherwise
    if (nav && toggle) {
        const setOpen = (open: boolean) => {
            nav.toggleAttribute("data-open", open);
            toggle.setAttribute("aria-expanded", String(open));
        };

        toggle.addEventListener("click", () => setOpen(!nav.hasAttribute("data-open")));

        document.addEventListener("click", (event) => {
            if (!nav.contains(event.target as Node)) setOpen(false);
        });

        nav.addEventListener("keydown", (event) => {
            if (event.key !== "Escape") return;
            setOpen(false);
            toggle.focus();
        });

        // The bar stays between pages, so it closes after a link in it is followed
        document.addEventListener("astro:before-preparation", () => setOpen(false));
    }

    const groups = Array.from(document.querySelectorAll<HTMLDetailsElement>("details.nav-group"));

    for (const group of groups) {
        makeDismissable(group);

        // Two open menus would overlap, so opening one closes the rest
        group.addEventListener("toggle", () => {
            if (!group.open) return;
            for (const other of groups) if (other !== group) other.open = false;
        });
    }

    // With a mouse on the full-width bar, the menus open on hover. Touch screens and the collapsed bar keep the click
    const hover_menus = window.matchMedia("(hover: hover) and (pointer: fine) and (min-width: 1001px)");

    for (const group of groups) {
        const summary = group.querySelector("summary")!;

        group.addEventListener("pointerenter", () => {
            if (hover_menus.matches) group.open = true;
        });

        closeWhenMouseLeaves(group, group.querySelector(".submenu"), () => hover_menus.matches);

        // Hovering already opened it, so a click on the chip must not close it again under the cursor
        summary.addEventListener("click", (event) => {
            if (!hover_menus.matches || !group.matches(":hover")) return;
            event.preventDefault();
            group.open = true;
        });
    }

    // The ClientRouter moves the bar into each new page, which would roll an open menu down again (see the styles)
    if (nav) {
        document.addEventListener("astro:before-swap", () => (nav.dataset.arrived = ""));
        document.addEventListener("astro:after-swap", () => requestAnimationFrame(() => delete nav.dataset.arrived));
    }
</script>

<style>
    nav.primary {
        --chip-height: 2.5rem;
        --chip-skew: 20deg;
        align-items: center;
        background: var(--color-ebony-clay);
        box-sizing: border-box;
        display: flex;
        flex-wrap: wrap;
        font-family: var(--font-geist);
        gap: 1.25rem;
        padding: 1rem var(--page-gutter);
        /* Named here rather than with transition:name, whose generated name is keyed to the element's place in the
           render order: the bar moves into each new page keeping the old page's key, which the new page may not use */
        view-transition-name: site-nav;
        /* Its view-transition-name makes the bar a stacking context, which traps the submenus' z-index inside it,
           so the bar itself is lifted to their level, over the page (e.g. the home hero) but under tooltips */
        position: relative;
        z-index: 11;
    }

    /* Pinned to the left, while the chips are pushed to the right */
    .home-logo {
        display: block;
        flex: none;
        height: calc(var(--chip-height) * 1.25);
        transition: opacity 120ms ease;
    }

    .home-logo :global(svg) {
        display: block;
        height: 100%;
        width: auto;
    }

    /* The logo file is drawn in periwinkle, which the navbar swaps for lime yellow */
    .home-logo :global(svg [fill]:not([fill="none"])) {
        fill: var(--color-lime-yellow);
    }

    .home-logo:hover {
        opacity: 0.8;
    }

    .home-logo:focus-visible {
        outline: 2px solid var(--color-lime-yellow);
        outline-offset: 3px;
    }

    nav.primary ul {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .top-level {
        display: flex;
        flex: 1;
        flex-wrap: wrap;
        gap: 1.25rem;
        justify-content: flex-end;
    }

    .nav-group {
        position: relative;
    }

    /* The chips are parallelograms, so the skew is undone on the label to keep the text upright */
    .chip {
        background: var(--color-cornflower);
        box-sizing: border-box;
        color: var(--color-periwinkle);
        cursor: pointer;
        display: block;
        font-size: 0.9rem;
        font-weight: 700;
        line-height: calc(var(--chip-height) - 1rem);
        list-style: none;
        padding: 0.5rem 1.25rem;
        text-align: center;
        text-decoration: none;
        transform: skewX(calc(-1 * var(--chip-skew)));
        transition:
            background 120ms ease,
            color 120ms ease,
            padding 160ms ease;
        user-select: none;
    }

    .chip > span {
        display: block;
        transform: skewX(var(--chip-skew));
    }

    .menu-toggle {
        border: 0;
        display: none;
        font-family: inherit;
        width: 100%;
    }

    /* Drawn rather than the ☰ character, which some phones render as an emoji */
    .menu-icon {
        display: inline-block;
        height: 0.7em;
        margin-right: 0.4rem;
        vertical-align: 0.05em;
        width: 0.95em;
    }

    .menu-icon :global(svg) {
        display: block;
        height: 100%;
        overflow: visible;
        width: 100%;
    }

    /* The mock widens the chip in play and leaves the others alone */
    .chip:hover,
    .nav-group[open] > .chip {
        background: var(--color-lime-yellow);
        color: var(--color-ebony-clay);
        padding-inline: 3.25rem;
    }

    /* Above its submenu, whose shadow would otherwise darken the chip's lower edge */
    .nav-group[open] > .chip {
        position: relative;
        z-index: 11;
    }

    .chip:focus-visible {
        outline: 2px solid var(--color-lime-yellow);
        outline-offset: 3px;
    }

    /* Hangs from the bottom-right corner of the chip */
    .submenu {
        /* The mock's panel green, which is not one of the nine brand colours */
        background: #1d3631;
        border: 1px solid var(--color-lime-yellow);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
        box-sizing: border-box;
        max-height: auto;
        overflow-y: auto;
        padding: 0.4rem;
        position: absolute;
        right: calc(var(--chip-height) / 2 * tan(var(--chip-skew)));
        top: calc(100% - 1px);
        /* Exactly as wide as the chip's bottom edge, which `right` lines it up with; long names wrap */
        width: 100%;
        z-index: 10;
    }

    /* Wrapped names would otherwise run into the next page's */
    .submenu li + li {
        margin-top: 0.2rem;
    }

    .submenu a {
        color: var(--color-lime-yellow);
        display: block;
        font-size: 0.8rem;
        font-weight: 700;
        overflow-wrap: break-word;
        padding: 0.35rem 0.6rem;
        text-align: right;
        text-decoration: none;
    }

    /* The mock marks the page under the cursor with a caret; it sits inline so it stays beside the right-aligned label */
    /* Drawn rather than the ▶ character, which phones render as an emoji */
    .submenu a::before {
        background: currentcolor;
        clip-path: polygon(0 0, 100% 50%, 0 100%);
        content: "";
        display: inline-block;
        height: 0.6em;
        margin-right: 0.5rem;
        opacity: 0;
        width: 0.55em;
    }

    .submenu a:hover::before,
    .submenu a:focus-visible::before {
        opacity: 1;
    }

    .submenu a:focus-visible {
        outline: 2px solid var(--color-lime-yellow);
        outline-offset: -2px;
    }

    /* On the full-width bar, where it floats (stacked, it pushes the chips below it down instead).
       The list rolls down from its top edge on opening and back up on closing. The clip leaves room at the sides and
       bottom for the shadow; ::details-content stays shown until the roll-up ends (browsers without it just snap) */
    @media (min-width: 1001px) and (prefers-reduced-motion: no-preference) {
        .nav-group::details-content {
            transition: content-visibility 150ms allow-discrete;
        }

        .submenu {
            clip-path: inset(0 -2rem -2rem -2rem);
            transition: clip-path 150ms ease-out;
        }

        .nav-group:not([open]) .submenu {
            clip-path: inset(0 -2rem 100% -2rem);
            transition-timing-function: ease-in;
        }

        /* The chip stays lit and wide until its list has rolled up, as the list is as wide as the chip and would
           otherwise rewrap its names on the way */
        .nav-group:not([open]) > .chip {
            transition:
                background 120ms ease 150ms,
                color 120ms ease 150ms,
                padding 160ms ease 150ms;
        }

        /* But a hovered chip lights up at once */
        .nav-group:not([open]) > .chip:hover {
            transition-delay: 0ms;
        }

        /* Not when the bar is moved into the next page with a menu open (see the script) */
        @starting-style {
            nav.primary:not([data-arrived]) .nav-group[open] .submenu {
                clip-path: inset(0 -2rem 100% -2rem);
            }
        }
    }

    /* The layout stacks its sidebar at this width too, so the bar collapses with it */
    @media (max-width: 1000px) {
        nav.primary {
            gap: 0 1rem;
            padding: 0.75rem var(--page-gutter);
        }

        /* Shares the first row with the logo */
        .menu-toggle {
            display: block;
            flex: 1;
            width: auto;
        }

        /* Behind the toggle, so the sections stop owning the top of every page.
           Qualified to beat the margin reset on `nav.primary ul` */
        nav.primary .top-level {
            display: none;
            flex-basis: 100%;
            flex-direction: column;
            gap: 0.6rem;
            justify-content: flex-start;
            margin-top: 0.6rem;
        }

        nav.primary[data-open] .top-level {
            display: flex;
        }

        /* Full width already, so there is nothing for the chip in play to grow into */
        .chip,
        .chip:hover,
        .nav-group[open] > .chip {
            padding-inline: 1rem;
        }

        /* In flow rather than floating, so an open menu pushes the chips below it down */
        .submenu {
            box-shadow: none;
            max-height: none;
            position: static;
            width: auto;
        }
    }
</style>
