---
import { ContentMap, type JsonMap } from "@exporter/map";
import config from "../../docs/content_map.json";

const content_map = ContentMap.fromJSON(config as JsonMap);
const base_url = `${import.meta.env.BASE_URL}/`;

const nav_items = content_map.aggregates.map((agg) => {
    const label = agg.name.toString();
    const children = Array.from(agg.topLevelPages()).map(([entry_path, dest_path]) => {
        const child_label = entry_path.components().at(-1)?.toString() ?? entry_path.toString();
        return {
            label: child_label,
            href: `${base_url}${dest_path.toSlug()}`,
        };
    });
    return { label, children };
});

const static_links = content_map.static_links;
---

<nav class="primary" aria-label="Primary navigation">
    <button class="chip menu-toggle" type="button" aria-expanded="false" aria-controls="nav-sections">
        <span>&#9776; Menu</span>
    </button>

    <ul class="top-level" id="nav-sections">
        {
            nav_items.map(({ label, children }) => (
                <li>
                    <details class="nav-group">
                        <summary class="chip">
                            <span>{label}</span>
                        </summary>

                        <ul class="submenu">
                            {children.map(({ label, href }) => (
                                <li>
                                    <a href={href}>{label}</a>
                                </li>
                            ))}
                        </ul>
                    </details>
                </li>
            ))
        }
        {
            static_links.map(({ label, href }) => (
                <li>
                    <a class="chip" href={href.startsWith("/") ? `${base_url}${href.slice(1)}` : href}>
                        <span>{label}</span>
                    </a>
                </li>
            ))
        }
    </ul>
</nav>

<script>
    import { makeDismissable } from "../dismissable";

    const nav = document.querySelector<HTMLElement>("nav.primary");
    const toggle = nav?.querySelector<HTMLButtonElement>(".menu-toggle");

    // The whole bar collapses on a narrow screen, where CSS hides the toggle otherwise
    if (nav && toggle) {
        const setOpen = (open: boolean) => {
            nav.toggleAttribute("data-open", open);
            toggle.setAttribute("aria-expanded", String(open));
        };

        toggle.addEventListener("click", () => setOpen(!nav.hasAttribute("data-open")));

        document.addEventListener("click", (event) => {
            if (!nav.contains(event.target as Node)) setOpen(false);
        });

        nav.addEventListener("keydown", (event) => {
            if (event.key !== "Escape") return;
            setOpen(false);
            toggle.focus();
        });
    }

    const groups = Array.from(document.querySelectorAll<HTMLDetailsElement>("details.nav-group"));

    for (const group of groups) {
        makeDismissable(group);

        // Two open menus would overlap, so opening one closes the rest
        group.addEventListener("toggle", () => {
            if (!group.open) return;
            for (const other of groups) if (other !== group) other.open = false;
        });
    }
</script>

<style>
    nav.primary {
        --chip-height: 2.25rem;
        --chip-skew: 20deg;
        background: var(--color-ebony-clay);
        box-sizing: border-box;
        font-family: var(--font-geist);
        padding: 1rem 2rem;
    }

    nav.primary ul {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .top-level {
        display: flex;
        flex-wrap: wrap;
        gap: 1.25rem;
        justify-content: flex-end;
    }

    .nav-group {
        position: relative;
    }

    /* The chips are parallelograms, so the skew is undone on the label to keep the text upright */
    .chip {
        background: var(--color-cornflower);
        box-sizing: border-box;
        color: var(--color-periwinkle);
        cursor: pointer;
        display: block;
        font-size: 0.9rem;
        font-weight: 700;
        line-height: calc(var(--chip-height) - 1rem);
        list-style: none;
        padding: 0.5rem 1.25rem;
        text-align: center;
        text-decoration: none;
        transform: skewX(calc(-1 * var(--chip-skew)));
        transition:
            background 120ms ease,
            color 120ms ease,
            padding 160ms ease;
        user-select: none;
    }

    .chip > span {
        display: block;
        transform: skewX(var(--chip-skew));
    }

    .menu-toggle {
        border: 0;
        display: none;
        font-family: inherit;
        width: 100%;
    }

    /* The mock widens the chip in play and leaves the others alone */
    .chip:hover,
    .nav-group[open] > .chip {
        background: var(--color-lime-yellow);
        color: var(--color-ebony-clay);
        padding-inline: 3rem;
    }

    /* Above its submenu, whose shadow would otherwise darken the chip's lower edge */
    .nav-group[open] > .chip {
        position: relative;
        z-index: 11;
    }

    .chip:focus-visible {
        outline: 2px solid var(--color-lime-yellow);
        outline-offset: 3px;
    }

    /* Hangs from the bottom-right corner of the chip */
    .submenu {
        /* The mock's panel green, which is not one of the nine brand colours */
        background: #1d3631;
        border: 1px solid var(--color-lime-yellow);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
        max-height: min(60vh, 24rem);
        min-width: 100%;
        overflow-y: auto;
        padding: 0.4rem;
        position: absolute;
        right: calc(var(--chip-height) / 2 * tan(var(--chip-skew)));
        top: calc(100% - 1px);
        width: max-content;
        z-index: 10;
    }

    .submenu a {
        color: var(--color-lime-yellow);
        display: block;
        font-size: 0.8rem;
        font-weight: 700;
        padding: 0.35rem 0.6rem;
        text-align: right;
        text-decoration: none;
    }

    /* The mock marks the page under the cursor with a caret; it sits inline so it stays beside the right-aligned label */
    .submenu a::before {
        content: "\25b6";
        margin-right: 0.5rem;
        opacity: 0;
    }

    .submenu a:hover::before,
    .submenu a:focus-visible::before {
        opacity: 1;
    }

    .submenu a:focus-visible {
        outline: 2px solid var(--color-lime-yellow);
        outline-offset: -2px;
    }

    /* The layout stacks its sidebar at this width too, so the bar collapses with it */
    @media (max-width: 1000px) {
        nav.primary {
            padding: 0.75rem 1rem;
        }

        .menu-toggle {
            display: block;
        }

        /* Behind the toggle, so the sections stop owning the top of every page */
        .top-level {
            display: none;
            flex-direction: column;
            gap: 0.6rem;
            justify-content: flex-start;
            margin-top: 0.6rem;
        }

        nav.primary[data-open] .top-level {
            display: flex;
        }

        /* Full width already, so there is nothing for the chip in play to grow into */
        .chip,
        .chip:hover,
        .nav-group[open] > .chip {
            padding-inline: 1rem;
        }

        /* In flow rather than floating, so an open menu pushes the chips below it down */
        .submenu {
            box-shadow: none;
            max-height: none;
            position: static;
            width: auto;
        }
    }
</style>
