---
import { type CalloutAttrs } from "@exporter/markdown/components";
type Props = CalloutAttrs;

const attrs = Astro.props;
---

<div class="callout glow-panel">
    <div class="panel glow-panel-body">
        <span class="icon">{attrs.icon}</span>
        <div class="content">
            <slot />
        </div>
    </div>
</div>

<style>
    /* The border and glow come from .glow-panel in style.css */
    .callout {
        margin: 1.5rem 0;
    }

    .panel {
        align-items: flex-start;
        display: flex;
        font-family: var(--font-source-serif-4);
        gap: 1rem;
        padding: 2rem 2.5rem;
    }

    .icon {
        flex-shrink: 0;
        line-height: 1.6;
    }

    .content {
        min-width: 0;
    }

    /* The panel supplies its own padding, so the outermost children drop theirs */
    .content :global(> *:first-child) {
        margin-top: 0;
    }

    .content :global(> *:last-child) {
        margin-bottom: 0;
    }

    @media (max-width: 700px) {
        .panel {
            gap: 0.75rem;
            padding: 1.25rem;
        }
    }
</style>
