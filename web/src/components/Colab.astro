---
import { type ColabAttrs, COLAB_SLOTS } from "@exporter/markdown/components";
type Props = ColabAttrs;

const { url } = Astro.props;
COLAB_SLOTS satisfies readonly ["notebook", "content"];
---

<div class="colab glow-panel">
    <details class="panel glow-panel-body">
        <summary>
            <span class="marker" aria-hidden="true"></span>
            <span class="title">Notebook</span>
            <a class="open" href={url} target="_blank" rel="noopener noreferrer">Open in Colab</a>
        </summary>
        <div class="notebook">
            <slot name="notebook" />
        </div>
    </details>
</div>
<div class="colab-desc">
    <slot name="content" />
</div>

<style>
    /* The border and glow come from .glow-panel in style.css; the bottom margin clears the outline hanging below */
    .colab {
        margin: 2rem 0 3rem;
    }

    .panel {
        padding: 1.25rem 2.5rem;
    }

    summary {
        align-items: center;
        cursor: pointer;
        display: flex;
        gap: 1rem;
        list-style: none;
    }

    summary::-webkit-details-marker {
        display: none;
    }

    summary:focus-visible {
        outline: 2px solid var(--color-lime-yellow);
        outline-offset: 6px;
    }

    /* A chevron that turns to point down once the notebook is open */
    .marker {
        border-bottom: 2px solid var(--color-cornflower);
        border-right: 2px solid var(--color-cornflower);
        flex-shrink: 0;
        height: 0.5rem;
        transform: rotate(-45deg);
        transition: transform 160ms ease;
        width: 0.5rem;
    }

    .panel[open] .marker {
        transform: rotate(45deg);
    }

    .title {
        flex: 1;
        font: var(--text-subtitle);
    }

    .open {
        align-items: center;
        background: var(--color-cornflower);
        border-radius: 10px;
        color: var(--color-periwinkle);
        display: flex;
        flex-shrink: 0;
        font: 600 1rem / normal var(--font-geist);
        min-height: 2.875rem;
        padding: 0 1rem;
        text-decoration: none;
        transition:
            background 120ms ease,
            box-shadow 120ms ease,
            color 120ms ease;
    }

    /* The start of the mock's lime-to-green gradient, which mostly runs past the button, with its green glow */
    .open:is(:hover, :focus-visible) {
        background: linear-gradient(154deg, var(--color-lime-yellow), #8dfe54);
        box-shadow:
            0 0 10px #00ff92,
            0 4px 4px rgb(0 0 0 / 25%);
        color: var(--color-ebony-clay);
    }

    .open:focus-visible {
        outline: 2px solid var(--color-lime-yellow);
        outline-offset: 4px;
    }

    /* Long notebooks scroll inside the panel rather than taking over the page. */
    .notebook {
        border-top: 1px solid color-mix(in srgb, var(--color-cornflower) 50%, transparent);
        font-size: 0.875rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-top: 1.25rem;
        max-height: 36rem;
        overflow-y: auto;
        padding-top: 1.25rem;
    }

    /* One box per markdown cell; :global because the cells arrive through a slot */
    .notebook :global(.colab-markdown) {
        border: 1px solid color-mix(in srgb, var(--color-cornflower) 50%, transparent);
        border-radius: 16px;
        flex-shrink: 0;
        padding: 1rem 1.5rem;
    }

    .notebook :global(.colab-markdown > :first-child) {
        margin-top: 0;
    }

    .notebook :global(.colab-markdown > :last-child) {
        margin-bottom: 0;
    }

    .notebook :global(pre) {
        flex-shrink: 0;
        font-size: 0.9em;
        margin: 0;
    }

    .notebook :global(.colab-markdown h1) {
        font-size: 1.6em;
    }

    .notebook :global(.colab-markdown h2) {
        font-size: 1.35em;
    }

    .notebook :global(.colab-markdown h3) {
        font-size: 1.15em;
    }

    .notebook :global(.colab-markdown :is(h4, h5, h6)) {
        font-size: 1em;
    }

    .notebook :global(.colab-markdown :is(h1, h2, h3, h4, h5, h6)) {
        margin: 1.25em 0 0.5em;
    }

    .notebook :global(.colab-markdown table) {
        font-size: 0.9em;
    }

    .colab-desc {
        font: var(--text-caption);
    }

    @media (max-width: 700px) {
        .panel {
            padding: 1rem 1.25rem;
        }

        .notebook {
            max-height: 28rem;
        }
    }
</style>
