---
import type { MarkdownHeading } from "astro";

interface Props {
    headings: MarkdownHeading[];
}
const { headings } = Astro.props;

// Indent each entry relative to the shallowest heading on the page
// For instance, if there are H2 headings but not H1 headings,
// H2 headings are the minimum depth and should be left-aligned
const min_depth = headings.reduce((min, h) => Math.min(min, h.depth), 6);
---

<nav class="toc" aria-label="Table of contents">
    <details open>
        <summary>On this page</summary>
        <ul>
            {
                headings.map((heading) => (
                    <li style={`padding-left: ${(heading.depth - min_depth) * 1.5}rem`}>
                        <a href={`#${heading.slug}`} data-toc-slug={heading.slug}>
                            {heading.text}
                        </a>
                    </li>
                ))
            }
        </ul>
    </details>
</nav>

<script>
    import { onPage } from "../utils/page";

    onPage((signal) => {
        let observer: IntersectionObserver | undefined;

        // Stacked above the article, an open list pushes the page itself out of view
        const toc = document.querySelector<HTMLDetailsElement>("nav.toc details");
        if (toc) toc.open = !window.matchMedia("(max-width: 1000px)").matches;

        const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("nav.toc a[data-toc-slug]"));

        if (links.length > 0) {
            const link_by_slug = new Map<string, HTMLAnchorElement>();
            const targets: HTMLElement[] = [];

            for (const link of links) {
                const slug = link.dataset.tocSlug!;
                const heading = document.getElementById(slug);
                if (heading) {
                    link_by_slug.set(slug, link);
                    targets.push(heading);
                }
            }

            const visible = new Set<string>();

            // The sidebar's own scroll area, when the list is too long for the screen
            const scroller = document.querySelector<HTMLElement>(".page-toc");

            // Scrolls the list (not the page, as scrollIntoView would) just enough to show the entry, with a little room
            const keepInView = (link: HTMLElement) => {
                if (!scroller || scroller.scrollHeight <= scroller.clientHeight) return;
                const margin = 24;
                const view = scroller.getBoundingClientRect();
                const entry = link.getBoundingClientRect();
                let delta = 0;
                if (entry.top < view.top + margin) delta = entry.top - view.top - margin;
                else if (entry.bottom > view.bottom - margin) delta = entry.bottom - view.bottom + margin;
                if (delta !== 0) scroller.scrollBy({ top: delta, behavior: "smooth" });
            };

            // Mark a heading as active
            const setActive = (slug: string | null) => {
                for (const [key, link] of link_by_slug) {
                    link.classList.toggle("active", key === slug);
                }
                const link = slug ? link_by_slug.get(slug) : undefined;
                if (link) keepInView(link);
            };

            // Determine which heading is active (in user view)
            const pickActive = () => {
                // Prefer the topmost heading currently in view
                let active: string | null = null;
                let best_top = Infinity;
                for (const el of targets) {
                    if (!visible.has(el.id)) continue;
                    const top = el.getBoundingClientRect().top;
                    if (top < best_top) {
                        best_top = top;
                        active = el.id;
                    }
                }

                // Nothing in view (e.g. scrolled past)
                if (!active) {
                    for (const el of targets) {
                        // Highlight the last heading above
                        if (el.getBoundingClientRect().top < 100) active = el.id;
                    }
                }

                setActive(active);
            };

            // A clicked entry stays the active one until the reader scrolls themselves. Otherwise the jump, which lands its
            // heading above the band watched below, would pick whichever close heading follows it
            let clicked = false;
            for (const [slug, link] of link_by_slug) {
                link.addEventListener("click", () => {
                    clicked = true;
                    setActive(slug);
                });
            }
            const release = (): void => {
                clicked = false;
            };
            for (const type of ["wheel", "touchmove", "keydown", "pointerdown"]) {
                window.addEventListener(type, release, { passive: true, signal });
            }

            // Pick new active heading on scroll
            observer = new IntersectionObserver(
                (entries) => {
                    for (const entry of entries) {
                        if (entry.isIntersecting) visible.add(entry.target.id);
                        else visible.delete(entry.target.id);
                    }
                    if (!clicked) pickActive();
                },
                { rootMargin: "-80px 0px -60% 0px", threshold: 0 },
            );

            targets.forEach((target) => observer!.observe(target));
        }

        return () => observer?.disconnect();
    });
</script>

<style>
    .toc {
        font: var(--text-small);
    }

    summary {
        color: var(--color-periwinkle);
        cursor: pointer;
        font: var(--text-h3);
        margin: 1rem 0 0.5rem;
        user-select: none;
    }

    summary:focus-visible {
        outline: 2px solid var(--color-cornflower);
        outline-offset: 2px;
    }

    ul {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    /* The current entry is picked out as the DbDropdown marks its current page */
    a {
        border-radius: 6px;
        color: var(--color-periwinkle);
        display: block;
        font: var(--text-caption);
        padding: 0.4rem 0.55rem;
        text-decoration: none;
        transition:
            background 120ms ease,
            color 120ms ease;
    }

    a:hover {
        background: var(--color-periwinkle);
        color: var(--color-ebony-clay);
    }

    a:focus-visible {
        outline: 2px solid var(--color-cornflower);
        outline-offset: 1px;
    }

    a.active {
        background: var(--color-cornflower);
        color: white;
    }

    /* Beside the article there is room for the whole list, so only a narrow screen
       has anything to gain from collapsing it */
    @media (min-width: 1001px) {
        summary {
            cursor: default;
            list-style: none;
            pointer-events: none;
        }
    }
</style>
