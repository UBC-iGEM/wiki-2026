---
import { type CarouselAttrs, CAROUSEL_SLOTS } from "@exporter/markdown/components";
import { imageScaleStyle } from "../utils/image-scale";

type Props = CarouselAttrs;
CAROUSEL_SLOTS satisfies readonly ["descriptions"];
const { slides } = Astro.props;
const multiple = slides.length > 1;
---

<div class:list={["carousel", { single: !multiple }]}>
    <div class="carousel-row">
        {multiple && <button class="carousel-arrow nav-arrow prev" aria-label="Previous image" />}

        <div class="carousel-stage">
            {
                slides.map((slide, i) => (
                    <div class="carousel-slide" data-index={i}>
                        <figure class="carousel-panel glow-panel">
                            <div class="carousel-frame glow-panel-body">
                                <img
                                    src={slide.url}
                                    alt={slide.alt}
                                    style={imageScaleStyle(slide.scale)}
                                    data-lightbox
                                />
                            </div>
                        </figure>
                    </div>
                ))
            }
        </div>

        {multiple && <button class="carousel-arrow nav-arrow next" aria-label="Next image" />}
    </div>

    <div class="carousel-descs">
        <!-- Descriptions arrive pre-wrapped in `.carousel-desc[data-index]` divs from the exporter (static slot names only) -->
        <slot name="descriptions" />
    </div>

    {
        multiple && (
            <div class="carousel-dots nav-dots">
                {slides.map((_, i) => (
                    <button class="nav-dot" data-index={i} aria-label={`Go to image ${i + 1}`} />
                ))}
            </div>
        )
    }
</div>

<script>
    import { onPage } from "../utils/page";

    onPage(() => {
        const observers: ResizeObserver[] = [];

        for (const carousel of document.querySelectorAll<HTMLElement>(".carousel:not(.single)")) {
            const slides = Array.from(carousel.querySelectorAll<HTMLElement>(".carousel-slide"));
            const descs = Array.from(carousel.querySelectorAll<HTMLElement>(".carousel-desc"));
            const dots = Array.from(carousel.querySelectorAll<HTMLElement>(".nav-dot"));
            const n = slides.length;
            if (n < 2) continue;

            // Match by `data-index` rather than DOM/array position, so slides (rendered directly
            // in this template) and descriptions (arriving via <slot>) can't silently drift apart
            const indexOf = (el: HTMLElement) => Number(el.dataset.index);

            // The current slide is centred in a stage as tall as the tallest slide;
            // its caption is lifted into the space below it, so it stays beside it, while the dots stay put
            const stage = carousel.querySelector<HTMLElement>(".carousel-stage")!;
            const liftBelow = () => {
                const active = slides.find((slide) => slide.dataset.role === "active");
                if (!active) return;
                const style = getComputedStyle(stage);
                const content = stage.clientHeight - parseFloat(style.paddingTop) - parseFloat(style.paddingBottom);
                // Layout sizes, unaffected by the slides' transforms mid-transition
                const space = Math.max(0, (content - active.offsetHeight) / 2);
                carousel.style.setProperty("--below-lift", `${-space}px`);
            };
            // Images load, and the stage resizes with the window
            const resizes = new ResizeObserver(liftBelow);
            observers.push(resizes);
            resizes.observe(stage);
            slides.forEach((slide) => resizes.observe(slide));

            let current = 0;
            const show = (index: number) => {
                current = (index + n) % n;
                for (const slide of slides) {
                    // Position relative to the current slide, wrapping around
                    const offset = (indexOf(slide) - current + n) % n;
                    const role = offset === 0 ? "active" : offset === 1 ? "next" : offset === n - 1 ? "prev" : "hidden";
                    slide.dataset.role = role;
                    slide.inert = role !== "active";
                }
                descs.forEach((desc) => desc.classList.toggle("active", indexOf(desc) === current));
                dots.forEach((dot) => dot.classList.toggle("active", indexOf(dot) === current));
                liftBelow();
            };

            carousel.querySelector(".carousel-arrow.prev")?.addEventListener("click", () => show(current - 1));
            carousel.querySelector(".carousel-arrow.next")?.addEventListener("click", () => show(current + 1));
            dots.forEach((dot) => dot.addEventListener("click", () => show(indexOf(dot))));
            // The peeking slides bring themselves to the front
            for (const slide of slides)
                slide.addEventListener("click", () => {
                    if (slide.dataset.role !== "active") show(indexOf(slide));
                });

            // Everything up to here is a no-JS fallback (CSS shows only the first slide);
            // this flips the carousel into JS-driven mode once navigation is wired up
            carousel.classList.add("js-ready");
            show(current);
        }

        return () => observers.forEach((observer) => observer.disconnect());
    });
</script>

<!-- Global, as the descriptions arrive through a slot and don't carry Astro's scoping attribute -->
<style is:global>
    /* Capped in width, so on wide screens the neighbours and arrows stay close to the image rather than at the page edges */
    .carousel {
        --slide-width: 70%;
        --frame-height: 34rem;
        margin: 2rem auto 3rem;
        max-width: 60rem;
    }

    /* The arrows sit outside the images, either side of them */
    .carousel-row {
        align-items: center;
        display: flex;
        gap: 1.25rem;
    }

    /*
     * Every slide in the same grid cell, which the tallest sets the height of,
     * so the page below doesn't move as the slides change; the bottom padding leaves room for the offset outline.
     */
    .carousel-stage {
        align-items: center;
        display: grid;
        flex: 1;
        justify-items: center;
        min-width: 0;
        overflow-x: clip;
        padding: 0.5rem 0 1.5rem;
    }

    /*
     * The slide is a fixed-width slot that positions the peeking neighbours;
     * the panel inside shrinks to the image, so only the panel takes clicks
     */
    .carousel-slide {
        display: flex;
        grid-area: 1 / 1;
        justify-content: center;
        pointer-events: none;
        transition:
            opacity 300ms ease,
            transform 300ms ease;
        width: var(--slide-width);
    }

    /* A lone image takes the full width, less room for its outline */
    .carousel.single .carousel-slide {
        width: calc(100% - 1rem);
    }

    /* No-JS fallback: show only the first slide until the script marks the carousel ready */
    .carousel:not(.js-ready) .carousel-slide:not(:first-child) {
        display: none;
    }

    .carousel-slide[data-role="active"] {
        z-index: 2;
    }

    .carousel-slide:is([data-role="prev"], [data-role="next"]) {
        cursor: var(--cursor-interact);
        --cursor-over-text: var(--cursor-interact);
        opacity: 0.1;
        z-index: 1;
    }

    /* Clicking a peeking slide navigates, so its image doesn't offer to enlarge */
    .carousel-slide:is([data-role="prev"], [data-role="next"]) img[data-lightbox] {
        cursor: var(--cursor-interact);
        --cursor-over-text: var(--cursor-interact);
    }

    .carousel-slide[data-role="prev"] {
        transform: translateX(-55%) scale(0.85);
    }

    .carousel-slide[data-role="next"] {
        transform: translateX(55%) scale(0.85);
    }

    .carousel-slide[data-role="hidden"] {
        opacity: 0;
        visibility: hidden;
    }

    .carousel-panel {
        margin: 0;
        max-width: 100%;
        min-width: 0;
        pointer-events: auto;
    }

    .carousel-slide[data-role="hidden"] .carousel-panel {
        pointer-events: none;
    }

    /* The frame hugs the image, which is capped to the frame height (times its `--img-scale`) without cropping */
    .carousel-frame {
        box-sizing: border-box;
        overflow: hidden;
        padding: 0.75rem;
    }

    .carousel .carousel-frame img {
        border-radius: 22px;
        display: block;
        height: auto;
        max-height: calc((var(--frame-height) - 1.5rem) * var(--img-scale, 1));
        max-width: min(100%, 100% * var(--img-scale, 1));
        object-fit: contain;
        width: auto;
    }

    /* Below the images, above the dots; only the current slide's shows */
    .carousel-descs {
        font: var(--text-caption);
        margin-top: 0.5rem;
        text-align: center;
    }

    /* Lifted up to the current slide (see the script), and painted over any taller neighbour it then overlaps */
    .carousel-descs {
        position: relative;
        transform: translateY(var(--below-lift, 0));
        transition: transform 300ms ease;
        z-index: 3;
    }

    .carousel-desc p {
        margin: 0;
    }

    .carousel-desc:not(:first-child),
    .carousel.js-ready .carousel-desc {
        display: none;
    }

    .carousel.js-ready .carousel-desc.active {
        display: block;
    }

    .carousel-dots {
        margin-top: 1.25rem;
    }

    @media (prefers-reduced-motion: reduce) {
        .carousel-slide,
        .carousel-descs {
            transition: none;
        }
    }

    /* Too narrow for the neighbours to peek */
    @media (max-width: 700px) {
        .carousel {
            /* Less room for the outline, which hangs 0.5rem to the side at this width */
            --slide-width: calc(100% - 0.5rem);
            --frame-height: 20rem;
        }

        .carousel-row {
            gap: 0.5rem;
        }

        .carousel-slide:is([data-role="prev"], [data-role="next"]) {
            opacity: 0;
            visibility: hidden;
        }

        .carousel-slide:is([data-role="prev"], [data-role="next"]) .carousel-panel {
            pointer-events: none;
        }
    }
</style>
