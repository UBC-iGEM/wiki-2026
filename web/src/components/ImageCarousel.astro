---
import { type CarouselAttrs, CAROUSEL_SLOTS } from "@exporter/markdown/components";

type Props = CarouselAttrs;
CAROUSEL_SLOTS satisfies readonly ["descriptions"];
const { slides } = Astro.props;
const multiple = slides.length > 1;
---

<div class:list={["carousel", { single: !multiple }]}>
    <div class="carousel-row">
        {multiple && <button class="carousel-arrow nav-arrow prev" aria-label="Previous image" />}

        <div class="carousel-stage">
            {
                slides.map((slide, i) => (
                    <figure class="carousel-slide glow-panel" data-index={i}>
                        <div class="carousel-frame glow-panel-body">
                            <img src={slide.url} alt={slide.alt} />
                        </div>
                    </figure>
                ))
            }
        </div>

        {multiple && <button class="carousel-arrow nav-arrow next" aria-label="Next image" />}
    </div>

    <div class="carousel-descs">
        <!-- Descriptions arrive pre-wrapped in `.carousel-desc[data-index]` divs from the exporter (static slot names only) -->
        <slot name="descriptions" />
    </div>

    {
        multiple && (
            <div class="carousel-dots nav-dots">
                {slides.map((_, i) => (
                    <button class="nav-dot" data-index={i} aria-label={`Go to image ${i + 1}`} />
                ))}
            </div>
        )
    }
</div>

<script>
    for (const carousel of document.querySelectorAll<HTMLElement>(".carousel:not(.single)")) {
        const slides = Array.from(carousel.querySelectorAll<HTMLElement>(".carousel-slide"));
        const descs = Array.from(carousel.querySelectorAll<HTMLElement>(".carousel-desc"));
        const dots = Array.from(carousel.querySelectorAll<HTMLElement>(".nav-dot"));
        const n = slides.length;
        if (n < 2) continue;

        // Match by `data-index` rather than DOM/array position, so slides (rendered directly
        // in this template) and descriptions (arriving via <slot>) can't silently drift apart
        const indexOf = (el: HTMLElement) => Number(el.dataset.index);

        let current = 0;
        const show = (index: number) => {
            current = (index + n) % n;
            for (const slide of slides) {
                // Position relative to the current slide, wrapping around
                const offset = (indexOf(slide) - current + n) % n;
                const role = offset === 0 ? "active" : offset === 1 ? "next" : offset === n - 1 ? "prev" : "hidden";
                slide.dataset.role = role;
                slide.inert = role !== "active";
            }
            descs.forEach((desc) => desc.classList.toggle("active", indexOf(desc) === current));
            dots.forEach((dot) => dot.classList.toggle("active", indexOf(dot) === current));
        };

        carousel.querySelector(".carousel-arrow.prev")?.addEventListener("click", () => show(current - 1));
        carousel.querySelector(".carousel-arrow.next")?.addEventListener("click", () => show(current + 1));
        dots.forEach((dot) => dot.addEventListener("click", () => show(indexOf(dot))));
        // The peeking slides bring themselves to the front
        for (const slide of slides)
            slide.addEventListener("click", () => {
                if (slide.dataset.role !== "active") show(indexOf(slide));
            });

        // Everything up to here is a no-JS fallback (CSS shows only the first slide);
        // this flips the carousel into JS-driven mode once navigation is wired up
        carousel.classList.add("js-ready");
        show(current);
    }
</script>

<!-- Global, as the descriptions arrive through a slot and don't carry Astro's scoping attribute -->
<style is:global>
    .carousel {
        --slide-width: 70%;
        --frame-height: 26rem;
        margin: 2rem 0 3rem;
    }

    /* The arrows sit outside the images, either side of them */
    .carousel-row {
        align-items: center;
        display: flex;
        gap: 1.25rem;
    }

    /* Every slide in the same grid cell; the bottom padding leaves room for the offset outline */
    .carousel-stage {
        display: grid;
        flex: 1;
        justify-items: center;
        min-width: 0;
        overflow-x: clip;
        padding: 0.5rem 0 1.5rem;
    }

    .carousel-slide {
        grid-area: 1 / 1;
        margin: 0;
        transition:
            opacity 300ms ease,
            transform 300ms ease;
        width: var(--slide-width);
    }

    /* A lone image takes the full width, less room for its outline */
    .carousel.single .carousel-slide {
        width: calc(100% - 1rem);
    }

    /* No-JS fallback: show only the first slide until the script marks the carousel ready */
    .carousel:not(.js-ready) .carousel-slide:not(:first-child) {
        display: none;
    }

    .carousel-slide[data-role="active"] {
        z-index: 2;
    }

    .carousel-slide:is([data-role="prev"], [data-role="next"]) {
        cursor: pointer;
        opacity: 0.4;
        z-index: 1;
    }

    .carousel-slide[data-role="prev"] {
        transform: translateX(-55%) scale(0.85);
    }

    .carousel-slide[data-role="next"] {
        transform: translateX(55%) scale(0.85);
    }

    .carousel-slide[data-role="hidden"] {
        opacity: 0;
        pointer-events: none;
        visibility: hidden;
    }

    /* The image fits inside a fixed-height frame without cropping */
    .carousel-frame {
        align-items: center;
        box-sizing: border-box;
        display: flex;
        height: var(--frame-height);
        justify-content: center;
        overflow: hidden;
        padding: 0.75rem;
    }

    .carousel .carousel-frame img {
        border-radius: 22px;
        display: block;
        height: auto;
        max-height: 100%;
        max-width: 100%;
        object-fit: contain;
        width: auto;
    }

    /* Below the images, above the dots; only the current slide's shows */
    .carousel-descs {
        margin-top: 0.75rem;
        text-align: center;
    }

    .carousel-desc p {
        margin: 0;
    }

    .carousel-desc:not(:first-child),
    .carousel.js-ready .carousel-desc {
        display: none;
    }

    .carousel.js-ready .carousel-desc.active {
        display: block;
    }

    .carousel-dots {
        margin-top: 1.25rem;
    }

    @media (prefers-reduced-motion: reduce) {
        .carousel-slide {
            transition: none;
        }
    }

    /* Too narrow for the neighbours to peek */
    @media (max-width: 700px) {
        .carousel {
            /* Less room for the outline, which hangs 0.5rem to the side at this width */
            --slide-width: calc(100% - 0.5rem);
            --frame-height: 16rem;
        }

        .carousel-row {
            gap: 0.5rem;
        }

        .carousel-slide:is([data-role="prev"], [data-role="next"]) {
            opacity: 0;
            pointer-events: none;
            visibility: hidden;
        }
    }
</style>
