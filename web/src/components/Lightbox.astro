---
/*
 * One fullscreen viewer per page, opened by clicking any `img[data-lightbox]`, or any `[data-lightbox-video]` holding a
 * Video Universe embed link (and its `data-ratio`) to play.
 * Components opt in with the attributes; this listens for them page-wide.
 */
---

<!-- Kept between pages, as the script below holds on to it -->
<dialog class="lightbox" aria-label="Enlarged image" transition:persist="lightbox">
    <button class="lightbox-close" aria-label="Close">×</button>
    <img class="lightbox-img" alt="" />
    <iframe class="lightbox-video" title="Video" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen hidden
    ></iframe>
</dialog>

<script>
    const dialog = document.querySelector<HTMLDialogElement>("dialog.lightbox")!;
    const view = dialog.querySelector<HTMLImageElement>(".lightbox-img")!;
    const frame = dialog.querySelector<HTMLIFrameElement>(".lightbox-video")!;
    const reduced_motion = matchMedia("(prefers-reduced-motion: reduce)");

    // The figure or poster that was opened, for the viewer to shrink back into
    let source: HTMLElement | null = null;

    /** Runs `update`, growing `from` into `to` across it where the browser can (see the lightbox rule in style.css). */
    function morph(from: HTMLElement | null, to: () => HTMLElement | null, update: () => Promise<void> | void): void {
        if (!document.startViewTransition || reduced_motion.matches || !from) {
            void update();
            return;
        }
        // Only one element may carry the name at a time: the old end, then the new one
        from.style.viewTransitionName = "lightbox";
        let target: HTMLElement | null = null;
        const transition = document.startViewTransition(async () => {
            from.style.removeProperty("view-transition-name");
            await update();
            target = to();
            if (target) target.style.viewTransitionName = "lightbox";
        });
        void transition.finished.finally(() => target?.style.removeProperty("view-transition-name"));
    }

    /** Whether any of `element` is on screen, as growing out of a figure scrolled away would fly in from afar. */
    function onScreen(element: Element): boolean {
        const rect = element.getBoundingClientRect();
        return rect.bottom > 0 && rect.top < innerHeight && rect.right > 0 && rect.left < innerWidth;
    }

    /** Shows one of the image or the video, labelling the dialog for it. */
    function show(viewer: HTMLImageElement | HTMLIFrameElement, label: string): void {
        view.hidden = viewer !== view;
        frame.hidden = viewer !== frame;
        dialog.setAttribute("aria-label", label);
    }

    function open(img: HTMLImageElement): void {
        source = img;
        morph(
            img,
            () => view,
            async () => {
                show(view, "Enlarged image");
                view.src = img.currentSrc || img.src;
                view.alt = img.alt;
                // The enlarged image must be drawn before it is captured, or the figure grows into a blank
                await view.decode().catch(() => undefined);
                // Its shape, for CSS to scale it up to the screen (an SVG without a size of its own takes the figure's)
                const ratio =
                    view.naturalWidth && view.naturalHeight
                        ? view.naturalWidth / view.naturalHeight
                        : img.width / img.height;
                view.style.setProperty("--ratio", String(ratio));
                dialog.showModal();
            },
        );
    }

    function openVideo(poster: HTMLElement): void {
        source = poster;
        morph(
            poster,
            () => frame,
            () => {
                show(frame, "Video player");
                // Playing straight away, as opening it was the click on play
                const src = new URL(poster.dataset.lightboxVideo!);
                src.searchParams.set("autoplay", "1");
                frame.src = src.href;
                frame.title = poster.getAttribute("aria-label") ?? "Video";
                frame.style.setProperty("--ratio", poster.dataset.ratio || String(16 / 9));
                dialog.showModal();
            },
        );
    }

    function close(): void {
        if (!dialog.open) return;
        const target = source?.isConnected && onScreen(source) ? source : null;
        morph(
            target ? (frame.hidden ? view : frame) : null,
            () => target,
            () => dialog.close(),
        );
    }

    // Capture phase, so a peeking carousel slide is checked before its own click handler brings it to the front
    document.addEventListener(
        "click",
        (event) => {
            const img = (event.target as Element).closest<HTMLImageElement>("img[data-lightbox]");
            if (img) {
                // A peeking carousel slide navigates rather than enlarges
                if (img.closest('.carousel-slide[data-role]:not([data-role="active"])')) return;
                open(img);
                return;
            }
            const poster = (event.target as Element).closest<HTMLElement>("[data-lightbox-video]");
            if (poster) openVideo(poster);
        },
        { capture: true },
    );

    // Any click inside closes it, as the image fills the dialog (and clicks within the video stay in its frame)
    dialog.addEventListener("click", close);
    // Escape too, shrinking back rather than vanishing
    dialog.addEventListener("cancel", (event) => {
        event.preventDefault();
        close();
    });
    dialog.addEventListener("close", () => {
        view.removeAttribute("src");
        // Unloading the embed stops it playing; removing `src` alone would leave it running
        frame.src = "about:blank";
        source = null;
    });

    // The dialog is kept between pages, so back/forward with it open must not carry the image along
    document.addEventListener("astro:before-preparation", () => dialog.close());
</script>

<style is:global>
    img[data-lightbox] {
        cursor: var(--cursor-zoom);
        --cursor-over-text: var(--cursor-zoom);
    }
</style>

<style>
    .lightbox {
        background: transparent;
        border: none;
        cursor: var(--cursor-zoomout);
        --cursor-over-text: var(--cursor-zoomout);
        height: 100%;
        max-height: none;
        max-width: none;
        padding: 0;
        width: 100%;
        /* The room left around the image: on top and bottom, enough to clear the close button */
        --margin-x: max(var(--page-gutter), 8vw);
        --margin-y: max(4.5rem, 8vh);
    }

    .lightbox[open] {
        align-items: center;
        display: flex;
        justify-content: center;
    }

    .lightbox::backdrop {
        backdrop-filter: blur(4px);
        background: color-mix(in srgb, var(--color-ebony-clay) 90%, transparent);
    }

    .lightbox-img,
    .lightbox-video {
        border-radius: 22px;
        box-shadow: 0 0 2.5rem color-mix(in srgb, var(--color-cornflower) 40%, transparent);
        /* As large as fits inside the margins, however small the file: the full width, or the full height at its --ratio */
        aspect-ratio: var(--ratio, auto);
        height: auto;
        width: min(100vw - 2 * var(--margin-x), (100dvh - 2 * var(--margin-y)) * var(--ratio, 1));
    }

    .lightbox-video {
        background: #000;
        border: none;
    }

    .lightbox-close {
        background: none;
        border: none;
        color: var(--color-periwinkle);
        cursor: var(--cursor-interact);
        --cursor-over-text: var(--cursor-interact);
        font-family: var(--font-geist);
        font-size: 2.5rem;
        line-height: 1;
        padding: 0.25rem 0.75rem;
        position: absolute;
        right: var(--page-gutter);
        top: 0.75rem;
    }

    .lightbox-close:hover,
    .lightbox-close:focus-visible {
        color: var(--color-lime-yellow);
        outline: none;
    }

    @media (max-width: 700px) {
        .lightbox-img,
        .lightbox-video {
            border-radius: 14px;
        }
    }
</style>
