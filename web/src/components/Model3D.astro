---
import { MODEL3D_SLOTS } from "@exporter/markdown/components";
import HoverHint from "./HoverHint.astro";

interface Props {
    url: string;
    /** Leaves out the box, for a viewer placed inside another component's. */
    bare?: boolean;
}

const { url, bare = false } = Astro.props;
MODEL3D_SLOTS satisfies readonly [];
---

<!-- The HoverHint stands in for model-viewer's own interaction prompt -->{
    bare ? (
        <div class="stage">
            <model-viewer
                src={url}
                alt="Interactive 3D model"
                camera-controls
                auto-rotate
                touch-action="pan-y"
                interaction-prompt="none"
            />
            <HoverHint />
        </div>
    ) : (
        <div class="model3d glow-panel">
            <div class="panel glow-panel-body">
                <div class="stage">
                    <model-viewer
                        src={url}
                        alt="Interactive 3D model"
                        camera-controls
                        auto-rotate
                        touch-action="pan-y"
                        interaction-prompt="none"
                    />
                    <HoverHint />
                </div>
            </div>
        </div>
    )
}

<script>
    import "@google/model-viewer";
    import { onPage } from "../utils/page";

    // model-viewer sets its grab cursors inline inside its shadow root, out of reach of the page's rule for
    // widgets, so each viewer is given that rule itself
    onPage(() => {
        for (const viewer of document.querySelectorAll("model-viewer")) {
            const root = viewer.shadowRoot;
            if (!root || root.querySelector("style.interact-cursor")) continue;
            const style = document.createElement("style");
            style.className = "interact-cursor";
            style.textContent = "* { cursor: var(--cursor-interact) !important; }";
            root.append(style);
        }
    });
</script>

<style>
    /* The border and glow come from .glow-panel in style.css; the bottom margin clears the outline hanging below */
    .model3d {
        margin: 2rem 0 3rem;
    }

    .panel {
        padding: 1.25rem 2.5rem;
    }

    /* Anchors the HoverHint */
    .stage {
        position: relative;
    }

    /* Overrides model-viewer's own 300x150px default */
    model-viewer {
        display: block;
        height: 32rem;
        width: 100%;
    }

    @media (max-width: 700px) {
        .panel {
            padding: 1rem 1.25rem;
        }

        model-viewer {
            height: 20rem;
        }
    }
</style>
