---
import HoverHint from "./HoverHint.astro";
---

<section class="ast-diagram">
    <h2>How does microfluidics-based AST work?</h2>
    <p class="diagram-caption">Patient sample and antibiotic are loaded into chamber A</p>

    <div class="diagram-body">
        <div class="chip-visual">
            <img
                class="chip-blank"
                src="https://static.igem.wiki/teams/6279/wiki/manual/chip-prototype-blank.webp"
                alt=""
                width="512"
                height="1293"
                loading="lazy"
            />
            <!-- One at a time over the blank, which stays put beneath them: whichever chambers' labels are on -->
            <img
                class="chip-highlight chip-highlight--a"
                src="https://static.igem.wiki/teams/6279/wiki/manual/chip-prototype-a.webp"
                alt=""
                width="512"
                height="1293"
                loading="lazy"
            />
            <img
                class="chip-highlight chip-highlight--b"
                src="https://static.igem.wiki/teams/6279/wiki/manual/chip-prototype-b.webp"
                alt=""
                width="512"
                height="1293"
                loading="lazy"
            />
            <img
                class="chip-highlight chip-highlight--ab"
                src="https://static.igem.wiki/teams/6279/wiki/manual/chip-prototype-ab.webp"
                alt=""
                width="512"
                height="1293"
                loading="lazy"
            />
        </div>

        <div class="diagram-col diagram-col--right">
            <div class="chamber">
                <div class="info-trigger info-trigger--left info-trigger--chamber-a" role="button" aria-pressed="false" tabindex="0">
                    <div class="info-bubble-art" aria-hidden="true"></div>
                    <HoverHint class="chamber-hint" retireOnUse />
                    <h3>Chamber A</h3>
                    <p>
                        Where patient sample and antibiotic interacts, and antibiotic degradation occurs within 1-4
                        hours
                    </p>
                </div>
            </div>
        </div>

        <!-- After chamber A in the markup, so the stacked layout still reads chip, A, B -->
        <div class="diagram-col diagram-col--left">
            <div class="chamber">
                <div class="info-trigger info-trigger--right info-trigger--chamber-b" role="button" aria-pressed="false" tabindex="0">
                    <div class="info-bubble-art" aria-hidden="true"></div>
                    <HoverHint class="chamber-hint" retireOnUse />
                    <h3>Chamber B</h3>
                    <p>Biosensor <i>E. coli</i> interacts with intact/degraded antibiotic</p>
                </div>
            </div>
        </div>
    </div>

    <div class="legend">
        <p><mark class="legend-susceptible">Fluorescent output</mark> = sample is susceptible</p>
        <p>No fluorescence = sample is <mark class="legend-resistant">resistant</mark></p>
    </div>
</section>

<script>
    import { onPage } from "../utils/page";

    onPage(() => {
        for (const trigger of document.querySelectorAll<HTMLElement>(".ast-diagram .info-trigger")) {
            // Clicking (or Enter/Space) turns a chamber on until it's clicked again, so both can be on at once
            const toggle = () =>
                trigger.setAttribute("aria-pressed", String(trigger.getAttribute("aria-pressed") !== "true"));
            trigger.addEventListener("click", toggle);
            trigger.addEventListener("keydown", (event) => {
                if (event.key !== "Enter" && event.key !== " ") return;
                event.preventDefault();
                toggle();
            });

            // Hovering previews it, by mouse only: a touch's :hover would stick after the tap that turned it off
            trigger.addEventListener("pointerenter", (event) => {
                if (event.pointerType === "mouse") trigger.classList.add("is-hovered");
            });
            trigger.addEventListener("pointerleave", () => trigger.classList.remove("is-hovered"));
        }
    });
</script>

<style>
    .ast-diagram {
        margin: 0 auto;
        max-width: 70rem;
        padding: 4rem 2rem;
    }

    /* color/font-family/font-weight come from MainLayout's global
       ".page-content :global(:is(h1..h6))" rule - only the parts that
       actually diverge from it need stating here. */
    /* 40px, easing down to 28px on a phone so long words don't overflow */
    .ast-diagram h2 {
        font-size: clamp(28px, 7vw, 40px);
        line-height: 1.2;
        margin: 0 0 2rem;
        text-align: center;
    }

    /* font-family/font-weight here diverge from the inherited body
       serif/400 (this is a bold Geist caption, not running text), so
       those stay. color matches the global ".page-content :global(p)"
       rule already. Extra .ast-diagram qualifier needed to out-specificity
       that same global rule for margin, which would otherwise un-center
       this. */
    .ast-diagram .diagram-caption {
        font-family: var(--font-geist);
        font-size: 24px;
        font-weight: 700;
        line-height: 1.4;
        margin: 0 auto 3rem;
        max-width: 28rem;
        text-align: center;
        width: fit-content;
    }

    .diagram-body {
        align-items: stretch;
        display: grid;
        gap: 2rem;
        /* Equal side columns whatever the chambers' text needs, so the chip stays centred */
        grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    }

    .diagram-col {
        display: flex;
        flex-direction: column;
        gap: 0rem;
        margin-left: 4rem;
        margin-right: 4rem;
    }

    /* grid-row pinned, since chamber B's column comes last in the markup
       and would otherwise be auto-placed on a new row */
    .diagram-col--right {
        grid-column: 3;
        grid-row: 1;
        justify-content: flex-start;
    }

    /* Chamber B sits beside the chip's outlets, at the bottom of the left side */
    .diagram-col--left {
        grid-column: 1;
        grid-row: 1;
        justify-content: flex-end;
        text-align: right;
    }

    /* Real <h3>s - color/font-family/font-weight come from the global
       rule; the home page's labels are 24px rather than the global 20px. */
    .diagram-col h3,
    .chamber h3 {
        font-size: 24px;
        margin: 0 0 0.5rem;
    }

    /* Real <p>s - color/font-family/line-height come from MainLayout's
       global type scale; home page body text is 20px rather than 16px, and
       global p's 1em bottom margin is dropped. */
    .diagram-col p,
    .chamber p {
        font-size: 20px;
        margin: 0;
    }

    /* Toggle wrapping each label + its always-visible description; the
       bubble art behind them is decorative only and stays hidden until the
       chamber is on - clicked on (aria-pressed), or hovered (is-hovered, set
       by the script for a mouse only). */
    .info-trigger {
        cursor: pointer;
        position: relative;
    }

    .info-trigger:focus-visible {
        outline: 2px solid var(--color-cornflower);
        outline-offset: 2px;
    }

    /* The on states already out-specificity MainLayout's global h3/p color
       rule on their own (an attribute or class counts like a class), no
       extra qualifier needed here. */
    .info-trigger h3,
    .info-trigger p {
        position: relative;
        transition: color 0.15s ease;
        z-index: 1;
    }

    .info-trigger:is(.is-hovered, [aria-pressed="true"]) h3,
    .info-trigger:is(.is-hovered, [aria-pressed="true"]) p {
        color: var(--color-ebony-clay);
    }

    /* Wraps the label and description with a margin on every side, so it
       fits whatever width the column gives the text */
    .info-bubble-art {
        border-radius: 20px;
        inset: -1rem -1.25rem;
        opacity: 0;
        pointer-events: none;
        position: absolute;
        transition: opacity 0.15s ease;
        z-index: 0;
    }

    /* The gradients of the old a_blurb.svg and b_blurb.svg */
    .info-trigger--chamber-a .info-bubble-art {
        background: linear-gradient(120deg, #bbd1ff, var(--color-cornflower));
    }

    .info-trigger--chamber-b .info-bubble-art {
        background: linear-gradient(135deg, #bbd1ff, #e650db);
    }

    .info-trigger:is(.is-hovered, [aria-pressed="true"]) .info-bubble-art {
        opacity: 1;
    }

    /* In the bubble's bottom-right corner rather than HoverHint's own, which
       would sit on the text: the bubble spills past the text (inset above) */
    .info-trigger :global(.chamber-hint) {
        bottom: -0.5rem;
        right: -0.75rem;
    }

    /* Chamber B's on its outer (left) side instead, mirrored to point in
       from there - scaleX first, so its lean mirrors too */
    .info-trigger--chamber-b :global(.chamber-hint) {
        left: -0.75rem;
        right: auto;
        transform: scaleX(-1) rotate(-15deg);
    }

    /* The chip-prototype images are 512x1293 (tall/narrow) - width-driven,
       height auto so they keep that aspect ratio. */
    /* Kept in the middle column, between chamber B's label and chamber A's */
    .chip-visual {
        grid-column: 2;
        grid-row: 1;
        position: relative;
        width: min(16rem, 30vw);
    }

    .chip-visual img {
        display: block;
        height: auto;
        /* Opt out of the .page-content img size caps */
        max-height: none;
        max-width: none;
        transition: opacity 0.15s ease;
        width: 100%;
    }

    /* Laid exactly over the blank - all are exported from the same frame -
       which alone sets the box's size, so hovering never shifts the layout.
       The blank itself never fades, so swapping one for another doesn't
       flash the background through. */
    .chip-visual .chip-highlight {
        left: 0;
        opacity: 0;
        position: absolute;
        top: 0;
    }

    /* a or b for one chamber on, ab for both */
    .diagram-body:has(.info-trigger--chamber-a:is(.is-hovered, [aria-pressed="true"])):not(
            :has(.info-trigger--chamber-b:is(.is-hovered, [aria-pressed="true"]))
        )
        .chip-highlight--a,
    .diagram-body:has(.info-trigger--chamber-b:is(.is-hovered, [aria-pressed="true"])):not(
            :has(.info-trigger--chamber-a:is(.is-hovered, [aria-pressed="true"]))
        )
        .chip-highlight--b,
    .diagram-body:has(.info-trigger--chamber-a:is(.is-hovered, [aria-pressed="true"])):has(
            .info-trigger--chamber-b:is(.is-hovered, [aria-pressed="true"])
        )
        .chip-highlight--ab {
        opacity: 1;
    }

    .legend {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-top: 3rem;
        text-align: center;
    }

    /* color matches the global p rule already; font-family/font-weight
       diverge (bold Geist, not running serif body text) so those stay. */
    .legend p {
        font-family: var(--font-geist);
        font-size: 24px;
        font-weight: 700;
        margin: 0;
    }

    .legend mark {
        background-color: var(--color-fluorescence);
        color: var(--color-ebony-clay);
        padding: 0 0.3rem;
    }

    .legend mark.legend-resistant {
        background-color: var(--color-orchid);
    }

    /* Stacks and centres the chambers under the chip from ~3/4 of a
       typical laptop width, before the side column gets cramped */
    @media (max-width: 1100px) {
        .diagram-body {
            grid-template-columns: 1fr;
        }

        .diagram-col--right,
        .diagram-col--left {
            grid-column: auto;
            grid-row: auto;
            /* Centred and capped, so the text doesn't run the full width of a wide window */
            margin: 0 auto;
            max-width: 36rem;
            text-align: center;
        }

        /* Stacked full width, so the bubble can't spill past the column
           edges: pad the text instead and draw the bubble flush with that */
        .info-trigger {
            padding: 1rem 1.25rem;
        }

        .info-bubble-art {
            inset: 0;
        }

        /* Text padded inside the bubble now, so HoverHint's own corner is clear of it */
        .info-trigger :global(.chamber-hint) {
            bottom: 0.75rem;
            right: 0.75rem;
        }

        .info-trigger--chamber-b :global(.chamber-hint) {
            left: 0.75rem;
            right: auto;
        }

        .chip-visual {
            grid-column: auto;
            grid-row: auto;
            margin: 0 auto;
            /* Narrower cap than the desktop min() above - at 100% width
               this tall/narrow image would be very tall on a phone. */
            width: min(12rem, 60vw);
        }
    }
</style>
