---
import howItWorksChipSvg from "../assets/hero/how-it-works-chip.svg?raw";
import aBlurbSvg from "../assets/hero/a_blurb.svg?raw";
import bBlurbSvg from "../assets/hero/b_blurb.svg?raw";
import hydrogelBlurbSvg from "../assets/hero/hydrogel_blurb.svg?raw";
---

<section class="ast-diagram">
    <h2>How does microfluidics-based AST work?</h2>
    <p class="diagram-caption">Patient sample and antibiotic are loaded into chamber A</p>

    <div class="diagram-body">
        <div class="diagram-col diagram-col--left">
            <div class="info-trigger info-trigger--right info-trigger--hydrogel" tabindex="0">
                <div class="info-bubble-art" aria-hidden="true" set:html={hydrogelBlurbSvg} />
                <h3>Hydrogel channel</h3>
                <p>Allows antibiotics to diffuse slowly in 2 - 3 hours, while preventing cells from passing through</p>
            </div>
        </div>

        <div class="chip-visual" set:html={howItWorksChipSvg} />

        <div class="diagram-col diagram-col--right">
            <div class="chamber">
                <div class="info-trigger info-trigger--left info-trigger--chamber-a" tabindex="0">
                    <div class="info-bubble-art" aria-hidden="true" set:html={aBlurbSvg} />
                    <h3>Chamber A</h3>
                    <p>
                        Where patient sample and antibiotic interacts, and antibiotic degradation occurs within 1-4
                        hours
                    </p>
                </div>
            </div>
            <div class="chamber">
                <div class="info-trigger info-trigger--left info-trigger--chamber-b" tabindex="0">
                    <div class="info-bubble-art" aria-hidden="true" set:html={bBlurbSvg} />
                    <h3>Chamber B</h3>
                    <p>Biosensor E. coli interacts with intact/degraded antibiotic</p>
                </div>
            </div>
        </div>
    </div>

    <div class="legend">
        <p><mark class="legend-susceptible">Fluorescent output</mark> = sample is susceptible</p>
        <p>No fluorescence = sample is <mark class="legend-resistant">resistant</mark></p>
    </div>
</section>

<style>
    .ast-diagram {
        margin: 0 auto;
        max-width: 70rem;
        padding: 4rem 2rem;
    }

    /* color/font-family/font-weight come from MainLayout's global
       ".page-content :global(:is(h1..h6))" rule - only the parts that
       actually diverge from it need stating here. */
    .ast-diagram h2 {
        font-size: 36px;
        line-height: 1.2;
        margin: 0 0 2rem;
        text-align: center;
    }

    /* font-family/font-weight here diverge from the inherited body
       serif/400 (this is a bold Geist caption, not running text), so
       those stay. color matches the global ".page-content :global(p)"
       rule already. Extra .ast-diagram qualifier needed to out-specificity
       that same global rule for margin, which would otherwise un-center
       this. */
    .ast-diagram .diagram-caption {
        font-family: var(--font-geist);
        font-size: 20px;
        font-weight: 700;
        line-height: 1.4;
        margin: 0 auto 3rem;
        max-width: 28rem;
        text-align: center;
        width: fit-content;
    }

    .diagram-body {
        align-items: stretch;
        display: grid;
        gap: 2rem;
        grid-template-columns: 1fr auto 1fr;
    }

    .diagram-col {
        display: flex;
        flex-direction: column;
        gap: 0rem;
        margin-left: 4rem;
        margin-right: 4rem;
    }

    .diagram-col--left {
        justify-content: center;
        text-align: right;
    }

    .diagram-col--right {
        justify-content: space-between;
    }

    /* Real <h3>s - color/font-family/font-weight AND font-size (global h3
       is 1.25rem = exactly 20px) all already match the global rule; only
       the margin actually needs overriding here. */
    .diagram-col h3,
    .chamber h3 {
        margin: 0 0 0.5rem;
    }

    /* Real <p>s - color/font-family/font-size/line-height all already
       match (or are inherited from) MainLayout's global type scale; only
       the margin needs overriding (global p has a 1em bottom margin). */
    .diagram-col p,
    .chamber p {
        margin: 0;
    }

    /* Hover/focus target wrapping each label + its always-visible
       description; the bubble art behind them is decorative only and
       stays hidden until hover/focus. */
    .info-trigger {
        cursor: default;
        position: relative;
    }

    .info-trigger:focus-visible {
        outline: 2px solid var(--color-cornflower);
        outline-offset: 2px;
    }

    /* :hover/:focus-within already out-specificity MainLayout's global
       h3/p color rule on their own (pseudo-classes count like a class),
       no extra qualifier needed here. */
    .info-trigger h3,
    .info-trigger p {
        position: relative;
        transition: color 0.15s ease;
        z-index: 1;
    }

    .info-trigger:hover h3,
    .info-trigger:hover p,
    .info-trigger:focus-within h3,
    .info-trigger:focus-within p {
        color: var(--color-ebony-clay);
    }

    .info-bubble-art {
        opacity: 0;
        pointer-events: none;
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        transition: opacity 0.15s ease;
        z-index: 0;
    }

    /* Each bubble's text content is a different length, so each gets its
       own width rather than sharing one. */
    .info-trigger--chamber-a .info-bubble-art {
        width: 25rem;
    }

    .info-trigger--hydrogel .info-bubble-art {
        width: 30rem;
    }

    .info-trigger--chamber-b .info-bubble-art {
        width: 20rem;
    }

    .info-trigger:hover .info-bubble-art,
    .info-trigger:focus-within .info-bubble-art {
        opacity: 1;
    }

    .info-bubble-art :global(svg) {
        display: block;
        height: auto;
        width: 100%;
    }

    /* Chamber A/B (right column) - tail points left, toward the chip
       rectangle to their left. */
    .info-trigger--left .info-bubble-art {
        right: -1.5rem;
    }

    /* shift chamber b to left*/
    .info-trigger--chamber-b .info-bubble-art {
        right: 1.5rem;
    }

    /* Hydrogel channel (left column) - tail points right, toward the chip
       rectangle to its right. */
    .info-trigger--right .info-bubble-art {
        left: -1.5rem;
    }

    /* how-it-works-chip.svg is 256x720 (tall/narrow) - width-driven, height
       auto so it keeps that aspect ratio instead of the old placeholder
       box's. */
    .chip-visual {
        width: min(16rem, 30vw);
    }

    .chip-visual :global(svg) {
        display: block;
        height: auto;
        width: 100%;
    }

    .legend {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-top: 3rem;
        text-align: center;
    }

    /* color matches the global p rule already; font-family/font-weight
       diverge (bold Geist, not running serif body text) so those stay. */
    .legend p {
        font-family: var(--font-geist);
        font-size: 20px;
        font-weight: 700;
        margin: 0;
    }

    .legend mark {
        background-color: var(--color-fluorescence);
        color: var(--color-ebony-clay);
        padding: 0 0.3rem;
    }

    .legend mark.legend-resistant {
        background-color: var(--color-orchid);
    }

    @media (max-width: 750px) {
        .diagram-body {
            grid-template-columns: 1fr;
        }

        .diagram-col--left,
        .diagram-col--right {
            gap: 1rem;
            margin: 0;
            text-align: center;
        }

        /* The bubble art is sized/offset (and its tail pointed) for the
           side-by-side layout, so once stacked it sits off-center. Swap it
           for a full-width card in the same periwinkle -> cornflower
           gradient as the bubble SVGs. */
        .info-bubble-art {
            display: none;
        }

        .info-trigger {
            border-radius: 1rem;
            padding: 1rem 1.25rem;
            transition: background-color 0.15s ease;
        }

        .info-trigger:hover,
        .info-trigger:focus-within {
            background: linear-gradient(var(--color-periwinkle), var(--color-cornflower));
        }

        .chip-visual {
            margin: 0 auto;
            /* Narrower cap than the desktop min() above - at 100% width
               this tall/narrow image would be very tall on a phone. */
            width: min(12rem, 60vw);
        }
    }
</style>
