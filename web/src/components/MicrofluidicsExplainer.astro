---
import { BASE_URL } from "../utils/base-url";
---

<section class="ast-diagram">
    <h2>How does microfluidics-based AST work?</h2>
    <p class="diagram-caption">Patient sample and antibiotic are loaded into chamber A</p>

    <div class="diagram-body">
        <div class="chip-visual">
            <img src={`${BASE_URL}assets/hero/how-it-works-chip.svg`} alt="" width="256" height="720" loading="lazy" />
        </div>

        <div class="diagram-col diagram-col--right">
            <div class="chamber">
                <div class="info-trigger info-trigger--left info-trigger--chamber-a" tabindex="0">
                    <div class="info-bubble-art" aria-hidden="true"></div>
                    <h3>Chamber A</h3>
                    <p>
                        Where patient sample and antibiotic interacts, and antibiotic degradation occurs within 1-4
                        hours
                    </p>
                </div>
            </div>
            <div class="chamber">
                <div class="info-trigger info-trigger--left info-trigger--chamber-b" tabindex="0">
                    <div class="info-bubble-art" aria-hidden="true"></div>
                    <h3>Chamber B</h3>
                    <p>Biosensor E. coli interacts with intact/degraded antibiotic</p>
                </div>
            </div>
        </div>
    </div>

    <div class="legend">
        <p><mark class="legend-susceptible">Fluorescent output</mark> = sample is susceptible</p>
        <p>No fluorescence = sample is <mark class="legend-resistant">resistant</mark></p>
    </div>
</section>

<style>
    .ast-diagram {
        margin: 0 auto;
        max-width: 70rem;
        padding: 4rem 2rem;
    }

    /* color/font-family/font-weight come from MainLayout's global
       ".page-content :global(:is(h1..h6))" rule - only the parts that
       actually diverge from it need stating here. */
    /* 40px, easing down to 28px on a phone so long words don't overflow */
    .ast-diagram h2 {
        font-size: clamp(28px, 7vw, 40px);
        line-height: 1.2;
        margin: 0 0 2rem;
        text-align: center;
    }

    /* font-family/font-weight here diverge from the inherited body
       serif/400 (this is a bold Geist caption, not running text), so
       those stay. color matches the global ".page-content :global(p)"
       rule already. Extra .ast-diagram qualifier needed to out-specificity
       that same global rule for margin, which would otherwise un-center
       this. */
    .ast-diagram .diagram-caption {
        font-family: var(--font-geist);
        font-size: 24px;
        font-weight: 700;
        line-height: 1.4;
        margin: 0 auto 3rem;
        max-width: 28rem;
        text-align: center;
        width: fit-content;
    }

    .diagram-body {
        align-items: stretch;
        display: grid;
        gap: 2rem;
        /* Equal side columns whatever the chambers' text needs, so the chip stays centred */
        grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    }

    .diagram-col {
        display: flex;
        flex-direction: column;
        gap: 0rem;
        margin-left: 4rem;
        margin-right: 4rem;
    }

    .diagram-col--right {
        grid-column: 3;
        justify-content: space-between;
    }

    /* Real <h3>s - color/font-family/font-weight come from the global
       rule; the home page's labels are 24px rather than the global 20px. */
    .diagram-col h3,
    .chamber h3 {
        font-size: 24px;
        margin: 0 0 0.5rem;
    }

    /* Real <p>s - color/font-family/line-height come from MainLayout's
       global type scale; home page body text is 20px rather than 16px, and
       global p's 1em bottom margin is dropped. */
    .diagram-col p,
    .chamber p {
        font-size: 20px;
        margin: 0;
    }

    /* Hover/focus target wrapping each label + its always-visible
       description; the bubble art behind them is decorative only and
       stays hidden until hover/focus. */
    .info-trigger {
        cursor: default;
        position: relative;
    }

    .info-trigger:focus-visible {
        outline: 2px solid var(--color-cornflower);
        outline-offset: 2px;
    }

    /* :hover/:focus-within already out-specificity MainLayout's global
       h3/p color rule on their own (pseudo-classes count like a class),
       no extra qualifier needed here. */
    .info-trigger h3,
    .info-trigger p {
        position: relative;
        transition: color 0.15s ease;
        z-index: 1;
    }

    .info-trigger:hover h3,
    .info-trigger:hover p,
    .info-trigger:focus-within h3,
    .info-trigger:focus-within p {
        color: var(--color-ebony-clay);
    }

    /* Wraps the label and description with a margin on every side, so it
       fits whatever width the column gives the text */
    .info-bubble-art {
        border-radius: 20px;
        inset: -1rem -1.25rem;
        opacity: 0;
        pointer-events: none;
        position: absolute;
        transition: opacity 0.15s ease;
        z-index: 0;
    }

    /* The gradients of the old a_blurb.svg and b_blurb.svg */
    .info-trigger--chamber-a .info-bubble-art {
        background: linear-gradient(120deg, #bbd1ff, var(--color-cornflower));
    }

    .info-trigger--chamber-b .info-bubble-art {
        background: linear-gradient(135deg, #bbd1ff, #e650db);
    }

    .info-trigger:hover .info-bubble-art,
    .info-trigger:focus-within .info-bubble-art {
        opacity: 1;
    }

    /* how-it-works-chip.svg is 256x720 (tall/narrow) - width-driven, height
       auto so it keeps that aspect ratio instead of the old placeholder
       box's. */
    /* Kept in the middle column, with the chambers' labels to its right */
    .chip-visual {
        grid-column: 2;
        width: min(16rem, 30vw);
    }

    /* Flipped upside down to match the descriptions */
    .chip-visual img {
        display: block;
        height: auto;
        /* Opt out of the .page-content img size caps */
        max-height: none;
        max-width: none;
        transform: scaleY(-1);
        width: 100%;
    }

    .legend {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-top: 3rem;
        text-align: center;
    }

    /* color matches the global p rule already; font-family/font-weight
       diverge (bold Geist, not running serif body text) so those stay. */
    .legend p {
        font-family: var(--font-geist);
        font-size: 24px;
        font-weight: 700;
        margin: 0;
    }

    .legend mark {
        background-color: var(--color-fluorescence);
        color: var(--color-ebony-clay);
        padding: 0 0.3rem;
    }

    .legend mark.legend-resistant {
        background-color: var(--color-orchid);
    }

    /* Stacks and centres the chambers under the chip from ~3/4 of a
       typical laptop width, before the side column gets cramped */
    @media (max-width: 1100px) {
        .diagram-body {
            grid-template-columns: 1fr;
        }

        .diagram-col--right {
            gap: 1rem;
            grid-column: auto;
            /* Centred and capped, so the text doesn't run the full width of a wide window */
            margin: 0 auto;
            max-width: 36rem;
            text-align: center;
        }

        /* Stacked full width, so the bubble can't spill past the column
           edges: pad the text instead and draw the bubble flush with that */
        .info-trigger {
            padding: 1rem 1.25rem;
        }

        .info-bubble-art {
            inset: 0;
        }

        .chip-visual {
            grid-column: auto;
            margin: 0 auto;
            /* Narrower cap than the desktop min() above - at 100% width
               this tall/narrow image would be very tall on a phone. */
            width: min(12rem, 60vw);
        }
    }
</style>
