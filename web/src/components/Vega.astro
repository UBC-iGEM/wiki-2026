---
import { type VegaAttrs, VEGA_SLOTS } from "@exporter/markdown/components";
import HoverHint from "./HoverHint.astro";
type Props = VegaAttrs;

const { code } = Astro.props;
VEGA_SLOTS satisfies readonly [];

// `<` is escaped so a string in the spec can't close the script tag.
const data = code.replaceAll("<", "\\u003c");
// Only a chart with tooltips or selections has anything to hover over
const interactive = /"(tooltip|params|selection|signals)"\s*:/.test(code);
---

<figure class="vega glow-panel">
    <div class="glow-panel-body">
        <div class="vega-stage">
            <div class="vega-host"></div>
            {interactive && <HoverHint tone="dark" />}
        </div>
        <script type="application/json" class="vega-data" is:inline set:html={data} />
    </div>
</figure>

<script>
    import embed from "vega-embed";

    for (const vega of document.querySelectorAll<HTMLElement>(".vega")) {
        const spec = JSON.parse(vega.querySelector(".vega-data")!.textContent!);
        const host = vega.querySelector<HTMLElement>(".vega-host")!;
        embed(host, spec, {
            renderer: "svg",
            // No export menu, which links out to the online Vega editor
            actions: false,
            // Styled below to match the citation popups and tables
            tooltip: { disableDefaultStyle: true },
        }).catch((error: unknown) => {
            console.error("Vega chart could not be rendered:", error);
            host.textContent = "This chart could not be displayed.";
        });
    }
</script>

<!-- Global, as the chart is created by Vega and doesn't carry Astro's scoping attribute -->
<style is:global>
    /* The border and glow come from .glow-panel in style.css; the bottom margin clears the outline hanging below */
    .vega {
        margin: 2rem 0 3rem;
    }

    .vega .glow-panel-body {
        padding: 1.5rem 2.5rem;
    }

    /* Anchors the HoverHint, outside the host as Vega replaces what's in it */
    .vega .vega-stage {
        position: relative;
    }

    /* Vega draws dark text by default, so the chart sits on a light card */
    .vega .vega-host {
        background: #fff;
        border-radius: 22px;
        color: #000;
        display: flex;
        justify-content: center;
        overflow-x: auto;
        padding: 1rem;
    }

    .vega .vega-host svg {
        max-width: 100%;
        height: auto;
    }

    /* Vega's one tooltip for the page, laid out as the citation popup with the hovered fields as a table */
    #vg-tooltip-element {
        background: var(--color-ebony-clay-raised);
        border: 1px solid var(--color-cornflower);
        border-radius: 8px;
        box-shadow: 0 0 1.5rem color-mix(in srgb, var(--color-cornflower) 35%, transparent);
        color: var(--color-periwinkle);
        font-family: var(--font-source-serif-4);
        font-size: 0.875rem;
        line-height: 1.45;
        max-width: min(28rem, calc(100vw - 16px));
        padding: 0.6rem 0.8rem;
        pointer-events: none;
        position: fixed;
        visibility: hidden;
        white-space: pre-line;
        z-index: 20;
    }

    #vg-tooltip-element.visible {
        visibility: visible;
    }

    #vg-tooltip-element h2 {
        font-family: var(--font-geist);
        font-size: 0.9375rem;
        margin: 0 0 0.5rem;
    }

    /* The global table style, tightened to fit */
    #vg-tooltip-element table {
        font-size: inherit;
        margin: 0;
    }

    #vg-tooltip-element td {
        overflow-wrap: anywhere;
        padding: 0.3rem 0.6rem;
    }

    /* Field names read as the table's header column */
    #vg-tooltip-element td.key {
        background-color: var(--color-ebony-clay-raised);
        font-family: var(--font-geist);
        font-weight: 700;
        white-space: nowrap;
    }

    #vg-tooltip-element td.value {
        max-width: 18rem;
    }

    @media (max-width: 700px) {
        .vega .glow-panel-body {
            padding: 1rem 1.25rem;
        }

        .vega .vega-host {
            border-radius: 14px;
        }
    }
</style>
