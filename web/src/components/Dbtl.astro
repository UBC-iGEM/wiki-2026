---
import { DBTL_SLOTS } from "@exporter/markdown/components";
import DesignIcon from "../../public/assets/dbtl/design.svg";
import BuildIcon from "../../public/assets/dbtl/build.svg";
import TestIcon from "../../public/assets/dbtl/test.svg";
import LearnIcon from "../../public/assets/dbtl/learn.svg";

DBTL_SLOTS satisfies readonly ["design", "build", "test", "learn"];
---

<div class="dbtl">
    <section class="step design">
        <DesignIcon class="icon" aria-hidden="true" />
        <h3 class="title">Design</h3>
        <div class="card"><slot name="design" /></div>
    </section>
    <section class="step build">
        <BuildIcon class="icon" aria-hidden="true" />
        <h3 class="title">Build</h3>
        <div class="card"><slot name="build" /></div>
    </section>
    <section class="step test">
        <TestIcon class="icon" aria-hidden="true" />
        <h3 class="title">Test</h3>
        <div class="card"><slot name="test" /></div>
    </section>
    <section class="step learn">
        <LearnIcon class="icon" aria-hidden="true" />
        <h3 class="title">Learn</h3>
        <div class="card"><slot name="learn" /></div>
    </section>
</div>

<style>
    /* Sizes are in rem so the icons scale with the text under zoom; the container query only picks the layout */
    .dbtl {
        container-type: inline-size;
        margin: 2.5rem 0;
    }

    .step {
        padding-left: 12.25rem;
        position: relative;
    }

    .step + .step {
        margin-top: 3rem;
    }

    /* Each icon sits behind the left edge of its card */
    .icon {
        height: auto;
        left: var(--icon-left);
        position: absolute;
        top: var(--icon-top);
        width: var(--icon-width);
    }

    /* Each card's gradient is the part of the mock's gradient that falls on the card, as the mock's run past its edges */
    .design {
        --icon-left: 4rem;
        --icon-top: -0.95rem;
        --icon-width: 10.7rem;
        --card-bg: linear-gradient(219deg, #a15cf0, #e24fde 87%);
    }

    .build {
        --icon-left: 5.65rem;
        --icon-top: -0.15rem;
        --icon-width: 8.5rem;
        --card-bg: linear-gradient(90deg, #8e6cea, #5e7af2);
    }

    .test {
        --icon-left: 4.85rem;
        --icon-top: -0.5rem;
        --icon-width: 10rem;
        --card-bg: linear-gradient(84deg, #38b2c8, #77c1b4);
    }

    .learn {
        --icon-left: 5.6rem;
        --icon-top: -0.2rem;
        --icon-width: 7.8rem;
        --card-bg: linear-gradient(103deg, #ced245, #c9fc3a);
    }

    .step .title {
        font-family: var(--font-geist);
        font-size: 2rem;
        font-weight: 700;
        letter-spacing: 0.01em;
        line-height: 1;
        margin: 0 0 0.6rem;
        padding-right: 0.5rem;
        position: relative;
        text-align: right;
        text-transform: uppercase;
    }

    .card {
        background: var(--card-bg);
        border-radius: 12px;
        color: var(--color-ebony-clay);
        padding: 2rem 2.5rem;
        position: relative;
    }

    /* The card supplies its own padding, so the outermost children drop theirs */
    .card > :global(*:first-child) {
        margin-top: 0;
    }

    .card > :global(*:last-child) {
        margin-bottom: 0;
    }

    /*
     * Glow panels (figures, callouts, Colab, Downloadable and co.) keep their dark background, but their glowing outline and
     * the one stacked behind clash with the card.
     */
    .card :global(.glow-panel::before) {
        display: none;
    }

    .card :global(.glow-panel-body) {
        border: none;
        box-shadow: none;
    }

    /*
     * All text is the page's background colour, outranking the page's own colours (`.page-content a` and co.).
     * Anything on its own dark surface keeps its colours: table header cells, glow panels (callouts, figures, Colab, plate maps,
     * charts), database dropdowns, IHP carousels and the image lightbox.
     */
    .step
        .card
        :global(
            :not(
                th,
                th *,
                .glow-panel-body,
                .glow-panel-body *,
                .db-dropdown,
                .db-dropdown *,
                .ihp,
                .ihp *,
                .lightbox,
                .lightbox *
            )
        ) {
        color: inherit;
        text-decoration-color: currentColor;
    }

    /* Too narrow to give the icons a column of their own: they sit above the card, beside the title */
    @container (max-width: 40rem) {
        .step {
            padding-left: 0;
        }

        .icon {
            left: 0;
            top: -0.5rem;
            width: calc(var(--icon-width) * 0.45);
        }

        .card {
            padding: 1.25rem 1.5rem;
        }
    }
</style>
