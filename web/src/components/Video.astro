---
import { type VideoAttrs, VIDEO_SLOTS } from "@exporter/markdown/components";
type Props = VideoAttrs;

const { uuid, aspect_ratio } = Astro.props;
VIDEO_SLOTS satisfies readonly [];

// Without Video Universe's title bar and link out, as the wiki gives its own frame.
// The player draws its own preview and play button, and its own notice for a video still awaiting approval.
const embed = `https://video.igem.org/videos/embed/${uuid}?title=0&warningTitle=0&peertubeLink=0`;
---

<figure class="video glow-panel">
    <div class="video-body glow-panel-body">
        <iframe
            class="video-player"
            src={embed}
            title="Video player"
            loading="lazy"
            allow="fullscreen; picture-in-picture"
            allowfullscreen
            sandbox="allow-same-origin allow-scripts allow-popups allow-forms"
            style={`--ratio: ${aspect_ratio}`}></iframe>
    </div>
</figure>

<style>
    /* The border and glow come from .glow-panel in style.css; the bottom margin clears the outline hanging below */
    .video {
        margin: 2rem auto 3rem;
        max-width: 48rem;
    }

    .video-body {
        padding: 0.75rem;
    }

    .video-player {
        aspect-ratio: var(--ratio);
        background: var(--color-ebony-clay);
        border: none;
        border-radius: 22px;
        display: block;
        margin: 0 auto;
        /* A tall video stays within the screen, narrowing to keep its shape */
        width: min(100%, 80vh * var(--ratio));
    }

    @media (max-width: 700px) {
        .video-body {
            padding: 0.5rem;
        }

        .video-player {
            border-radius: 14px;
        }
    }
</style>
