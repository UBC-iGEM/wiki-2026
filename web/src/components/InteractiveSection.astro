---
import chip_interactive_left from "../assets/hero_interactive/chip_interactive_left.svg?raw";
import chip_interactive_right from "../assets/hero_interactive/chip_interactive_right.svg?raw";
import green_tube from "../assets/hero_interactive/green_tube.svg?raw";
import pink_tube from "../assets/hero_interactive/pink_tube.svg?raw";
---

<section class="interactive-section">
    <div class="case-row">
        <div class="case">
            <h3 class="case-heading">Case 1<br />Susceptible</h3>
            <div class="chip-visual" set:html={chip_interactive_left} />
        </div>

        <button class="tube-visual tube-visual--green" type="button" aria-label="Run test on Case 1 sample" set:html={green_tube} />

        <h4 class="prompt-text">Click on patient samples to conduct the test</h4>

        <button class="tube-visual tube-visual--pink" type="button" aria-label="Run test on Case 2 sample" set:html={pink_tube} />

        <div class="case">
            <h3 class="case-heading">Case 2<br />Resistant</h3>
            <div class="chip-visual" set:html={chip_interactive_right} />
        </div>
    </div>
</section>

<script>
    const susceptibleTube = document.querySelector<HTMLButtonElement>(".tube-visual--green");
    const resistantTube = document.querySelector<HTMLButtonElement>(".tube-visual--pink");

    // TEMP: placeholder handlers - real GSAP timelines go here once we know
    // what each case's animation should actually do.
    susceptibleTube?.addEventListener("click", () => {
        console.log("Case 1 (Susceptible) tube clicked");
    });

    resistantTube?.addEventListener("click", () => {
        console.log("Case 2 (Resistant) tube clicked");
    });
</script>

<style>
    .interactive-section {
        padding: 4rem 2rem;
    }

    .case-row {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: 2rem 3rem;
        justify-content: center;
        margin: 0 auto;
        max-width: 90rem;
    }

    .case {
        align-items: center;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .case-heading {
        line-height: 1.3;
        text-align: center;
    }

    .prompt-text {
        max-width: 14rem;
        text-align: center;
    }

    .chip-visual {
        width: 14.5rem;
    }

    .tube-visual {
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
        width: 2.75rem;
    }

    .chip-visual :global(svg),
    .tube-visual :global(svg) {
        display: block;
        height: auto;
        width: 100%;
    }
</style>
