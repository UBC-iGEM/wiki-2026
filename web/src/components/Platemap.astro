---
import { type PlatemapAttrs, PLATEMAP_SLOTS, PLATEMAP_PALETTE_SIZE } from "@exporter/markdown/components";
import HoverHint from "./HoverHint.astro";
type Props = PlatemapAttrs;

const { categories, plates } = Astro.props;
PLATEMAP_SLOTS satisfies readonly ["title", "names"];

// The script fetches each plate's CSV when it is first shown; until then the first plate is laid out as empty wells
const first = plates[0]!;

// `<` is escaped so a name can't close the script tag.
const data = JSON.stringify({ categories, plates }).replaceAll("<", "\\u003c");

// Bright enough to read against the dark panel; categories take them in order of first appearance.
// Each is a `.g<n>` class below.
const PALETTE_SIZE = 12;
PALETTE_SIZE satisfies typeof PLATEMAP_PALETTE_SIZE;
---

<div class="platemap glow-panel">
    <div class="panel glow-panel-body">
        <slot name="title" />

        <figure class="plate">
            <figcaption class="plate-header">
                <span class="plate-names" aria-live="polite"><slot name="names" /></span>
                {
                    plates.length > 1 && (
                        <span class="plate-nav">
                            <button class="arrow prev" aria-label="Previous plate">
                                <span class="marker" aria-hidden="true" />
                            </button>
                            <span class="plate-count">1 / {plates.length}</span>
                            <button class="arrow next" aria-label="Next plate">
                                <span class="marker" aria-hidden="true" />
                            </button>
                        </span>
                    )
                }
            </figcaption>
            <div class="grid-scroll">
                <!-- Must match `drawLoading` in the script -->
                <div class="grid" style={`--columns: ${first.columns}`} aria-busy="true">
                    {Array.from({ length: first.rows * first.columns }, () => <span class="well loading" />)}
                </div>
            </div>
            <HoverHint />
        </figure>

        <!-- Filled by `drawLegend` in the script -->
        <ul class="legend"></ul>

        <div class="tooltip" role="tooltip" hidden></div>
        <script type="application/json" class="platemap-data" is:inline set:html={data} />
    </div>
</div>

<script>
    import { onPage } from "../utils/page";
    import type { PlateSource } from "@exporter/markdown/components";
    import { type Plate, parsePlate, wellId } from "@exporter/platemap";

    const PALETTE_SIZE = 12;

    const span = (className: string, text = "") => {
        const el = document.createElement("span");
        el.className = className;
        el.textContent = text;
        return el;
    };

    /** Lay out `source` as wells waiting for its CSV, matching the server-rendered markup. */
    function drawLoading(grid: HTMLElement, source: PlateSource) {
        grid.style.setProperty("--columns", `${source.columns}`);
        grid.setAttribute("aria-busy", "true");
        grid.replaceChildren(...Array.from({ length: source.rows * source.columns }, () => span("well loading")));
    }

    /** Draw the wells of `plate`. */
    function drawGrid(grid: HTMLElement, plate: Plate) {
        const cells: HTMLElement[] = [];
        plate.rows.forEach((row, r) => {
            row.forEach((well, c) => {
                if (well === null) return cells.push(span("well empty"));
                const el = span(`well g${well.category % PALETTE_SIZE}`);
                el.style.setProperty("--fill", `${Math.round(well.brightness * 100)}%`);
                el.tabIndex = 0;
                el.setAttribute("role", "img");
                el.setAttribute("aria-label", `${wellId(r, c)}: ${well.label}`);
                el.dataset.r = `${r}`;
                el.dataset.c = `${c}`;
                cells.push(el);
            });
        });
        grid.style.setProperty("--columns", `${plate.columns}`);
        grid.removeAttribute("aria-busy");
        grid.replaceChildren(...cells);
    }

    /** Fill the legend with the categories on `plate`, or empty it while there is no plate to show. */
    function drawLegend(legend: HTMLElement, plate: Plate | undefined, categories: string[]) {
        // Categories share colours across plates, but each plate's legend lists only the categories on it
        const on = new Set(plate?.rows.flatMap((row) => row.flatMap((well) => (well ? [well.category] : []))));
        legend.replaceChildren(
            ...[...on]
                .sort((a, b) => a - b)
                .map((i) => {
                    const item = document.createElement("li");
                    item.append(span(`swatch g${i % PALETTE_SIZE}`), categories[i]!);
                    return item;
                }),
        );
    }

    onPage((signal) => {
        for (const platemap of document.querySelectorAll<HTMLElement>(".platemap")) {
            const { categories, plates: sources } = JSON.parse(
                platemap.querySelector(".platemap-data")!.textContent!,
            ) as { categories: string[]; plates: PlateSource[] };
            const grid = platemap.querySelector<HTMLElement>(".grid")!;
            const legend = platemap.querySelector<HTMLElement>(".legend")!;
            const names = platemap.querySelectorAll<HTMLElement>(".plate-name");
            const count = platemap.querySelector<HTMLElement>(".plate-count");
            const tooltip = platemap.querySelector<HTMLElement>(".tooltip")!;
            const n = sources.length;

            // Each plate is fetched once, the first time it (or a plate next to it) is shown. The exporter put every
            // category in `categories` already, so parsing a plate only looks its categories up.
            const fetches = new Map<number, Promise<Plate>>();
            const plates = new Map<number, Plate>();
            const fetchPlate = (index: number): Promise<Plate> => {
                let fetching = fetches.get(index);
                if (fetching) return fetching;

                const { name, url } = sources[index]!;
                fetching = fetch(url, { signal }).then(async (response) => {
                    if (!response.ok) throw new Error(`Could not fetch ${url} (${response.status})`);
                    const parsed = parsePlate(name, await response.text(), categories);
                    if (typeof parsed === "string") throw new Error(parsed);
                    plates.set(index, parsed.plate);
                    return parsed.plate;
                });
                // A failed fetch is tried again the next time the plate is shown
                fetching.catch(() => fetches.delete(index));
                fetches.set(index, fetching);
                return fetching;
            };

            let current = 0;
            const show = (index: number) => {
                current = (index + n) % n;
                const shown = current;
                names.forEach((name) => (name.hidden = Number(name.dataset.index) !== current));
                if (count) count.textContent = `${current + 1} / ${n}`;
                close();

                const plate = plates.get(current);
                if (plate) {
                    drawGrid(grid, plate);
                    drawLegend(legend, plate, categories);
                } else {
                    drawLoading(grid, sources[current]!);
                    drawLegend(legend, undefined, categories);
                    fetchPlate(current)
                        .then((plate) => {
                            if (current !== shown) return;
                            drawGrid(grid, plate);
                            drawLegend(legend, plate, categories);
                        })
                        .catch((error: unknown) => {
                            if (signal.aborted || current !== shown) return;
                            console.error("Plate could not be shown:", error);
                            grid.removeAttribute("aria-busy");
                            grid.replaceChildren(span("error", "This plate could not be displayed."));
                        });
                }

                // The plates either side are fetched ahead, so flicking through rarely waits
                if (n > 1) for (const next of [current + 1, current - 1]) fetchPlate((next + n) % n).catch(() => {});
            };
            platemap.querySelector(".arrow.prev")?.addEventListener("click", () => show(current - 1));
            platemap.querySelector(".arrow.next")?.addEventListener("click", () => show(current + 1));

            // One tooltip per platemap, fixed to the viewport so the scrolling grid can't clip it
            const open = (well: HTMLElement) => {
                const r = Number(well.dataset.r);
                const c = Number(well.dataset.c);
                const data = plates.get(current)?.rows[r]?.[c];
                if (!data) return;

                const heading = document.createElement("strong");
                heading.textContent = data.label || wellId(r, c);
                const detail = document.createElement("span");
                detail.textContent = `${wellId(r, c)} · ${categories[data.category]} · ${data.brightness.toFixed(2)}`;
                tooltip.replaceChildren(heading, detail);
                tooltip.hidden = false;

                const rect = well.getBoundingClientRect();
                const tip = tooltip.getBoundingClientRect();
                const left = Math.min(
                    Math.max(8, rect.left + rect.width / 2 - tip.width / 2),
                    innerWidth - tip.width - 8,
                );
                const above = rect.top - tip.height - 8;
                tooltip.style.left = `${left}px`;
                tooltip.style.top = `${above >= 8 ? above : rect.bottom + 8}px`;
            };
            const close = () => (tooltip.hidden = true);

            // Delegated, so redrawn wells need no listeners of their own
            const wellAt = (target: EventTarget | null) =>
                target instanceof Element ? target.closest<HTMLElement>(".well[data-r]") : null;
            grid.addEventListener("pointerover", (event) => {
                const well = wellAt(event.target);
                if (well) open(well);
                else close();
            });
            grid.addEventListener("pointerleave", close);
            grid.addEventListener("focusin", (event) => {
                const well = wellAt(event.target);
                if (well) open(well);
            });
            grid.addEventListener("focusout", close);
            addEventListener("scroll", close, { passive: true, signal });

            show(0);
            platemap.classList.add("js-ready");
        }
    });
</script>

<!-- Global, as wells redrawn by the script don't carry Astro's scoping attribute -->
<style is:global>
    /* Narrower than the page, leaving a 96-well plate some room either side at its largest wells */
    .platemap {
        margin: 2rem auto 3rem;
        max-width: 52rem;
    }

    .platemap .panel {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        padding: 1.5rem 2.5rem;
    }

    .platemap .title {
        font: var(--text-subtitle);
    }

    /* Anchors the HoverHint */
    .platemap .plate {
        margin: 0;
        position: relative;
    }

    /* Bold body text rather than the page's caption style; tripled up to outrank `.page-content figcaption` */
    .platemap .plate .plate-header {
        align-items: center;
        display: flex;
        font: var(--text-body);
        font-weight: 700;
        gap: 0.75rem;
        margin-bottom: 1rem;
    }

    .platemap .plate-names {
        flex: 1;
        font-weight: 700;
    }

    /* A steady width, so the arrows don't shift as the count goes from 9 to 10 */
    .platemap .plate-count {
        font-size: 0.85rem;
        font-variant-numeric: tabular-nums;
        min-width: 5.5ch;
        opacity: 0.7;
        text-align: center;
    }

    /* Hidden until the script can make them work */
    .platemap .arrow {
        align-items: center;
        background: none;
        border: 1px solid var(--color-cornflower);
        border-radius: 50%;
        cursor: var(--cursor-interact);
        --cursor-over-text: var(--cursor-interact);
        display: none;
        flex-shrink: 0;
        height: 2rem;
        justify-content: center;
        padding: 0;
        transition: background 120ms ease;
        width: 2rem;
    }

    .platemap.js-ready .arrow {
        display: flex;
    }

    /* The arrows sit either side of the count */
    .platemap .plate-nav {
        align-items: center;
        display: flex;
        flex-shrink: 0;
        gap: 0.5rem;
    }

    .platemap .arrow:hover {
        background: color-mix(in srgb, var(--color-cornflower) 35%, transparent);
    }

    .platemap .arrow:focus-visible {
        outline: 2px solid var(--color-lime-yellow);
        outline-offset: 3px;
    }

    /* A chevron pointing left or right */
    .platemap .marker {
        border-bottom: 2px solid var(--color-cornflower);
        border-right: 2px solid var(--color-cornflower);
        height: 0.45rem;
        width: 0.45rem;
    }

    .platemap .prev .marker {
        margin-left: 0.15rem;
        transform: rotate(135deg);
    }

    .platemap .next .marker {
        margin-right: 0.15rem;
        transform: rotate(-45deg);
    }

    .platemap .grid-scroll {
        overflow-x: auto;
        padding: 2px;
    }

    .platemap .grid {
        align-items: center;
        display: grid;
        gap: 0.35rem;
        grid-template-columns: repeat(var(--columns), minmax(0.9rem, 2.25rem));
        justify-content: center;
    }

    /* The category colour fills the well in proportion to its brightness */
    .platemap .well {
        aspect-ratio: 1;
        background: color-mix(in srgb, var(--category) var(--fill), var(--color-ebony-clay));
        border: 1.5px solid var(--category);
        border-radius: 50%;
        transition: transform 100ms ease;
    }

    .platemap .well[data-r]:is(:hover, :focus-visible) {
        outline: 2px solid var(--color-periwinkle);
        outline-offset: 2px;
        transform: scale(1.12);
    }

    .platemap .well.empty {
        background: none;
        border: 1px dashed color-mix(in srgb, var(--color-periwinkle) 30%, transparent);
    }

    /* Wells whose plate is still being fetched */
    .platemap .well.loading {
        animation: platemap-loading 1.2s ease-in-out infinite alternate;
        background: color-mix(in srgb, var(--color-periwinkle) 8%, transparent);
        border: 1px solid color-mix(in srgb, var(--color-periwinkle) 20%, transparent);
    }

    @keyframes platemap-loading {
        to {
            opacity: 0.4;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .platemap .well.loading {
            animation: none;
        }
    }

    .platemap .grid .error {
        grid-column: 1 / -1;
        padding: 2rem 0;
        text-align: center;
    }

    .platemap .g0 {
        --category: var(--color-lime-yellow);
    }
    .platemap .g1 {
        --category: var(--color-orchid);
    }
    .platemap .g2 {
        --category: var(--color-fluorescence);
    }
    .platemap .g3 {
        --category: var(--color-northern-lights);
    }
    .platemap .g4 {
        --category: var(--color-citrine);
    }
    .platemap .g5 {
        --category: var(--color-cornflower);
    }
    .platemap .g6 {
        --category: #ff8a5c;
    }
    .platemap .g7 {
        --category: #ff5c8a;
    }
    .platemap .g8 {
        --category: #b08cff;
    }
    .platemap .g9 {
        --category: #5cd6ff;
    }
    .platemap .g10 {
        --category: var(--color-grey-teal);
    }
    .platemap .g11 {
        --category: #f2f2f2;
    }

    .platemap .legend {
        display: flex;
        flex-wrap: wrap;
        font-size: 0.85rem;
        gap: 0.5rem 1.25rem;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .platemap .legend li {
        align-items: center;
        display: flex;
        gap: 0.4rem;
        margin: 0;
    }

    .platemap .swatch {
        background: var(--category);
        border-radius: 50%;
        height: 0.8rem;
        width: 0.8rem;
    }

    .platemap .tooltip {
        background: var(--color-ebony-clay-raised);
        border: 1px solid var(--color-cornflower);
        border-radius: 8px;
        display: flex;
        flex-direction: column;
        font-size: 0.8rem;
        gap: 0.15rem;
        max-width: 18rem;
        padding: 0.4rem 0.7rem;
        pointer-events: none;
        position: fixed;
        z-index: 10;
    }

    .platemap .tooltip[hidden] {
        display: none;
    }

    .platemap .tooltip span {
        opacity: 0.75;
    }

    @media (max-width: 700px) {
        .platemap .panel {
            padding: 1rem 1.25rem;
        }
    }
</style>
