---
import { BASE_URL } from "../utils/base-url";

interface Sponsor {
    name: string;
    logo_url: string;
}

// Sponsors in display order.
const sponsors: Sponsor[] = [
    { name: "Life Sciences Institute", logo_url: `${BASE_URL}assets/sponsors/lsi.png` },
    { name: "Department of Zoology", logo_url: `${BASE_URL}assets/sponsors/ubc-zoology.png` },
    { name: "Faculty of Science", logo_url: `${BASE_URL}assets/sponsors/ubc-science.png` },
    {
        name: "Department of Microbiology and Immunology",
        logo_url: `${BASE_URL}assets/sponsors/ubc-mbim.png`,
    },
    {
        name: "School of Biomedical Engineering",
        logo_url: `${BASE_URL}assets/sponsors/ubc-sbme.png`,
    },
    { name: "Michael Smith Laboratories", logo_url: `${BASE_URL}assets/sponsors/msl.png` },
    { name: "SnapGene", logo_url: `${BASE_URL}assets/sponsors/snapgene.svg` },
];
---

<footer class="sponsor-footer">
    {
        sponsors.length > 0 && (
            <div class="sponsor-viewport" aria-label="Sponsors" role="region">
                <div class="sponsor-track">
                    {[false, true].map((duplicate) => (
                        <ul class="sponsor-group" aria-hidden={duplicate ? "true" : undefined}>
                            {sponsors.map((sponsor) => (
                                <li class="sponsor-item">
                                    <img
                                        src={sponsor.logo_url}
                                        alt={duplicate ? "" : sponsor.name}
                                        width="200"
                                        height="80"
                                    />
                                </li>
                            ))}
                        </ul>
                    ))}
                </div>
            </div>
        )
    }
    <div class="site-notice">
        <p>
            © 2026 - Content on this site is licensed under a
            <a href="https://gitlab.igem.org/2026/ubc-vancouver/-/blob/main/LICENSE" rel="license"
                >Creative Commons Attribution 4.0 International license</a
            >.
        </p>
        <p>
            The repository used to create this website is available at
            <a href="https://gitlab.igem.org/2026/ubc-vancouver">gitlab.igem.org/2026/ubc-vancouver</a>.
        </p>
    </div>
</footer>

<script>
    import { onPage } from "../utils/page";

    onPage(() => {
        document.querySelectorAll<HTMLElement>(".sponsor-footer").forEach((footer) => {
            footer.dataset.ready = "true";
        });
    });
</script>

<style>
    .sponsor-footer {
        --sponsor-gap: 2rem;
        background: var(--color-ebony-clay);
        color: var(--color-periwinkle);
        font-family: var(--font-geist), sans-serif;
        padding-bottom: 2.5rem;
    }

    .site-notice {
        font-size: 0.875rem;
        line-height: 1.6;
        padding: 2.5rem 1rem 0;
        text-align: center;
    }

    .site-notice p {
        margin: 0;
    }

    .site-notice p + p {
        margin-top: 0.75rem;
    }

    .site-notice a {
        color: inherit;
        overflow-wrap: anywhere;
    }

    .sponsor-viewport {
        border-block: 1px solid var(--color-northern-lights);
        container-type: inline-size;
        padding-block: 1.5rem;
        overflow: hidden;
    }

    .sponsor-track {
        display: flex;
        width: max-content;
    }

    .sponsor-group {
        align-items: center;
        box-sizing: border-box;
        display: flex;
        flex-shrink: 0;
        gap: var(--sponsor-gap);
        justify-content: space-around;
        list-style: none;
        margin: 0;
        min-width: 100cqw;
        padding: 0 var(--sponsor-gap) 0 0;
    }

    .sponsor-item {
        align-items: center;
        background: #f7f7f2;
        border-radius: 0.5rem;
        box-sizing: border-box;
        display: flex;
        flex: 0 0 224px;
        height: 104px;
        justify-content: center;
        padding: 12px;
        width: 224px;
    }

    img {
        box-sizing: border-box;
        display: block;
        height: 80px;
        object-fit: contain;
        width: 100%;
    }

    .sponsor-footer[data-ready] .sponsor-track {
        animation: sponsor-scroll 25s linear infinite;
    }

    .sponsor-viewport:hover .sponsor-track,
    .sponsor-viewport:focus-within .sponsor-track {
        animation-play-state: paused;
    }

    @keyframes sponsor-scroll {
        to {
            transform: translateX(-50%);
        }
    }

    /* Without JS, keep every sponsor visible and avoid unpausable motion. */
    .sponsor-footer:not([data-ready]) .sponsor-track {
        width: 100%;
    }

    .sponsor-footer:not([data-ready]) .sponsor-group {
        flex-wrap: wrap;
        min-width: 0;
        padding-inline: 1rem;
        width: 100%;
    }

    .sponsor-footer:not([data-ready]) .sponsor-group[aria-hidden="true"] {
        display: none;
    }

    @media (max-width: 600px) {
        .sponsor-footer {
            --sponsor-gap: 1rem;
        }

        .sponsor-item {
            flex-basis: 164px;
            height: 80px;
            width: 164px;
        }

        img {
            height: 56px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .sponsor-footer[data-ready] .sponsor-track {
            animation: none;
            width: 100%;
        }

        .sponsor-group {
            flex-wrap: wrap;
            min-width: 0;
            padding-inline: 1rem;
            width: 100%;
        }

        .sponsor-group[aria-hidden="true"] {
            display: none;
        }
    }
</style>
