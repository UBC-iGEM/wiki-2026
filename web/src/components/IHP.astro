---
import { type IHPAttrs, IHP_SLOTS } from "@exporter/markdown/components";
type Props = IHPAttrs;

IHP_SLOTS satisfies readonly ["people"];
---

<!-- The controls stay hidden unless the script finds more than one card -->
<div class="ihp">
    <div class="ihp-row">
        <button class="ihp-arrow nav-arrow prev" aria-label="Previous person"></button>
        <div class="ihp-stage">
            <!-- Cards arrive pre-built as `.ihp-card[data-index]` from the exporter -->
            <slot name="people" />
        </div>
        <button class="ihp-arrow nav-arrow next" aria-label="Next person"></button>
    </div>
    <div class="ihp-dots nav-dots"></div>
</div>

<script>
    // Fade the bottom of a description or a card's text while there is more below to scroll to,
    // and the top once it has been scrolled down
    const boxes = Array.from(document.querySelectorAll<HTMLElement>(".ihp-desc, .ihp-content"));
    const markBox = (box: HTMLElement) => {
        box.classList.toggle("overflowing", box.scrollHeight > box.scrollTop + box.clientHeight + 1);
        box.classList.toggle("scrolled", box.scrollTop > 1);
    };
    const markOverflow = () => boxes.forEach(markBox);
    markOverflow();
    addEventListener("resize", markOverflow, { passive: true });
    for (const box of boxes) box.addEventListener("scroll", () => markBox(box), { passive: true });

    for (const ihp of document.querySelectorAll<HTMLElement>(".ihp")) {
        const cards = Array.from(ihp.querySelectorAll<HTMLElement>(".ihp-card"));
        const n = cards.length;
        // One person needs no carousel
        if (n < 2) continue;

        // One dot per card, named after its person
        const dots = cards.map((card) => {
            const dot = document.createElement("button");
            dot.className = "nav-dot";
            dot.dataset.index = card.dataset.index;
            dot.setAttribute("aria-label", card.querySelector(".ihp-name")?.textContent ?? "");
            return dot;
        });
        ihp.querySelector(".ihp-dots")!.replaceChildren(...dots);

        let current = 0;
        const show = (index: number) => {
            current = (index + n) % n;
            for (const card of cards) {
                // Position relative to the current card, wrapping around
                const offset = (Number(card.dataset.index) - current + n) % n;
                const role = offset === 0 ? "active" : offset === 1 ? "next" : offset === n - 1 ? "prev" : "hidden";
                card.dataset.role = role;
                // Only the card in front can be read or tabbed into
                card.inert = role !== "active";
            }
            dots.forEach((dot) => dot.classList.toggle("active", Number(dot.dataset.index) === current));
            markOverflow();
        };

        ihp.querySelector(".ihp-arrow.prev")?.addEventListener("click", () => show(current - 1));
        ihp.querySelector(".ihp-arrow.next")?.addEventListener("click", () => show(current + 1));
        dots.forEach((dot) => dot.addEventListener("click", () => show(Number(dot.dataset.index))));
        // The peeking cards bring themselves to the front
        for (const card of cards)
            card.addEventListener("click", () => {
                if (card.dataset.role !== "active") show(Number(card.dataset.index));
            });

        // Until now the cards are listed one after another, as a no-JS fallback
        ihp.classList.add("js-ready");
        show(0);
    }
</script>

<!-- Global, as the cards arrive through a slot and don't carry Astro's scoping attribute -->
<style is:global>
    .ihp {
        --card-width: min(100%, 36rem);
        --photo-width: 9.5rem;
        --photo-height: 11rem;
        --card-pad-x: 2.25rem;
        margin: 2rem 0 3rem;
    }

    /* The arrows sit outside the cards, either side of them */
    .ihp-row {
        align-items: center;
        display: flex;
        position: relative;
    }

    /* No-JS fallback, and a single person: cards one after another */
    .ihp-stage {
        display: flex;
        flex: 1;
        flex-direction: column;
        gap: 3rem;
        min-width: 0;
        /* Room for each card's offset outline */
        padding: 0 1rem 1rem 0;
    }

    /* The carousel: every card in the same grid cell, so the stage is as tall as the tallest */
    /* Each card is as tall as its own content, so a short one has no empty space at its bottom */
    .ihp.js-ready .ihp-stage {
        align-items: start;
        display: grid;
        justify-items: center;
        overflow-x: clip;
        padding: 1rem 0 2rem;
    }

    .ihp.js-ready .ihp-card {
        grid-area: 1 / 1;
        transition:
            opacity 300ms ease,
            transform 300ms ease;
        width: var(--card-width);
    }

    .ihp-card[data-role="active"] {
        z-index: 2;
    }

    .ihp-card:is([data-role="prev"], [data-role="next"]) {
        cursor: pointer;
        opacity: 0.2;
        z-index: 1;
    }

    .ihp-card[data-role="prev"] {
        transform: translateX(-58%) scale(0.88);
    }

    .ihp-card[data-role="next"] {
        transform: translateX(58%) scale(0.88);
    }

    .ihp-card[data-role="hidden"] {
        opacity: 0;
        pointer-events: none;
        visibility: hidden;
    }

    /* The card */
    .ihp .ihp-card-body {
        background: color-mix(in srgb, var(--color-cornflower) 32%, var(--color-ebony-clay));
        padding: 2rem var(--card-pad-x);
    }

    .ihp-name {
        color: #f5f7ff;
        font-family: var(--font-geist);
        font-size: 1.85rem;
        font-weight: 700;
        line-height: 1.15;
        margin: 0;
        text-transform: uppercase;
    }

    .ihp-profile {
        display: flex;
        gap: 1.25rem;
        margin: 1.25rem 0 1.5rem;
    }

    /* Fixed size, cropped to fill; beats the page's general image sizing */
    .ihp .ihp-photo {
        border-radius: 14px;
        flex-shrink: 0;
        height: var(--photo-height);
        max-height: none;
        object-fit: cover;
        width: var(--photo-width);
    }

    /* As tall as the photo beside it, or fitted to its text without one; longer descriptions scroll */
    .ihp-desc {
        background: color-mix(in srgb, var(--color-cornflower) 60%, var(--color-ebony-clay));
        border: 1px solid color-mix(in srgb, var(--color-cornflower) 80%, white);
        border-radius: 18px;
        box-sizing: border-box;
        flex: 1;
        font: var(--text-caption);
        max-height: var(--photo-height);
        min-height: 5rem;
        min-width: 0;
        overflow-y: auto;
        padding: 1rem 1.25rem;
    }

    /* Each edge fades only while there is more to scroll to beyond it */
    .ihp :is(.ihp-desc, .ihp-content):is(.overflowing, .scrolled) {
        mask-image: linear-gradient(
            to bottom,
            transparent,
            black var(--fade-top, 0px),
            black calc(100% - var(--fade-bottom, 0px)),
            transparent
        );
    }

    .ihp :is(.ihp-desc, .ihp-content).scrolled {
        --fade-top: 2rem;
    }

    .ihp :is(.ihp-desc, .ihp-content).overflowing {
        --fade-bottom: 2rem;
    }

    .ihp-desc > :first-child,
    .ihp-content > :first-child {
        margin-top: 0;
    }

    .ihp-desc > :last-child,
    .ihp-content > :last-child {
        margin-bottom: 0;
    }

    .ihp-desc p {
        margin: 0 0 0.5em;
    }

    /* Capped, so one long interview doesn't make every card as tall; the rest scrolls */
    .ihp-content {
        font-size: 0.95rem;
        line-height: 1.55;
        max-height: 50vh;
        overflow-y: auto;
        /* Reaches into the card's right padding, so the scrollbar sits there rather than over the text */
        margin-right: calc(0.5rem - var(--card-pad-x));
        padding-right: calc(var(--card-pad-x) - 0.5rem);
        scrollbar-color: var(--color-cornflower) transparent;
        scrollbar-width: thin;
    }

    .ihp-content p {
        margin: 0 0 1em;
    }

    /* Only once there is more than one person; the look comes from .nav-arrow */
    /* Over the peeking neighbours, a short way out from the card in front */
    .ihp .ihp-arrow {
        display: none;
        position: absolute;
        top: calc(50% - 1.375rem);
        z-index: 3;
    }

    .ihp-arrow.prev {
        left: max(0px, calc(50% - var(--card-width) / 2 - 6rem));
    }

    .ihp-arrow.next {
        right: max(0px, calc(50% - var(--card-width) / 2 - 6.5rem));
    }

    .ihp.js-ready .ihp-arrow {
        display: block;
    }

    /* Clear of the cards' offset outline and glow */
    .ihp .ihp-dots {
        display: none;
        margin-top: 1.5rem;
    }

    .ihp.js-ready .ihp-dots {
        display: flex;
    }

    @media (prefers-reduced-motion: reduce) {
        .ihp.js-ready .ihp-card {
            transition: none;
        }
    }

    /* Too narrow for the neighbours to peek: one card */
    @media (max-width: 700px) {
        .ihp {
            --card-width: 100%;
            --photo-width: 7.5rem;
            --photo-height: 9rem;
            --card-pad-x: 1.25rem;
        }

        .ihp-row {
            gap: 0.5rem;
        }

        /* The card fills the stage here, so the arrows sit beside it instead */
        .ihp .ihp-arrow {
            position: static;
        }

        .ihp-card:is([data-role="prev"], [data-role="next"]) {
            opacity: 0;
            pointer-events: none;
            visibility: hidden;
        }

        .ihp .ihp-card-body {
            padding: 1.5rem var(--card-pad-x);
        }

        .ihp-name {
            font-size: 1.4rem;
        }

        .ihp-profile {
            flex-direction: column;
        }

        .ihp-desc {
            flex: none;
        }
    }
</style>
