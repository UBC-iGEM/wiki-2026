---
import { type IhpAttrs, IHP_SLOTS } from "@exporter/markdown/components-block";

type Props = IhpAttrs;

IHP_SLOTS satisfies readonly ["content"];

const { image, name, bio } = Astro.props;
---

<div class="ihp">
    <div class="ihp-profile">
        <div class="ihp-image">
            <img src={image.url} alt={image.alt} />
        </div>

        <div class="ihp-person">
            <h3>{name}</h3>
            <p>{bio}</p>
        </div>
    </div>

    <div class="ihp-interview">
        <slot name="content" />
    </div>
</div>

<style>
    .ihp {
        width: 100%;
    }

    .ihp-profile {
        display: flex;
        align-items: center;
        gap: 24px;
        margin-bottom: 24px;
    }

    .ihp-image {
        flex-shrink: 0;
        width: 160px;
        height: 160px;
        overflow: hidden;
        border-radius: 8px;
    }

    .ihp-image img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .ihp-person {
        flex: 1;
    }

    .ihp-person h3 {
        margin: 0 0 8px;
    }

    .ihp-person p {
        margin: 0;
    }

    .ihp-interview {
        width: 100%;
    }

    :global(.ihp-interview > :first-child) {
        margin-top: 0;
    }

    :global(.ihp-interview > :last-child) {
        margin-bottom: 0;
    }

    @media (max-width: 600px) {
        .ihp-profile {
            flex-direction: column;
            align-items: flex-start;
        }

        .ihp-image {
            width: 100%;
            height: auto;
            aspect-ratio: 1 / 1;
        }
    }
</style>
