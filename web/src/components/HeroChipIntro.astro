---
import chip1Svg from "../../public/assets/hero/home-page-chip-1.svg?raw";
import chip2Svg from "../../public/assets/hero/home-page-chip-2.svg?raw";
import connectorLineSvg from "../../public/assets/hero/home-start-line.svg?raw";
import fastTextFinalSvg from "../../public/assets/hero/FAST-text-final.svg?raw";
import dotSvg from "../../public/assets/hero/dot.svg?raw";
import traceSvg from "../../public/assets/home/trace.svg?raw";
import MicrofluidicsExplainer from "./MicrofluidicsExplainer.astro";
import InteractiveSection from "./InteractiveSection.astro";
import Video from "./Video.astro";
import { BASE_URL } from "../utils/base-url";

// Where a block sits in the 1280-wide design (public/assets/home/trace.svg's own coordinates): left, top and width
const at = (x: number, y: number, w: number): Record<string, number> => ({ "--x": x, "--y": y, "--w": w });

const illustration = (name: string): string => `${BASE_URL}assets/home/${name}.svg`;
const page = (path: string): string => `${BASE_URL}${path}`;

// Everything from the junction under the interactive test down sits this much lower than in the design, as the
// interactive test is taller than drawn there (trace.svg is shifted to match)
const LOWER_SHIFT = 300;
const below = (x: number, y: number, w: number): Record<string, number> => at(x, y + LOWER_SHIFT, w);

// Each caption's `linked` words link to where its number comes from
const stats = [
    {
        x: 166,
        number: "4.7 million",
        caption: "deaths globally in 2021 were associated with bacterial antimicrobial resistance",
        linked: "deaths globally in 2021",
        source: "https://www.who.int/news-room/fact-sheets/detail/antimicrobial-resistance",
    },
    {
        x: 529,
        number: "1 in 6",
        caption: "laboratory-confirmed bacterial infections worldwide were resistant to antibiotics in 2023",
        linked: "laboratory-confirmed bacterial infections",
        source: "https://www.who.int/news/item/13-10-2025-who-warns-of-widespread-resistance-to-common-antibiotics-worldwide",
    },
    {
        x: 883,
        number: "8.22 million",
        caption: "deaths globally by 2050 are predicted to be associated with bacterial antimicrobial resistance",
        linked: "deaths globally by 2050",
        source: "https://www.thelancet.com/journals/lancet/article/PIIS0140-6736(24)01867-1/fulltext",
    },
];
---

<div class="chip-stage">
    <div class="trace" aria-hidden="true" set:html={traceSvg} />
    <div class="motion-dot motion-dot--a" aria-hidden="true" set:html={dotSvg} />
    <div class="motion-dot motion-dot--b" aria-hidden="true" set:html={dotSvg} />
    <div class="motion-dot motion-dot--c" aria-hidden="true" set:html={dotSvg} />

    <div class="at chip-group" style={at(101, 154, 536)}>
        <div class="chip chip-1" set:html={chip1Svg} />
        <div class="chip chip-2" set:html={chip2Svg} />
        <img
            class="chip chip-3"
            src={`${BASE_URL}assets/hero/home-page-chip-3.svg`}
            alt=""
            width="536"
            height="525"
            fetchpriority="high"
        />
    </div>
    <div class="at connector-line" style={at(611.5, 277.5, 94)} set:html={connectorLineSvg} />
    <div
        class="at fast-text-final"
        style={at(671.7, 253.2, 548)}
        role="img"
        aria-label="FAST: Fluorescent Antibiotic Susceptibility Testing"
        set:html={fastTextFinalSvg}
    />

    <div class="at reveal home-intro" style={at(160, 1029, 960)}>
        <h2>When every second counts, guessing isn’t enough.</h2>
        <p>
            FAST sets a higher standard, bringing antibiotic susceptibility testing to the point of care, so the right
            drug reaches the patient sooner.
        </p>
    </div>

    <img
        class="at reveal home-art"
        style={at(160, 1170, 460)}
        src={illustration("bacteria")}
        alt=""
        width="460"
        height="340"
        loading="lazy"
    />
    <div class="at reveal home-copy" style={at(716, 1208, 420)}>
        <h3>The Rebel Bacteria</h3>
        <p>
            <strong>Antimicrobial resistance (AMR) is one of the fastest-growing threats to global health.</strong>
            Today, standard antibiotic susceptibility testing takes days and usually relies on non-clinical services, so clinicians
            often prescribe broad-spectrum antibiotics before they know what will work. Every unnecessary and ineffective
            prescription costs patients time and fuels resistance.
        </p>
    </div>

    {
        stats.map(({ x, number, caption, linked, source }, index) => (
            <>
                <div class:list={["at", "stat", `stat-${index + 1}`]} style={at(x, 1690, 210)}>
                    {number}
                </div>
                <p
                    class:list={["at", "stat-caption", `stat-${index + 1}`]}
                    style={at(x - 15, 1923, 240)}
                    set:html={caption.replace(
                        linked,
                        `<a href="${source}" target="_blank" rel="noopener noreferrer">${linked}</a>`,
                    )}
                />
            </>
        ))
    }

    <h2 class="at reveal home-heading" style={at(197, 2347, 940)}>
        Antibiotic susceptibility is how easily a given antibiotic can either stop a bacterium from growing or kill it.
    </h2>
    <img
        class="at reveal home-art"
        style={at(228, 2462, 256)}
        src={illustration("test-tubes")}
        alt=""
        width="256"
        height="252"
        loading="lazy"
    />
    <p class="at reveal home-copy home-copy--end" style={at(583, 2486, 540)}>
        It is measured by using <strong>antibiotic susceptibility testing (AST)</strong>. AST usually finds the lowest
        drug concentration that stops visible bacterial growth. The result places the bacteria into one of three
        categories: <strong>susceptible, intermediate, or resistant</strong>. This tells clinicians whether the drug is
        likely to work at a dose the patient can safely receive.
    </p>

    <h2 class="at reveal home-heading" style={at(183, 2970, 900)}>
        Susceptibility can change over time and antibiotic use favors bacteria that can survive it.
    </h2>
    <p class="at reveal home-copy" style={at(166, 3096, 290)}>
        Bacteria can become resistant through genetic mutations
    </p>
    <img
        class="at reveal home-art"
        style={at(712, 3104, 378)}
        src={illustration("dna")}
        alt=""
        width="378"
        height="58"
        loading="lazy"
    />
    <img
        class="at reveal home-art"
        style={at(188, 3208, 552)}
        src={illustration("gene-transfer")}
        alt=""
        width="552"
        height="232"
        loading="lazy"
    />
    <p class="at reveal home-copy home-copy--end" style={at(846, 3250, 265)}>
        and they also can pick up resistance genes from other bacteria, often on small mobile pieces of DNA called <strong
            >plasmids</strong
        >.
    </p>
    <p class="at reveal home-copy home-copy--centre" style={at(153, 3495, 960)}>
        These resistant strains survive the treatment and can spread, making it difficult to control. Every unnecessary
        or poorly targeted prescription therefore speeds up the resistance process, decreasing the number of effective
        drugs for that kind of bacteria. Faster, more widely available AST, with results ready before the prescription
        is written rather than days later, is key to both treating patients effectively and to slowing down
        antimicrobial resistance.
    </p>

    <div class="at reveal solution-copy" style={at(198, 3926, 300)}>
        <h2>Our Solution</h2>
        <p>
            We produced a point-of-care device that determines susceptibility of a patient sample to an antibiotic in
            illnesses such as urinary tract infections (UTIs) by detecting degradation of the antibiotic with
            microfluidics-based AST.
        </p>
    </div>
    <div class="at reveal solution-metric" style={at(567, 3871, 244)}>
        <img src={illustration("petri-dish")} alt="" width="244" height="244" loading="lazy" />
        <p class="solution-time">4 hours</p>
        <p class="solution-caption">Testing time using FAST</p>
    </div>
    <div class="at reveal solution-divider" style={at(869, 3827, 2)}></div>
    <div class="at reveal solution-metric" style={at(936, 3871, 244)}>
        <img src={illustration("clock")} alt="" width="244" height="244" loading="lazy" />
        <p class="solution-time">16 - 48 hrs</p>
        <p class="solution-caption">Testing time for traditional AST</p>
    </div>

    <div class="at reveal microfluidics-overlay" style={at(90, 4432, 1100)}>
        <MicrofluidicsExplainer />
    </div>

    <div class="at reveal home-copy outcome-blurb" style={at(142, 5757, 1010)}>
        <p>
            Using <a href={page("hardware/microfluidic-chip")}>microfluidic technology</a>, we can reduce the amount of
            patient sample needed or perform more tests using the same amount of sample. Combined with user-friendliness
            and accessibility at point-of-care, we can enable non-specialists to conduct quicker testing.
        </p>
        <p>
            There are many different antibiotics, modes of resistance, and resistant strains of bacteria. This year,
            we’re tackling <strong>urinary tract infections (UTIs)</strong>, specifically <i>E. coli</i> that degrade antibiotics
            like β-lactams and aminoglycosides. We’ll be looking at two antibiotics from each class and developing a <a
                href={page("wet-lab/biosensor")}>sensor</a
            >
            capable of testing for resistance and reporting it using fluorescence.
        </p>
    </div>

    <div class="at reveal interactive-overlay" style={at(40, 6255, 1200)}>
        <InteractiveSection />
    </div>

    <p class="at reveal home-copy" style={below(143, 7086, 1000)}>
        FAST brings antibiotic susceptibility testing out of the lab and closer to the point of care, pairing engineered
        biosensors with a microfluidic chip so clinicians can find the right antibiotic sooner. Behind that goal is a
        full design cycle starting from promoter candidates screened from RNA-seq data, degradation models built to
        guide experiments, biosensors cloned and meticulously characterized against clinically relevant antibiotics, to
        a fluorescence detector that brings it all together.
    </p>

    <img
        class="at reveal home-art pills"
        style={below(198, 7364, 172)}
        src={illustration("pills-left")}
        alt=""
        width="172"
        height="172"
        loading="lazy"
    />
    <p class="at reveal home-quote" style={below(378, 7380, 510)}>
        FAST is our contribution toward smarter prescribing, stronger healthcare, and a future where effective
        antibiotics stay effective.
    </p>
    <img
        class="at reveal home-art pills"
        style={below(904, 7356, 236)}
        src={illustration("pills-right")}
        alt=""
        width="236"
        height="194"
        loading="lazy"
    />

    <!-- In flow, unlike the rest, so the stage grows to fit the video however tall it is -->
    <div class="at reveal home-closing" style={below(240, 7782, 800)}>
        <h2>Antimicrobial resistance won’t wait, and neither should we.</h2>
        <a class="home-button home-button--lime home-button--large" href={page("project/description")}
            >Project description</a
        >
        <div class="home-video">
            <Video uuid="5b9c1052-d64a-4006-a6b1-1beca5562c78" aspect_ratio={16 / 9} />
        </div>
        <button class="home-button home-button--lime home-button--outlined home-to-top" type="button">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M6 12l6-6 6 6M6 19l6-6 6 6"></path>
            </svg>
            Return to top
        </button>
    </div>
</div>

<script>
    import { onPage } from "../utils/page";
    import { arrivedBy } from "../utils/transitions";
    import { trackColour } from "../utils/track-colour";
    import { gsap } from "gsap";
    import { DrawSVGPlugin } from "gsap/DrawSVGPlugin";
    import { MotionPathPlugin } from "gsap/MotionPathPlugin";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import Lenis from "lenis";
    import "lenis/dist/lenis.css";

    gsap.registerPlugin(DrawSVGPlugin, MotionPathPlugin, ScrollTrigger);

    // The design's width, in the units every block and the trace are laid out in
    const DESIGN_WIDTH = 1280;

    // The trace's runs (data-run in trace.svg), in reading order, each with whether it is drawn end to start.
    // Each chain is one unbroken line, with a dot of its own leading it. A chain ending on a junction dot (its index
    // among trace.svg's .trace-dot) only shows that dot once it gets there.
    const CHAINS: { dot: string; runs: [number, boolean][]; endDot?: number }[] = [
        // From the FAST text down to the end of the left-hand line beside the microfluidics explainer
        {
            dot: ".motion-dot--a",
            runs: [
                [0, false],
                [1, true],
                [2, false],
                [3, true],
                [4, false],
                [5, false],
                [6, true],
                [7, true],
            ],
        },
        // From the junction under Our Solution to the one above the interactive test
        {
            dot: ".motion-dot--b",
            runs: [
                [8, true],
                [9, false],
                [10, true],
            ],
            endDot: 1,
        },
        // From the junction under the interactive test to the closing line
        {
            dot: ".motion-dot--c",
            runs: [
                [11, true],
                [12, true],
            ],
        },
    ];

    // Seconds the Return to top button takes to scroll back up, easing in and out
    const RETURN_TO_TOP_DURATION = 2.5;
    const easeInOutCubic = (t: number): number => (t < 0.5 ? 4 * t ** 3 : 1 - (-2 * t + 2) ** 3 / 2);

    // How far down the viewport the line's head is kept, as it draws itself in
    const HEAD_AT = "60%";

    // A stretch of line mostly across rather than down still takes some scrolling to draw, as a share of its length
    const MIN_SCROLL_PER_LENGTH = 0.1;

    // How finely each run is sampled to work out when its head gets where
    const SAMPLE_LENGTH = 8;

    onPage((signal) => {
        const hero = document.querySelector(".home-hero");
        const stage = document.querySelector<HTMLElement>(".chip-stage");
        if (!hero || !stage) return;

        const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        // Scrolls the page slower than the browser would, and eases into each wheel step, so the intro and the dots
        // following the trace aren't rushed past. Driven by GSAP's ticker so ScrollTrigger reads the same frame.
        // Scrollable parts of the page (and the lightbox) keep the browser's own scrolling.
        const lenis = reducedMotion
            ? null
            : new Lenis({
                  allowNestedScroll: true,
                  lerp: 0.08,
                  prevent: (node) => !!node.closest("dialog[open]"),
                  wheelMultiplier: 0.6,
              });
        lenis?.on("scroll", ScrollTrigger.update);
        const tick = (time: number): void => lenis?.raf(time * 1000);
        if (lenis) {
            gsap.ticker.add(tick);
            // Lag smoothing would make the eased scroll stutter after a slow frame
            gsap.ticker.lagSmoothing(0);
        }

        document
            .querySelector(".home-to-top")
            ?.addEventListener(
                "click",
                () =>
                    lenis
                        ? lenis.scrollTo(0, { duration: RETURN_TO_TOP_DURATION, easing: easeInOutCubic })
                        : window.scrollTo({ top: 0, behavior: reducedMotion ? "auto" : "smooth" }),
                { signal },
            );

        // Collects every tween and ScrollTrigger made below, so leaving the page can stop them all
        const context = gsap.context(() => {
            // Narrow windows get the stacked layout (keep in sync with the max-width: 1250px styles): a single
            // centered column, so there's no chip to slide aside, and the trace and dots are display: none, so their
            // path work is skipped.
            const stackedQuery = window.matchMedia("(max-width: 1250px)");
            const isStacked = stackedQuery.matches;

            // Widening out of the stacked layout needs the trace, which wasn't set up at load - reloading is the
            // simplest way to get it.
            stackedQuery.addEventListener(
                "change",
                (event) => {
                    if (isStacked && !event.matches) location.reload();
                },
                { signal },
            );

            // Design units to pixels, at the stage's current size
            const unit = (): number => stage.offsetWidth / DESIGN_WIDTH;

            // The chip starts in the middle of the stage, and slides to its place in the design once shown
            const chipGroup = document.querySelector<HTMLElement>(".chip-group");
            const chipCentring = (): number =>
                isStacked || !chipGroup
                    ? 0
                    : stage.offsetWidth / 2 - (chipGroup.offsetLeft + chipGroup.offsetWidth / 2);
            let chipPlaced = false;
            gsap.set(".chip-group", { x: chipCentring });
            window.addEventListener(
                "resize",
                () => {
                    if (!chipPlaced) gsap.set(".chip-group", { x: chipCentring() });
                },
                { signal },
            );

            const chip3 = document.querySelector<HTMLImageElement>(".chip-3");
            // A failed load or decode still resolves, so the intro never stalls
            const chip3Ready = chip3 ? chip3.decode().catch(() => undefined) : Promise.resolve();

            const introTimeline = gsap
                .timeline()
                .addLabel("chip-intro")
                .to(".chip-1", { opacity: 1, duration: 0.7 })
                .to(".chip-2", { opacity: 1, duration: 0.7 }, "+=0.2")
                // chip-3 is a separate image (not inline SVG), so hold here until it can actually be shown
                .addLabel("chip-3-wait", "+=0.2")
                .addPause("chip-3-wait", () => {
                    void chip3Ready.then(() => introTimeline.resume());
                })
                .to(".chip-3", { opacity: 1, duration: 0.7 })
                // autoAlpha, so once gone their noise and blur filters are no longer painted
                .to(".chip-1, .chip-2", { autoAlpha: 0, duration: 0.1 }, "+=0.1")
                .addLabel("chip-shown")
                .to(".chip-group", { x: 0, duration: 0.4, ease: "power2.inOut" }, "+=0.2")
                .call(() => {
                    chipPlaced = true;
                })
                .addLabel("text-intro", "+=0.2")
                .to(".connector-line", { opacity: 1, duration: 0.6 }, "text-intro")
                .to(".fast-text-final", { opacity: 1, duration: 0.01 }, "text-intro")
                .fromTo(
                    ".fast-text-final",
                    { clipPath: "inset(0% 100% 0% 0%)" },
                    { clipPath: "inset(0% 0% 0% 0%)", duration: 0.6 },
                    "<",
                )
                .to(".motion-dot--a", { opacity: 1, duration: 0.6 }, "text-intro+=0.4");

            // Someone scrolling straight away shouldn't wait on the intro to reveal what they've scrolled to,
            // so it plays out faster from the first scroll (or at once, if the page loads already scrolled)
            const introScrolledTimeScale = 4;
            const hurryIntro = () => gsap.to(introTimeline, { timeScale: introScrolledTimeScale, duration: 0.3 });
            if (window.scrollY > 0) hurryIntro();
            else window.addEventListener("scroll", hurryIntro, { once: true, passive: true, signal });

            // Everything below the hero fades up as it's scrolled to
            if (reducedMotion) {
                gsap.set(".reveal, .stat, .stat-caption", { opacity: 1 });
            } else {
                ScrollTrigger.batch(".reveal", {
                    once: true,
                    start: "top 85%",
                    onEnter: (elements) =>
                        gsap.fromTo(
                            elements,
                            { opacity: 0, y: 24 },
                            { opacity: 1, y: 0, duration: 0.6, stagger: 0.12 },
                        ),
                });
            }

            // The 3 stat bubbles reveal once scrolled into view: left, then middle, then right, each wiping in
            // downwards (connector stub, then circle) before its number and caption fade in. In trace.svg each
            // bubble's stub comes before its circle.
            const statBubbleStagger = 0.5;
            const statsTimeline = gsap.timeline({
                scrollTrigger: {
                    // "top 70%": waits until the bubbles are well into the viewport
                    start: "top 70%",
                    toggleActions: "play none none none",
                    trigger: ".stat.stat-1",
                },
            });
            [1, 2, 3].forEach((stat, index) => {
                const [stub, circle] = document.querySelectorAll(`.trace .stat-art-${stat}`);
                const at = index * statBubbleStagger;
                if (stub && circle && !isStacked) {
                    statsTimeline
                        .fromTo(
                            stub,
                            { clipPath: "inset(0% 0% 100% 0%)" },
                            { clipPath: "inset(0% 0% 0% 0%)", duration: 0.2, ease: "none" },
                            at,
                        )
                        .fromTo(
                            circle,
                            { clipPath: "inset(0% 0% 100% 0%)" },
                            { clipPath: "inset(0% 0% 0% 0%)", duration: 0.45, ease: "power1.out" },
                            ">",
                        );
                }
                statsTimeline
                    .to(`.stat.stat-${stat}`, { opacity: 1, duration: 0.35 }, isStacked ? at : "<0.2")
                    .to(`.stat-caption.stat-${stat}`, { opacity: 1, duration: 0.35 }, "<0.15");
            });

            if (!isStacked) {
                for (const chain of CHAINS) drawChain(chain, unit, reducedMotion);
            }

            // The intro waits for the page transition, so it isn't half over by the time the page is revealed.
            // Arriving by the navbar's logo, which grew into the chip, it picks up from the chip. The transition
            // already waited for chip-3 to decode, so its pause goes: a seek stops at any pause it crosses, which
            // would leave chips 1 and 2 showing under the logo and chip-3 fading in again once the transition ends
            const { kind, finished } = arrivedBy();
            introTimeline.pause();
            if (kind === "logo") {
                introTimeline.removePause("chip-3-wait");
                introTimeline.seek("chip-shown");
            }
            void finished.then(() => introTimeline.play());
        });

        return () => {
            context.revert();
            if (lenis) {
                gsap.ticker.remove(tick);
                gsap.ticker.lagSmoothing(500, 33);
                lenis.destroy();
            }
        };
    });

    /**
     * Draws a chain of the trace in as the page scrolls, its dot riding the head of the line. The timeline runs in
     * design units down the page: the head reaches each point of the line as that point's height reaches HEAD_AT
     * down the viewport, so it stays around there. Stretches across or back up still take some scrolling of their
     * own, which the line going down makes back up.
     */
    function drawChain(
        { dot: dotSelector, runs, endDot }: (typeof CHAINS)[number],
        unit: () => number,
        reducedMotion: boolean,
    ): void {
        const dot = document.querySelector<HTMLElement>(dotSelector);
        const parts = runs.flatMap(([run, reverse]) => {
            const strokes = Array.from(document.querySelectorAll<SVGGeometryElement>(`.trace [data-run="${run}"]`));
            const path = strokes[0];
            return path ? [{ strokes, path, reverse, length: path.getTotalLength() }] : [];
        });
        if (!dot || parts.length === 0) return;

        if (reducedMotion) {
            gsap.set(dot, { display: "none" });
            return;
        }

        // The height in the trace of the point `along` the line from where its head sets off, counting the run's
        // own transform (the runs below the interactive test are moved down)
        const heightAlong = ({ path, reverse, length }: (typeof parts)[number], along: number): number => {
            const point = path.getPointAtLength(reverse ? length - along : along);
            const matrix = path.transform.baseVal.consolidate()?.matrix;
            return matrix ? point.matrixTransform(matrix).y : point.y;
        };

        // Waiting at the start of its line until the page is scrolled to it
        const { path: firstPath, reverse: firstReverse, strokes: firstStrokes, length: firstLength } = parts[0]!;
        const startAt = firstReverse ? 1 : 0;
        // The height down the page the chain sets off from, which the timeline's time counts from
        const origin = heightAlong(parts[0]!, 0);
        gsap.set(dot, {
            color: trackColour(firstPath, firstStrokes.slice(1))(firstReverse ? firstLength : 0),
            motionPath: { align: firstPath, alignOrigin: [0.5, 0.5], path: firstPath, start: startAt, end: startAt },
        });

        const timeline = gsap.timeline();
        let cursor = 0;
        for (const part of parts) {
            const { strokes, path, reverse, length } = part;

            // When the head reaches each sampled point along the run
            const steps = Math.max(1, Math.ceil(length / SAMPLE_LENGTH));
            const alongs = Array.from({ length: steps + 1 }, (_, step) => (length * step) / steps);
            const times = [Math.max(cursor, heightAlong(part, 0) - origin)];
            for (let step = 1; step <= steps; step++) {
                const earliest = times[step - 1]! + (length / steps) * MIN_SCROLL_PER_LENGTH;
                times.push(Math.max(earliest, heightAlong(part, alongs[step]!) - origin));
            }
            const position = times[0]!;
            const duration = times[steps]! - position;
            cursor = position + duration;

            // From the share of the run's time gone by to the share of its length drawn
            const ease = (progress: number): number => {
                const time = position + progress * duration;
                // The first sample at or past the time, or the last one (the time can overshoot by rounding)
                const found = times.findIndex((at) => at >= time);
                const next = found === -1 ? steps : Math.max(1, found);
                const [from, to] = [times[next - 1]!, times[next]!];
                const between = to > from ? (time - from) / (to - from) : 1;
                return (alongs[next - 1]! + between * (length / steps)) / length;
            };

            // Coloured as the line under it, wherever it is along it
            const colourAt = trackColour(path, strokes.slice(1));
            const follow = gsap.to(dot, {
                duration,
                ease,
                motionPath: {
                    align: path,
                    alignOrigin: [0.5, 0.5],
                    path,
                    start: reverse ? 1 : 0,
                    end: reverse ? 0 : 1,
                },
                onUpdate: () => {
                    const along = ease(follow.progress()) * length;
                    dot.style.color = colourAt(reverse ? length - along : along);
                },
            });
            timeline
                .fromTo(
                    strokes,
                    { drawSVG: reverse ? "100% 100%" : "0%" },
                    { drawSVG: reverse ? "0% 100%" : "100%", duration, ease },
                    position,
                )
                .add(follow, position);
        }
        // The first chain's dot is shown by the intro; the others glow on their junction until their line sets off
        if (dotSelector !== CHAINS[0]!.dot) gsap.set(dot, { opacity: 1 });
        const junction = endDot === undefined ? null : document.querySelectorAll(".trace .trace-dot")[endDot];
        if (junction) {
            timeline.fromTo(junction, { opacity: 0 }, { opacity: 1, duration: 10, ease: "none" }, cursor - 10);
        }

        ScrollTrigger.create({
            animation: timeline,
            end: () => `top+=${(origin + timeline.duration()) * unit()} ${HEAD_AT}`,
            invalidateOnRefresh: true,
            scrub: true,
            start: () => `top+=${origin * unit()} ${HEAD_AT}`,
            trigger: ".chip-stage",
        });
    }
</script>

