---
import chip1Svg from "../../public/assets/hero/home-page-chip-1.svg?raw";
import chip2Svg from "../../public/assets/hero/home-page-chip-2.svg?raw";
import connectorLineSvg from "../../public/assets/hero/home-start-line.svg?raw";
import fastTextFinalSvg from "../../public/assets/hero/FAST-text-final.svg?raw";
import chipLineSvg from "../../public/assets/hero/chip-line-first-full-final.svg?raw";
import chipLineSecondSvg from "../../public/assets/hero/chip-line-second-full-final.svg?raw";
import chipLine3Svg from "../../public/assets/hero/chip-line-3.svg?raw";
import dotSvg from "../../public/assets/hero/dot.svg?raw";
import ball2Svg from "../../public/assets/hero/ball2.svg?raw";
import pillsSvg from "../../public/assets/hero/pills.svg?raw";
import bottleSvg from "../../public/assets/hero/bottle.svg?raw";
import petriDishSvg from "../../public/assets/hero/petri-dish.svg?raw";
import MicrofluidicsExplainer from "./MicrofluidicsExplainer.astro";
import InteractiveSection from "./InteractiveSection.astro";
import { BASE_URL } from "../utils/base-url";
---

<div class="chip-stage">
    <div class="chip chip-1" set:html={chip1Svg} />
    <div class="chip chip-2" set:html={chip2Svg} />
    <img
        class="chip chip-3"
        src={`${BASE_URL}assets/hero/home-page-chip-3.svg`}
        alt=""
        width="536"
        height="525"
        fetchpriority="high"
    />
    <div class="connector-line" set:html={connectorLineSvg} />
    <div class="fast-text-final" set:html={fastTextFinalSvg} />
    <div class="chip-line" set:html={chipLineSvg} />
    <div class="chip-line-second" set:html={chipLineSecondSvg} />
    <div class="motion-dot" set:html={dotSvg} />
    <div class="motion-dot-2" set:html={ball2Svg} />

    <div class="stat stat-1">4.7 million</div>
    <div class="stat stat-2">1 in 6</div>
    <div class="stat stat-3">8.22 million</div>

    <!-- Reuses .stat-1/.stat-2/.stat-3 for the same horizontal centering
         as the bubbles above, so these stay aligned with them. Real <p>s
         (not <div>s) so the global ".page-content :global(p)" color rule
         applies automatically. -->
    <p class="stat-caption stat-1">deaths globally in 2021 were associated with bacterial antimicrobial resistance</p>
    <p class="stat-caption stat-2">
        laboratory-confirmed bacterial infections worldwide were resistant to antibiotics in 2023
    </p>
    <p class="stat-caption stat-3">
        deaths globally by 2050 are predicted to be associated with bacterial antimicrobial resistance
    </p>

    <div class="susceptibility-blurb">
        <div class="susceptibility-icon" set:html={pillsSvg} />
        <div class="susceptibility-copy">
            <h2>What is antibiotic susceptibility?</h2>
            <p>
                Antibiotic susceptibility determines whether a biological organism, mainly cells, can be killed by
                antibiotics. Through evolution, various species of pathogenic bacteria have acquired antibiotic
                immunity, rendering them insusceptible to certain antibiotics. As they continue to evolve, we must limit
                the use of antibiotics and opportunities for resistance by improving susceptibility testing and
                throughput.
            </p>
        </div>
    </div>

    <div class="solution-blurb">
        <div class="solution-copy">
            <h2>Our Solution</h2>
            <p>
                We produced a point-of-care device that determines susceptibility of a patient sample to an antibiotic
                in illnesses such as urinary tract infections (UTIs) by detecting degradation of the antibiotic.
            </p>
        </div>
        <div class="solution-metric">
            <div class="solution-icon-frame">
                <div class="solution-icon" set:html={bottleSvg} />
            </div>
            <p class="solution-time">4 - 24 hrs</p>
            <p class="solution-caption">Testing time <em>with</em> bacterial growup</p>
        </div>
        <div class="solution-metric">
            <div class="solution-icon-frame">
                <div class="solution-icon" set:html={petriDishSvg} />
            </div>
            <p class="solution-time">&lt;20 mins</p>
            <p class="solution-caption">Testing time <em>after</em> bacterial growup</p>
        </div>
    </div>

    <div class="microfluidics-overlay">
        <MicrofluidicsExplainer />
    </div>

    <!-- Outcome blurb - positioned below the microfluidics diagram -->
    <p class="outcome-blurb">
        Using microfluidic technology, we can reduce the amount of patient sample needed or perform more tests using the
        same amount of sample. Combined with user-friendliness and accessibility at point-of-care, we can enable
        non-specialists to conduct quicker testing.
    </p>

    <div class="interactive-overlay">
        <InteractiveSection />
    </div>

    <div class="chip-line-3" set:html={chipLine3Svg} />
</div>

<script>
    import { onPage } from "../utils/page";
    import { arrivedBy } from "../utils/transitions";
    import { colourAlong } from "../utils/track-colour";
    import { gsap } from "gsap";
    import { DrawSVGPlugin } from "gsap/DrawSVGPlugin";
    import { MotionPathPlugin } from "gsap/MotionPathPlugin";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import Lenis from "lenis";
    import "lenis/dist/lenis.css";

    gsap.registerPlugin(DrawSVGPlugin, MotionPathPlugin, ScrollTrigger);

    onPage((signal) => {
        const hero = document.querySelector(".home-hero");
        if (!hero) return;

        // Scrolls the page slower than the browser would, and eases into each wheel step, so the intro and the dots
        // following the chip lines aren't rushed past. Driven by GSAP's ticker so ScrollTrigger reads the same frame.
        // Scrollable parts of the page (and the lightbox) keep the browser's own scrolling.
        const lenis = window.matchMedia("(prefers-reduced-motion: reduce)").matches
            ? null
            : new Lenis({
                  allowNestedScroll: true,
                  lerp: 0.08,
                  prevent: (node) => !!node.closest("dialog[open]"),
                  wheelMultiplier: 0.6,
              });
        lenis?.on("scroll", ScrollTrigger.update);
        const tick = (time: number): void => lenis?.raf(time * 1000);
        if (lenis) {
            gsap.ticker.add(tick);
            // Lag smoothing would make the eased scroll stutter after a slow frame
            gsap.ticker.lagSmoothing(0);
        }

        // Collects every tween and ScrollTrigger made below, so leaving the page can stop them all
        const context = gsap.context(() => {
            // Narrow windows get the stacked layout (keep in sync with the
            // max-width: 1250px styles): a single centered column, so there's no
            // side-by-side composition to shift, and the chip lines/dots are
            // display: none, so their path work is skipped.
            const stackedQuery = window.matchMedia("(max-width: 1250px)");
            const isStacked = stackedQuery.matches;
            const stage = document.querySelector<HTMLElement>(".chip-stage");

            // The side-by-side composition's width in --chip-w, out to the FAST
            // text's right edge (.fast-text-final's left 1.14 + width 548/594)
            const COMPOSITION_WIDTH = 1.14 + 548 / 594;

            // How far the stage slides left to make room for the FAST text: enough to
            // centre the whole composition, but never so far the chip leaves the left edge.
            function stageShift(): number {
                if (stackedQuery.matches || !hero || !stage) return 0;
                const chipWidth = stage.offsetWidth;
                return Math.min(((COMPOSITION_WIDTH - 1) * chipWidth) / 2, (hero.clientWidth - chipWidth) / 2);
            }

            // Keeps the shift right while the window is resized, once the intro has applied it
            let stageShifted = false;
            window.addEventListener(
                "resize",
                () => {
                    if (stageShifted) gsap.set(".chip-stage", { x: -stageShift() });
                },
                { signal },
            );

            // Widening out of the stacked layout needs the chip lines/dots, which
            // weren't set up at load - reloading is the simplest way to get them.
            stackedQuery.addEventListener(
                "change",
                (event) => {
                    if (isStacked && !event.matches) location.reload();
                },
                { signal },
            );

            // traces chip line in 4 segments
            const chipLineSegments = [
                { el: document.querySelector<SVGGeometryElement>(".chip-line #stroke2_208_2980"), reverse: false },
                { el: document.querySelector<SVGGeometryElement>(".chip-line #stroke1_208_2980"), reverse: true },
                {
                    el: document.querySelector<SVGGeometryElement>(
                        '.chip-line path[stroke="url(#paint2_linear_208_2980)"]',
                    ),
                    reverse: false,
                },
                { el: document.querySelector<SVGGeometryElement>(".chip-line #stroke0_208_2980"), reverse: true },
            ].filter(
                (segment): segment is { el: SVGGeometryElement; reverse: boolean } => !isStacked && segment.el !== null,
            );

            const chipLineTotalLength = chipLineSegments.reduce((sum, { el }) => sum + el.getTotalLength(), 0);
            // Total seconds the whole line takes to draw itself in - tune this,
            // not the per-segment durations below (those stay proportional).
            const chipLineDrawInTotalDuration = 2.4;

            const chip3 = document.querySelector<HTMLImageElement>(".chip-3");
            // A failed load or decode still resolves, so the intro never stalls
            const chip3Ready = chip3 ? chip3.decode().catch(() => undefined) : Promise.resolve();

            const introTimeline = gsap
                .timeline()
                .addLabel("chip-intro")
                .to(".chip-1", { opacity: 1, duration: 1 })
                .to(".chip-2", { opacity: 1, duration: 1 }, "+=0.2")
                // chip-3 is a separate image (not inline SVG), so hold here until it can actually be shown
                .addLabel("chip-3-wait", "+=0.2")
                .addPause("chip-3-wait", () => {
                    void chip3Ready.then(() => introTimeline.resume());
                })
                .to(".chip-3", { opacity: 1, duration: 1 })
                // autoAlpha, so once gone their noise and blur filters are no longer painted
                .to(".chip-1, .chip-2", { autoAlpha: 0, duration: 0.3 }, "+=0.1")
                .addLabel("chip-shown")
                .to(".chip-stage", { x: () => -stageShift(), duration: 0.6, ease: "power2.inOut" }, "+=0.2")
                .call(() => {
                    stageShifted = true;
                })
                .addLabel("text-intro", "+=0.2")
                .to(".connector-line", { opacity: 1, duration: 0.6 }, "text-intro")
                .to(".fast-text-final", { opacity: 1, duration: 0.01 }, "text-intro")
                .fromTo(
                    ".fast-text-final",
                    { clipPath: "inset(0% 100% 0% 0%)" },
                    { clipPath: "inset(0% 0% 0% 0%)", duration: 0.6 },
                    "<",
                )
                .to(".motion-dot", { opacity: 1, duration: 0.6 }, "text-intro+=0.4")
                .addLabel("line-intro", "+=0.3")
                .to(".chip-line", { opacity: 1, duration: 0.01 }, "line-intro")
                .to(".susceptibility-blurb", { opacity: 1, duration: 0.3 }, "line-intro");

            chipLineSegments.forEach(({ el, reverse }, index) => {
                const duration = chipLineDrawInTotalDuration * (el.getTotalLength() / chipLineTotalLength);
                introTimeline.fromTo(
                    el,
                    { drawSVG: reverse ? "100% 100%" : "0%" },
                    { drawSVG: reverse ? "0% 100%" : "100%", duration },
                );

                // fade in alongside chip lines
                if (index === 2) {
                    introTimeline.addLabel("stats-reveal", `<${duration * 0.8}`);
                }
            });

            introTimeline.to(".solution-blurb", { opacity: 1, duration: 0.5 }, "stats-reveal+=0.6");
            introTimeline.to(".chip-line-second", { opacity: 1, duration: 0.5 }, "stats-reveal+=0.9");
            introTimeline.to(".motion-dot-2", { opacity: 1, duration: 0.5 }, "stats-reveal+=0.9");
            introTimeline.to(".microfluidics-overlay", { opacity: 1, duration: 0.5 }, "stats-reveal+=1.2");
            introTimeline.to(".outcome-blurb", { opacity: 1, duration: 0.5 }, "stats-reveal+=1.5");
            introTimeline.to(".interactive-overlay", { opacity: 1, duration: 0.5 }, "stats-reveal+=1.8");

            // Someone scrolling straight away shouldn't wait on the intro to reveal what they've scrolled to,
            // so it plays out faster from the first scroll (or at once, if the page loads already scrolled)
            const introScrolledTimeScale = 4;
            const hurryIntro = () => gsap.to(introTimeline, { timeScale: introScrolledTimeScale, duration: 0.3 });
            if (window.scrollY > 0) hurryIntro();
            else window.addEventListener("scroll", hurryIntro, { once: true, passive: true, signal });

            // The 3 stat bubbles reveal on their own once scrolled into view, rather
            // than with the intro: left, then middle, then right, each wiping in
            // downwards (connector stub, then circle) before its number and caption
            // fade in. In chip-line's SVG the stubs sit at x=209/569/929 and the
            // circles are filled with paint11/paint10/paint9, left to right.
            const statBubbles = [
                { stub: 'rect[x="209"]', circle: "paint11", stat: "stat-1" },
                { stub: 'rect[x="569"]', circle: "paint10", stat: "stat-2" },
                { stub: 'rect[x="929"]', circle: "paint9", stat: "stat-3" },
            ];
            // Seconds between one bubble starting and the next
            const statBubbleStagger = 0.5;
            const statsTimeline = gsap.timeline({
                scrollTrigger: {
                    // "top 70%": waits until the bubbles are well into the viewport
                    start: "top 70%",
                    toggleActions: "play none none none",
                    trigger: ".stat.stat-1",
                },
            });
            statBubbles.forEach(({ stub, circle, stat }, index) => {
                const at = index * statBubbleStagger;
                statsTimeline
                    .fromTo(
                        `.chip-line ${stub}`,
                        { clipPath: "inset(0% 0% 100% 0%)" },
                        { clipPath: "inset(0% 0% 0% 0%)", duration: 0.2, ease: "none" },
                        at,
                    )
                    .fromTo(
                        `.chip-line path[fill^="url(#${circle}_"]`,
                        { clipPath: "inset(0% 0% 100% 0%)" },
                        { clipPath: "inset(0% 0% 0% 0%)", duration: 0.45, ease: "power1.out" },
                        ">",
                    )
                    .to(`.stat.${stat}`, { opacity: 1, duration: 0.35 }, "<0.2")
                    .to(`.stat-caption.${stat}`, { opacity: 1, duration: 0.35 }, "<0.15");
            });

            // chip-line-3 no path added yet
            const chipLine3Path = document.querySelector<SVGGeometryElement>(
                '.chip-line-3 path[stroke="url(#paint0_linear_900_69)"]',
            );
            if (chipLine3Path && !isStacked) {
                introTimeline
                    .to(".chip-line-3", { opacity: 1, duration: 0.01 }, "stats-reveal+=2.1")
                    .fromTo(chipLine3Path, { drawSVG: "0%" }, { drawSVG: "100%", duration: 1.2 }, "<");
            }

            // A dot chases the line as the user scrolls, via MotionPathPlugin
            // walking the same 4 path segments (in the same order/direction) used
            // for the draw-in reveal above.
            const dot = document.querySelector<HTMLElement>(".motion-dot");

            if (dot && chipLineSegments.length > 0) {
                // Coloured as the line under it, wherever it is along it
                const colourAt = colourAlong(chipLineSegments);
                const dotTimeline = gsap.timeline({
                    paused: true,
                    onUpdate: () => (dot.style.color = colourAt(dotTimeline.time())),
                });
                dot.style.color = colourAt(0);
                for (const { el, reverse } of chipLineSegments) {
                    dotTimeline.to(dot, {
                        duration: el.getTotalLength(),
                        ease: "none",
                        motionPath: {
                            align: el,
                            alignOrigin: [0.5, 0.5],
                            path: el,
                            start: reverse ? 1 : 0,
                            end: reverse ? 0 : 1,
                        },
                    });
                }

                // Controls how much scroll distance maps to the full dot path -
                // lower = less scrolling needed = dot feels faster.
                const scrollDistanceFactor = 0.27;
                ScrollTrigger.create({
                    animation: dotTimeline,
                    end: `+=${dotTimeline.duration() * scrollDistanceFactor}`,
                    scrub: true,
                    start: "top top",
                    trigger: ".chip-stage",
                });
            }

            // Second dot traces second chip line, responsive to scroll
            const chipLineSecondSegments = [
                { el: document.querySelector<SVGGeometryElement>(".chip-line-second #stroke0_893_68"), reverse: true },
                { el: document.querySelector<SVGGeometryElement>(".chip-line-second #stroke1_893_68"), reverse: false },
                {
                    el: document.querySelector<SVGGeometryElement>(
                        '.chip-line-second path[stroke="url(#paint0_linear_893_68)"]',
                    ),
                    reverse: true,
                },
            ].filter(
                (segment): segment is { el: SVGGeometryElement; reverse: boolean } => !isStacked && segment.el !== null,
            );

            const dot2 = document.querySelector<HTMLElement>(".motion-dot-2");

            if (dot2 && chipLineSecondSegments.length > 0) {
                const colourAt = colourAlong(chipLineSecondSegments);
                const dot2Timeline = gsap.timeline({
                    paused: true,
                    onUpdate: () => (dot2.style.color = colourAt(dot2Timeline.time())),
                });
                dot2.style.color = colourAt(0);
                for (const { el, reverse } of chipLineSecondSegments) {
                    dot2Timeline.to(dot2, {
                        duration: el.getTotalLength(),
                        ease: "none",
                        motionPath: {
                            align: el,
                            alignOrigin: [0.5, 0.5],
                            path: el,
                            start: reverse ? 1 : 0,
                            end: reverse ? 0 : 1,
                        },
                    });
                }

                // Same control as scrollDistanceFactor above, for this second dot.
                const scrollDistanceFactor2 = 0.27;
                ScrollTrigger.create({
                    animation: dot2Timeline,
                    end: `+=${dot2Timeline.duration() * scrollDistanceFactor2}`,
                    scrub: true,
                    // Starts once chip-line-second's top is halfway up the viewport, not
                    // at the very top, so the dot is already moving as the line scrolls in.
                    // Higher % = earlier ("top 60%" starts sooner, "top 30%" later).
                    start: "top 50%",
                    trigger: ".chip-line-second",
                });
            }

            // The intro waits for the page transition, so it isn't half over by the time the page is revealed.
            // Arriving by the navbar's logo, which grew into the chip, it picks up from the chip. The transition
            // already waited for chip-3 to decode, so its pause goes: a seek stops at any pause it crosses, which
            // would leave chips 1 and 2 showing under the logo and chip-3 fading in again once the transition ends
            const { kind, finished } = arrivedBy();
            introTimeline.pause();
            if (kind === "logo") {
                introTimeline.removePause("chip-3-wait");
                introTimeline.seek("chip-shown");
            }
            void finished.then(() => introTimeline.play());
        });

        return () => {
            context.revert();
            if (lenis) {
                gsap.ticker.remove(tick);
                gsap.ticker.lagSmoothing(500, 33);
                lenis.destroy();
            }
        };
    });
</script>

<style>
    /* --chip-w drives every measurement below; the ratios come from the
       source SVGs' own viewBoxes (chip: 594x585, connector: 94x36,
       text: 548x386, chip-line: 1150x3027, chip-line-second: 1104x1765)
       so everything scales together. */
    .chip-stage {
        /* Full size on a wide window, shrinking with a narrower one so the
           ~2.06x --chip-w wide composition still fits beside the gutters and
           .home-hero's padding, down to the stacked-layout breakpoint below. */
        --chip-w: min(598px, calc((100vw - 2 * var(--page-gutter) - 4rem) / 2.1));
        /* Reserves real normal-flow height for the chip's full visual
           extent, all the way down through chip-line-3's bottom edge
           (.chip-line-3's own top 8.6 + height 0.42623 - see it below) -
           everything below the chip image itself is position:absolute and
           wouldn't otherwise push a following section down at all. */
        min-height: calc(var(--chip-w) * 9.02623);
        position: relative;
        width: var(--chip-w);
    }

    .chip-stage :global(svg) {
        display: block;
        height: 100%;
        width: 100%;
    }

    /* Explicit chip-w-based sizing (not height/width: 100%) so chip-stage's
       min-height above (needed to reserve layout space for the line below)
       doesn't stretch these to fill that much taller box. */
    /* chip-3 is an <img>: opt out of the .page-content img size caps (style.css)
       so it fills exactly the box the chip lines are laid out around */
    img.chip {
        max-height: none;
        max-width: none;
    }

    .chip {
        height: calc(var(--chip-w) * 585 / 594);
        left: 0;
        opacity: 0;
        position: absolute;
        top: 0;
        width: var(--chip-w);
    }

    .connector-line {
        height: calc(var(--chip-w) * 36 / 594);
        left: calc(var(--chip-w) * 1);
        opacity: 0;
        position: absolute;
        top: calc(var(--chip-w) * 0.248);
        width: calc(var(--chip-w) * 94 / 594);
    }

    .fast-text-final {
        height: auto;
        left: calc(var(--chip-w) * 1.14);
        opacity: 0;
        position: absolute;
        top: calc(var(--chip-w) * 0.2);
        width: calc(var(--chip-w) * 548 / 594);
        /* chip-line (and so .motion-dot's resting spot) starts inside this
           box, so the text sits on top of the dot until it scrolls away */
        z-index: 1;
    }

    /* Replaces the old init-line + line-full pair with one unified asset.
       Anchor estimate carried over from init-line's old position (its own
       entry point sits at a similar ~80% across its width) - likely needs
       a visual nudge once checked in a browser. */
    .chip-line {
        height: calc(var(--chip-w) * 3027 / 594);
        left: calc(var(--chip-w) * 0.094);
        opacity: 0;
        position: absolute;
        top: calc(var(--chip-w) * 0.7944);
        width: calc(var(--chip-w) * 1150 / 594);
    }

    /* Forced to the same rendered width as .chip-line above (not its own
       native 1104-wide scale) so the two lines join up at the same
       horizontal span, per request. Height follows from that width via
       chip-line-second's own aspect ratio (1150/594 * 1765/1104 =
       3.09563). Positioned flush under chip-line's own bottom edge
       (0.7944 + 3027/594 = 5.8904) - same left, immediate continuation. */
    .chip-line-second {
        height: calc(var(--chip-w) * 3.09563);
        left: calc(var(--chip-w) * 0.094);
        opacity: 0;
        position: absolute;
        top: calc(var(--chip-w) * 3.94);
        width: calc(var(--chip-w) * 1150 / 594);
    }

    /* The 3 stat-circle connector stubs (<rect>) and the 3 stat circles
       themselves (<path>, selected by fill since they have no id) start
       clipped away regardless of chip-line's own opacity, so the GSAP
       "stats-reveal" wipe (script above) has something to animate from. */
    .chip-line :global(rect),
    .chip-line :global(path[fill^="url(#paint9"]),
    .chip-line :global(path[fill^="url(#paint10"]),
    .chip-line :global(path[fill^="url(#paint11"]) {
        clip-path: inset(0% 0% 100% 0%);
    }

    /* dot.svg is 45x45 (the r=12.5 circle plus room for its glow), so the
       circle itself still renders at the same 25-unit size as before */
    /* Each dot is filled with its colour, which the script keeps to that of the line under it */
    .motion-dot :global(circle),
    .motion-dot-2 :global(circle) {
        fill: currentColor;
    }

    /* Its glow in the same colour, in place of the file's own fixed one: dot.svg's 5-unit blur, scaled as the dot is */
    .motion-dot :global(g) {
        filter: none;
    }

    .motion-dot {
        color: var(--color-lime-yellow);
        filter: drop-shadow(0 0 calc(var(--chip-w) * 10 / 800) currentColor);
        height: calc(var(--chip-w) * 45 / 594);
        left: 0;
        opacity: 0;
        position: absolute;
        top: 0;
        /* Its own layer, so moving it doesn't repaint the chip line under it every frame */
        will-change: transform;
        width: calc(var(--chip-w) * 45 / 594);
    }

    /* ball2.svg, chases chip-line-second the same way .motion-dot chases
       chip-line. */
    .motion-dot-2 {
        color: #7c79d6;
        /* The same glow as .motion-dot, its circle being the same 25-unit size */
        filter: drop-shadow(0 0 calc(var(--chip-w) * 10 / 800) currentColor);
        height: calc(var(--chip-w) * 25 / 594);
        left: 0;
        opacity: 0;
        position: absolute;
        top: 0;
        will-change: transform;
        width: calc(var(--chip-w) * 25 / 594);
    }

    /* Centered over each of chip-line's 3 baked-in stat circles (each
       r=105 at cy=980, cx=212/575/929 in chip-line's own 1150x3027
       coordinate space) - left offsets below are chip-line's own 0.094
       left plus each circle's own left edge (cx - r), divided by 594. */
    .stat {
        align-items: center;
        color: var(--color-ebony-clay);
        display: flex;
        font-family: var(--font-geist);
        /* 48px/50px at full size, scaling with the bubble so the number stays inside it */
        font-size: calc(var(--chip-w) * 48 / 598);
        font-weight: 700;
        height: calc(var(--chip-w) * 210 / 594);
        justify-content: center;
