---
import muteSvg from "../../public/assets/hero/mute-toggle.svg?raw";
import sfxOnSvg from "../../public/assets/hero/sfx-on-toggle.svg?raw";
---

<button class="sound-toggle" type="button" aria-pressed="false" aria-label="Sound effects">
    <span class="sound-toggle-layer sound-toggle-layer--mute" aria-hidden="true" set:html={muteSvg} />
    <span class="sound-toggle-layer sound-toggle-layer--on" aria-hidden="true" set:html={sfxOnSvg} />
</button>

<script>
    import { onPage } from "../utils/page";
    import { setSoundOn } from "../utils/sfx";

    onPage(() => {
        const toggle = document.querySelector<HTMLButtonElement>(".sound-toggle");

        toggle?.addEventListener("click", () => {
            const on = toggle.getAttribute("aria-pressed") !== "true";
            toggle.setAttribute("aria-pressed", String(on));
            setSoundOn(on);
        });
    });
</script>

<style>
    /* Both SVGs share one 586x284 viewBox: the track is each file's first
       child and everything after it is the knob (circle + speaker icon).
       The knobs sit 291 units apart (cx 151 vs 442), so sliding a knob by
       that much while cross-fading the two layers reads as one knob
       moving across and changing its icon/track colour on the way. */
    .sound-toggle {
        background: none;
        border: none;
        cursor: pointer;
        display: grid;
        padding: 0;
        width: 5rem;
    }

    .sound-toggle:focus-visible {
        border-radius: 999px;
        outline: 2px solid var(--color-lime-yellow);
        outline-offset: 3px;
    }

    .sound-toggle-layer {
        grid-area: 1 / 1;
        transition: opacity 300ms ease;
    }

    .sound-toggle-layer :global(svg) {
        display: block;
        height: auto;
        width: 100%;
    }

    /* px inside an SVG means viewBox units, so 291px is exactly the knob gap */
    .sound-toggle-layer :global(svg > :not(:first-child)) {
        transition: transform 300ms ease;
    }

    /* Muted (default): mute layer showing, the "on" layer's knob parked on the left with it */
    .sound-toggle-layer--on {
        opacity: 0;
    }

    .sound-toggle-layer--on :global(svg > :not(:first-child)) {
        transform: translateX(-291px);
    }

    /* On: both knobs slide right together while the layers cross-fade */
    .sound-toggle[aria-pressed="true"] .sound-toggle-layer--mute {
        opacity: 0;
    }

    .sound-toggle[aria-pressed="true"] .sound-toggle-layer--mute :global(svg > :not(:first-child)) {
        transform: translateX(291px);
    }

    .sound-toggle[aria-pressed="true"] .sound-toggle-layer--on {
        opacity: 1;
    }

    .sound-toggle[aria-pressed="true"] .sound-toggle-layer--on :global(svg > :not(:first-child)) {
        transform: none;
    }

    @media (prefers-reduced-motion: reduce) {
        .sound-toggle-layer,
        .sound-toggle-layer :global(svg > :not(:first-child)) {
            transition: none;
        }
    }
</style>
