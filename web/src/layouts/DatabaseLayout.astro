---
import type { MarkdownHeading } from "astro";
import type { DatabaseAttrs } from "@exporter/markdown/markdown";
import { PagePath } from "@exporter/map";
import DbDropdown from "../components/DbDropdown.astro";
import MainLayout from "./MainLayout.astro";

interface Props {
    attrs: DatabaseAttrs;
    headings?: MarkdownHeading[];
}
const { attrs, headings } = Astro.props;

const current_page_path = attrs.path;
const parent_db_path = new PagePath(PagePath.fromString(attrs.path).components().slice(0, 2)).toString();
const display_date = formatDate(attrs.date);

function formatDate(value: string | undefined): string | undefined {
    if (!value || Number.isNaN(Date.parse(value))) return;

    const match = /^(\d{4})-(\d{2})-(\d{2})(?:$|T)/.exec(value);
    if (!match) return;

    const [year, month, day] = match.slice(1).map(Number);
    const date = new Date(Date.UTC(year!, month! - 1, day!));
    if (date.getUTCFullYear() !== year || date.getUTCMonth() !== month! - 1 || date.getUTCDate() !== day) return;

    return new Intl.DateTimeFormat("en-US", {
        day: "numeric",
        month: "long",
        timeZone: "UTC",
        year: "numeric",
    }).format(date);
}
---

<MainLayout title={attrs.title} headings={headings}>
    <DbDropdown slot="sidebar" parent_db_path={parent_db_path} current_page_path={current_page_path} />
    {
        display_date && (
            <time class="db-date" datetime={attrs.date}>
                {display_date}
            </time>
        )
    }
    <slot />
</MainLayout>

<style>
    .db-layout {
        align-items: start;
        display: grid;
        gap: 1rem;
        grid-template-columns: minmax(12rem, 18rem) minmax(0, 1fr);
    }

    aside.db-sidebar {
        background-color: var(--color-periwinkle);
        border: 1px solid var(--color-grey-teal);
        color: var(--color-ebony-clay);
        font-family: "Source Serif 4", serif;
        font-size: 16px;
        font-weight: 400;
        line-height: 1.5;
        max-height: calc(100vh - 8rem);
        overflow-y: auto;
        padding: 1rem;
        position: sticky;
        top: 1rem;
    }

    aside.db-sidebar :global(a) {
        color: var(--color-ebony-clay);
        text-decoration: none;
    }

    aside.db-sidebar :global(a:hover) {
        color: var(--color-ebony-clay);
        text-decoration-color: var(--color-cornflower);
        text-decoration-line: underline;
        text-underline-offset: 0.15em;
    }

    aside.db-sidebar :global(a:focus-visible) {
        outline: 2px solid var(--color-cornflower);
        outline-offset: 2px;
    }

    .db-content {
        min-width: 0;
    }

    .db-date {
        color: var(--color-ebony-clay);
        display: block;
        margin-bottom: 1rem;
    }
</style>
