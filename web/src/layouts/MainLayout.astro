---
import "katex/dist/katex.min.css";
import "../style.css";
import type { MarkdownHeading } from "astro";
import Navbar from "../components/Navbar.astro";
import TableOfContents from "../components/TableOfContents.astro";

interface Props {
    title?: string;
    headings?: MarkdownHeading[];
}
const { title, headings = [] } = Astro.props;
const show_toc = headings.length > 0;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <title>{title ?? "UBC iGEM Wiki"}</title>
    </head>
    <body>
        <Navbar />
        <div class:list={["page-layout", { "has-toc": show_toc }]}>
            <main class="page-content">
                {title && <div class="page-title">{title}</div>}
                <slot />
            </main>
            {
                show_toc && (
                    <aside class="page-toc">
                        <TableOfContents headings={headings} />
                    </aside>
                )
            }
        </div>
    </body>
</html>

<style>
    :global(:root) {
        --color-ebony-clay: #1b1f41;
        --color-orchid: #e650db;
        --color-lime-yellow: #c9fd3a;
        --color-citrine: #ddd200;
        --color-periwinkle: #bbd1ff;
        --color-northern-lights: #88bed4;
        --color-grey-teal: #54a190;
        --color-cornflower: #6a67ff;
        --color-fluorescence: #00ff92;
    }

    .page-layout {
        padding: 1rem;
    }

    .page-layout.has-toc {
        align-items: start;
        display: grid;
        gap: 1.5rem;
        grid-template-columns: minmax(0, 1fr) minmax(11rem, 15rem);
    }

    .page-content {
        min-width: 0;
    }

    .page-title {
        color: var(--color-ebony-clay);
        font-family: "Geist", sans-serif;
        font-size: 36px;
        font-weight: 700;
        line-height: 1.2;
        margin-bottom: 1.5rem;
    }

    .page-content :global(h1),
    .page-content :global(h2),
    .page-content :global(h3),
    .page-content :global(h4) {
        color: var(--color-ebony-clay);
        font-family: "Geist", sans-serif;
        font-weight: 700;
    }

    .page-content :global(h1) {
        font-size: 36px;
        line-height: 1.2;
        margin: 2rem 0 1rem;
    }

    .page-content :global(h2) {
        font-size: 24px;
        line-height: 1.25;
        margin: 1.5rem 0 0.75rem;
    }

    .page-content :global(h3) {
        font-size: 16px;
        line-height: 1.3;
        margin: 1.25rem 0 0.5rem;
    }

    .page-content :global(h4) {
        color: var(--color-ebony-clay);
        font-family: "Geist", sans-serif;
        font-size: 16px;
        font-weight: 700;
        line-height: 1.3;
        margin: 1.25rem 0 0.5rem;
    }

    .page-content :global(p),
    .page-content :global(li) {
        color: var(--color-ebony-clay);
        font-family: "Source Serif 4", serif;
        font-size: 16px;
        font-weight: 400;
        line-height: 1.5;
    }

    .page-content :global(p) {
        margin: 0 0 1rem;
    }

    .page-content :global(a) {
        color: var(--color-cornflower);
        text-decoration: underline;
    }

    .page-content :global(a:hover) {
        text-decoration-thickness: 2px;
    }

    .page-content :global(a:focus-visible) {
        outline: 2px solid var(--color-cornflower);
        outline-offset: 2px;
    }

    .page-content :global(table) {
        color: var(--color-ebony-clay);
        font-family: "Source Serif 4", serif;
        font-size: 12px;
        margin: 1rem 0;
    }

    .page-content :global(th) {
        font-weight: 700;
    }

    .page-content :global(td) {
        font-weight: 400;
    }

    .page-content :global(figcaption),
    .page-content :global(caption) {
        color: var(--color-ebony-clay);
        font-family: "Source Serif 4", serif;
        font-size: 12px;
        font-weight: 400;
        line-height: 1.4;
        margin-top: 0.5rem;
    }

    .page-content :global(hr) {
        border: 0;
        border-top: 1px solid var(--color-grey-teal);
        margin: 1.5rem 0;
    }

    .page-toc {
        color: var(--color-ebony-clay);
        font-family: "Source Serif 4", serif;
        font-size: 16px;
        font-weight: 400;
        max-height: calc(100vh - 6rem);
        overflow-y: auto;
        position: sticky;
        top: 1rem;
    }

    .page-toc :global(a) {
        color: var(--color-ebony-clay);
        text-decoration: none;
    }

    .page-toc :global(a:hover) {
        color: var(--color-cornflower);
        text-decoration: underline;
    }

    .page-toc :global(a:focus-visible) {
        outline: 2px solid var(--color-cornflower);
        outline-offset: 2px;
    }

    @media (max-width: 1000px) {
        .page-layout.has-toc {
            display: block;
        }

        .page-toc {
            display: none;
        }
    }
</style>
