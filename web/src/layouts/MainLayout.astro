---
import "katex/dist/katex.min.css";
import "../style.css";
import type { MarkdownHeading } from "astro";
import Navbar from "../components/Navbar.astro";
import TableOfContents from "../components/TableOfContents.astro";

interface Props {
    title?: string;
    headings?: MarkdownHeading[];
}
const { title, headings = [] } = Astro.props;
const show_toc = headings.length > 0;
const show_sidebar = show_toc || Astro.slots.has("sidebar");
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <title>{title ?? "UBC iGEM Wiki"}</title>
    </head>
    <body>
        <Navbar />
        <div class:list={["page-layout", { "has-sidebar": show_sidebar }]}>
            <main class="page-content">
                {title && <div class="page-title">{title}</div>}
                <slot />
            </main>
            {
                show_sidebar && (
                    <aside class="page-sidebar">
                        <slot name="sidebar" />
                        {show_toc && (
                            <div class="page-toc">
                                <TableOfContents headings={headings} />
                            </div>
                        )}
                    </aside>
                )
            }
        </div>
    </body>
</html>

<style>
    .page-layout {
        padding: 1rem;
    }

    .page-layout.has-sidebar {
        align-items: start;
        display: grid;
        gap: 1.5rem;
        grid-template-columns: minmax(0, 1fr) minmax(11rem, 15rem);
    }

    .page-content {
        min-width: 0;
    }

    .page-title {
        font-size: 50px;
        font-weight: 600;
    }

    /* Only the table of contents scrolls, so an open dropdown is never clipped */
    .page-sidebar {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        max-height: calc(100vh - 2rem);
        position: sticky;
        top: 1rem;
    }

    .page-toc {
        min-height: 0;
        overflow-y: auto;
    }

    @media (max-width: 1000px) {
        .page-layout.has-sidebar {
            display: flex;
            flex-direction: column;
        }

        /* Stacked, the sidebar would otherwise land below the whole article */
        .page-sidebar {
            max-height: none;
            order: -1;
            position: static;
        }

        .page-toc {
            display: none;
        }
    }
</style>
