---
import "katex/dist/katex.min.css";
import "../style.css";

import type { MarkdownHeading } from "astro";
import { Font } from "astro:assets";

import Lightbox from "../components/Lightbox.astro";
import Navbar from "../components/Navbar.astro";
import SponsorFooter from "../components/SponsorFooter.astro";
import TableOfContents from "../components/TableOfContents.astro";
import { BASE_URL } from "../utils/base-url";

interface Props {
    title?: string;
    headings?: MarkdownHeading[];
}

const { title, headings = [] } = Astro.props;

const show_toc = headings.length > 0;
const show_sidebar = show_toc || Astro.slots.has("sidebar");
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title ?? "UBC iGEM Wiki"}</title>

        <link rel="icon" type="image/svg+xml" href={`${BASE_URL}favicon.svg`} />
        <link rel="icon" href={`${BASE_URL}favicon.ico`} />

        <Font cssVariable="--font-geist" />
        <Font cssVariable="--font-source-serif-4" />
    </head>

    <body>
        <Navbar />

        <div class:list={["page-layout", { "has-sidebar": show_sidebar }]}>
            <main class="page-content">
                {title && <div class="page-title">{title}</div>}
                <slot />
            </main>

            {
                show_sidebar && (
                    <aside class="page-sidebar">
                        <slot name="sidebar" />

                        {show_toc && (
                            <div class="page-toc">
                                <TableOfContents headings={headings} />
                            </div>
                        )}
                    </aside>
                )
            }
        </div>
        <SponsorFooter />
        <Lightbox />
    </body>
</html>

<style>
    :global(:root) {
        --color-ebony-clay: #1b1f41;
        --color-orchid: #e650db;
        --color-lime-yellow: #c9fd3a;
        --color-citrine: #ddd200;
        --color-periwinkle: #bbd1ff;
        --color-northern-lights: #88bed4;
        --color-grey-teal: #54a190;
        --color-cornflower: #6a67ff;
        --color-fluorescence: #00ff92;

        /* Not one of the nine brand colours: a lighter ebony clay for surfaces raised off the page, like table headers */
        --color-ebony-clay-raised: #2a2f5c;
    }

    :global(html),
    :global(body) {
        background-color: var(--color-ebony-clay);
        color: var(--color-periwinkle);
        min-height: 100%;
    }

    .page-layout {
        background-color: var(--color-ebony-clay);
        min-height: 100vh;
        padding: 2rem var(--page-gutter) 4rem;
    }

    .page-layout.has-sidebar {
        align-items: start;
        display: grid;
        gap: 4rem;
        grid-template-columns: minmax(0, 1fr) minmax(11rem, 15rem);
    }

    /*
     * Type scale:
     * A 17px serif body
     * Headings stepping down 32 / 24 / 20 / 17px
     * Secondary text (tables, captions, code, bibliography) at 14-15px
     * All sizes in rem.
     */
    .page-content {
        font-family: var(--font-source-serif-4);
        font-size: 1.0625rem;
        line-height: 1.65;
        min-width: 0;
        /* Bare URLs in links and citations offer a narrow screen no break opportunities */
        overflow-wrap: break-word;
    }

    .page-title {
        color: var(--color-periwinkle);
        font-family: var(--font-geist);
        font-size: clamp(2.25rem, 6vw, 3rem);
        font-weight: 700;
        line-height: 1.15;
        margin-bottom: 1.5rem;
    }

    .page-content :global(:is(h1, h2, h3, h4, h5, h6)) {
        color: var(--color-periwinkle);
        font-family: var(--font-geist);
        font-weight: 700;
    }

    .page-content :global(h1) {
        font-size: 2rem;
        line-height: 1.2;
        margin: 2.5rem 0 1rem;
    }

    .page-content :global(h2) {
        font-size: 1.5rem;
        line-height: 1.25;
        margin: 2rem 0 0.75rem;
    }

    .page-content :global(h3) {
        font-size: 1.25rem;
        line-height: 1.3;
        margin: 1.75rem 0 0.5rem;
    }

    /* h4 and below match the body size and rely on weight/font */
    .page-content :global(:is(h4, h5, h6)) {
        font-size: 1.0625rem;
        line-height: 1.4;
        margin: 1.5rem 0 0.5rem;
    }

    .page-content :global(p),
    .page-content :global(li) {
        color: var(--color-periwinkle);
        font-weight: 400;
    }

    .page-content :global(p) {
        margin: 0 0 1em;
    }

    .page-content :global(li + li) {
        margin-top: 0.25em;
    }

    /* Monospace runs large beside serif text */
    .page-content :global(:not(pre) > code) {
        font-size: 0.875em;
    }

    .page-content :global(a) {
        color: var(--color-northern-lights);
        text-decoration-color: var(--color-cornflower);
        text-decoration-line: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.15em;
    }

    .page-content :global(a:hover) {
        text-decoration-thickness: 2px;
    }

    .page-content :global(a:focus-visible) {
        outline: 2px solid var(--color-cornflower);
        outline-offset: 2px;
    }

    .page-content :global(figcaption),
    .page-content :global(caption) {
        color: var(--color-periwinkle);
        font-family: var(--font-source-serif-4);
        font-size: 0.875rem;
        font-weight: 400;
        line-height: 1.45;
        margin-top: 0.5rem;
    }

    .page-content :global(hr) {
        border: 0;
        border-top: 1px solid var(--color-northern-lights);
        margin: 3rem 0;
    }

    /* Only the table of contents scrolls, so an open dropdown is never clipped */
    .page-sidebar {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        max-height: calc(100vh - 2rem);
        position: sticky;
        top: 1rem;
    }

    .page-toc {
        color: var(--color-periwinkle);
        font-family: var(--font-source-serif-4);
        font-weight: 400;
        line-height: 1.5;
        max-height: calc(100vh - 6rem);
        min-height: 0;
        overflow-y: auto;
    }

    .page-toc :global(h2),
    .page-toc :global(h3),
    .page-toc :global(p),
    .page-toc :global(strong),
    .page-toc :global(span) {
        color: var(--color-periwinkle);
    }

    .page-toc :global(a) {
        color: var(--color-periwinkle);
        text-decoration: none;
    }

    .page-toc :global(a:hover) {
        color: var(--color-northern-lights);
        text-decoration-color: var(--color-cornflower);
        text-decoration-line: underline;
        text-underline-offset: 0.15em;
    }

    .page-toc :global(a:focus-visible) {
        outline: 2px solid var(--color-cornflower);
        outline-offset: 2px;
    }

    @media (max-width: 1000px) {
        .page-layout {
            padding: 1.25rem var(--page-gutter) 3rem;
        }

        /* Stretch, or the grid's `start` leaves the article at its full text width */
        .page-layout.has-sidebar {
            align-items: stretch;
            display: flex;
            flex-direction: column;
        }

        /* Stacked, the sidebar would otherwise land below the whole article */
        .page-sidebar {
            max-height: none;
            order: -1;
            position: static;
        }

        /* Above the article rather than beside it, so a long list is capped */
        .page-toc {
            max-height: 60vh;
        }

        /* A table too wide for the screen scrolls in place rather than widening the page */
        .page-content :global(table) {
            display: block;
            overflow-x: auto;
        }
    }

    /* Big headings take up too much of a phone screen */
    @media (max-width: 600px) {
        .page-content :global(h1) {
            font-size: 1.75rem;
        }

        .page-content :global(h2) {
            font-size: 1.375rem;
        }

        .page-content :global(h3) {
            font-size: 1.1875rem;
        }
    }
</style>
