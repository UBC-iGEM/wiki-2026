@article{reinhardt3DBioprintingMineralizing2023,
	title = {{3D} bioprinting of mineralizing cyanobacteria as novel approach for the fabrication of living building materials},
	volume = {11},
	issn = {2296-4185},
	url = {https://www.frontiersin.org/journals/bioengineering-and-biotechnology/articles/10.3389/fbioe.2023.1145177/full},
	doi = {10.3389/fbioe.2023.1145177},
	abstract = {{\textless}p{\textgreater}Living building materials (LBM) are gaining interest in the field of sustainable alternative construction materials to reduce the significant impact of the construction industry on global CO$_{\textrm{2}}$ emissions. This study investigated the process of three-dimensional bioprinting to create LBM incorporating the cyanobacterium {\textless}italic{\textgreater}Synechococcus{\textless}/italic{\textgreater} sp. strain PCC 7002, which is capable of producing calcium carbonate (CaCO$_{\textrm{3}}$) as a biocement. Rheology and printability of biomaterial inks based on alginate-methylcellulose hydrogels containing up to 50 wt\% sea sand were examined. PCC 7002 was incorporated into the bioinks and cell viability and growth was characterized by fluorescence microscopy and chlorophyll extraction after the printing process. Biomineralization was induced in liquid culture and in the bioprinted LBM and observed by scanning electron microscopy, energy-dispersive X-ray spectroscopy, and through mechanical characterization. Cell viability in the bioprinted scaffolds was confirmed over 14 days of cultivation, demonstrating that the cells were able to withstand shear stress and pressure during the extrusion process and remain viable in the immobilized state. CaCO$_{\textrm{3}}$ mineralization of PCC 7002 was observed in both liquid culture and bioprinted LBM. In comparison to cell-free scaffolds, LBM containing live cyanobacteria had a higher compressive strength. Therefore, bioprinted LBM containing photosynthetically active, mineralizing microorganisms could be proved to be beneficial for designing environmentally friendly construction materials.{\textless}/p{\textgreater}},
	language = {English},
	urldate = {2025-03-07},
	journal = {Frontiers in Bioengineering and Biotechnology},
	publisher = {Frontiers},
	author = {Reinhardt, Olena and Ihmann, Stephanie and Ahlhelm, Matthias and Gelinsky, Michael},
	month = apr,
	year = {2023},
	keywords = {LBMs, notion},
}

@article{wangApplicationsMicrobialinducedCarbonate2023,
	title = {Applications of microbial-induced carbonate precipitation: {A} state-of-the-art review},
	volume = {1},
	issn = {2949-9291},
	shorttitle = {Applications of microbial-induced carbonate precipitation},
	url = {https://www.sciencedirect.com/science/article/pii/S2949929123000086},
	doi = {10.1016/j.bgtech.2023.100008},
	abstract = {Microbial-Induced Carbonate Precipitation (MICP) is a naturally occurring process whereby bacteria produce enzymes that accelerate the precipitation of calcium carbonate. This process is facilitated through various bacterial activities, including ureolysis, sulfate reduction, iron reduction, and denitrification. The application of MICP has been widespread in a range of engineering fields, such as geotechnical, concrete, environmental, and oil and gas engineering for soil stabilization, concrete remediation, heavy metal solidification, and permeability control. Numerous review papers have been published that summarize the mechanisms and properties associated with different MICP applications. The purpose of this review paper is to provide a comprehensive summary of the various engineering applications of MICP, along with the mechanisms, materials, and engineering properties associated with each application. By comparing the similarities and differences in MICP research progress across different engineering fields, this review aims to increase understanding of MICP, stimulate new research ideas, and accelerate the development of MICP techniques.},
	number = {1},
	urldate = {2025-02-21},
	journal = {Biogeotechnics},
	author = {Wang, Yuze and Konstantinou, Charalampos and Tang, Sikai and Chen, Hongyu},
	month = mar,
	year = {2023},
	keywords = {notion},
	pages = {100008},
}

