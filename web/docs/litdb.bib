	url = {https://www.sciencedirect.com/science/article/pii/S2211926413001057},
	doi = {10.1016/j.algal.2013.11.012},
	abstract = {Cyanobacteria have several advantages as lipid feedstock for biodiesel production compared to microalgae. These benefits include the ability to increase lipid content via genetic manipulation, a high growth rate, nitrogen-fixation and a simpler cell wall, which aids in lipid extraction. Moreover, these bacteria have the capability to convert solar energy into biomass that is two times greater than microalgae and ten times greater than corn and sugar cane. The aim of this study was to optimize the cultivation conditions of Synechococcus sp. PCC7942 and to evaluate the lipid feedstock to generate biodiesel via an enzymatic route. For this purpose, the effect of light intensity (50–150μmolm−2s−1) and the concentration of Na2CO3 (0.5–1.5gL−1) were studied according to a 22 full-factorial design. Under optimized conditions, the biomass productivity (QP) of 124.0±3.2mgL−1day−1, lipid content of 29.0±2.1},
	journal = {Algal Research},
	author = {Silva, Caroline Souza Pamplona and Silva-Stenico, Maria Estela and Fiore, Marli Fátima and de Castro, Heizir Ferreira and Da Rós, Patrícia Caroline Molgero},
	year = {2014},
	keywords = {Biodiesel, Cyanobacteria, Enzymatic catalysis, Lipid feedstock, notion, sp. PCC7942},
	pages = {1--7},
}

