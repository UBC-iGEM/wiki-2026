@article{chanquiaPhotobioreactorsCultivationSynthesis2021,
	title = {Photobioreactors for cultivation and synthesis: {Specifications}, challenges, and perspectives},
	volume = {22},
	issn = {1618-0240},
	shorttitle = {Photobioreactors for cultivation and synthesis},
	url = {https://pmc.ncbi.nlm.nih.gov/articles/PMC9731602/},
	doi = {10.1002/elsc.202100070},
	abstract = {Due to their versatility and the high biomass yield produced, cultivation of phototrophic organisms is an increasingly important field. In general, open ponds are chosen to do it because of economic reasons; however, this strategy has several drawbacks such as poor control of culture conditions and a considerable risk of contamination. On the other hand, photobioreactors are an attractive choice to perform cultivation of phototrophic organisms, many times in a large scale and an efficient way. Furthermore, photobioreactors are being increasingly used in bioprocesses to obtain valuable chemical products. In this review, we briefly describe different photobioreactor set‐ups, including some of the recent designs, and their characteristics. Additionally, we discuss the current challenges and advantages that each different type of photobioreactor presents, their applicability in biocatalysis and some modern modeling tools that can be applied to further enhance a certain process.},
	number = {12},
	urldate = {2025-10-01},
	journal = {Engineering in Life Sciences},
	author = {Chanquia, Santiago N. and Vernet, Guillem and Kara, Selin},
	month = oct,
	year = {2021},
	keywords = {notion},
	pages = {712--724},
}

